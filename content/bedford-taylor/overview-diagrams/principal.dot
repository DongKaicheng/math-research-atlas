digraph "overview-principal" {
graph [id="svg-overview-principal",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.3",nodesep="0.15",ranksep="0.65",splines=polyline,compound=true,pack=true,packmode="array_u3",ratio=compress,size="22,120"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-core-regularization" [id="overview-principal-n-core-regularization",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Regularization on one fixed<BR ALIGN="LEFT"/>neighborhood</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B01 · R01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-regularization",tooltip="Bounded classical potentials admit decreasing continuous semipositive rational PL approximants over the original field. Finite families share one ordinary neighborhood. Continuous members admit smooth positive uniform approximants; smooth majorants used in the collar argument need not form a decreasing row."];
"n-core-coefficient-control" [id="overview-principal-n-core-coefficient-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite control of original test<BR ALIGN="LEFT"/>coefficients</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-coefficient-control",tooltip="A positive current has Radon coefficient measures. On each compact original test presentation, one positive trace controls all coefficient variations and bounded Borel multiplication. Positivity and the estimate survive actual moment refinements, including rank drops."];
"n-core-ordered-products" [id="overview-principal-n-core-ordered-products",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ordered bounded products exist</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-ordered-products",tooltip="The recursion T(S,k) = D(u_1 T(S,k-1)) gives positive, separately closed coefficient-Radon currents. At this stage the order of the differentiated slots is retained; permutation symmetry and joint decreasing continuity are proved later."];
"n-core-collar-estimates" [id="overview-principal-n-core-collar-estimates",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Common collars and two trace<BR ALIGN="LEFT"/>bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-collar-estimates",tooltip="On smaller norm boxes, all relevant potentials can be patched to the same smooth psh collar. Green exchange with a smooth argument gives a lower trace bound; continuous majorants give a separate upper bound for decreasing weights. The limits are arranged with a fixed coefficient measure at each discontinuous multiplication."];
"n-core-weighted-continuity" [id="overview-principal-n-core-weighted-continuity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Weighted joint decreasing<BR ALIGN="LEFT"/>continuity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-weighted-continuity",tooltip="For a fixed allowed background and locally bounded decreasing classical potentials, the mixed products converge with an additional undifferentiated classical psh weight. Convergence holds on every original compact smooth complementary test, not merely on a selected trace family."];
"n-core-bounded-calculus" [id="overview-principal-n-core-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric bounded calculus and CLN<BR ALIGN="LEFT"/>bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02 · B02 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-bounded-calculus",tooltip="Ordered products become symmetric in their potential slots, while retaining positivity, separate closedness, ordinary locality and weighted decreasing continuity. Relative CLN bounds control compact coefficient mass. This node does not yet assert that changing a potential while preserving its curvature leaves every background product unchanged."];
"n-core-capacity-estimate" [id="overview-principal-n-core-capacity-estimate",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Quantitative relative capacity<BR ALIGN="LEFT"/>estimate</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-capacity-estimate",tooltip="For a bounded decreasing row with one fixed smooth collar, the capacity of {u_j-u > delta} is bounded by C/delta times a fixed-measure error to the power 2^(-k). Thus the row converges in relative capacity on that norm-box domain."];
"n-core-quasicontinuity" [id="overview-principal-n-core-quasicontinuity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Local capacity convergence and<BR ALIGN="LEFT"/>quasicontinuity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-quasicontinuity",tooltip="Bounded decreasing classical potentials converge in relative capacity on a smaller norm-box core. Every bounded classical potential is continuous outside an ordinary open set of arbitrarily small relative capacity. In top degree the capacity needs no auxiliary trace form."];
"n-core-difference-criterion" [id="overview-principal-n-core-difference-criterion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Separate bounded-difference<BR ALIGN="LEFT"/>criterion</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M03 · M04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-difference-criterion",tooltip="For an actual function h locally expressible as a difference of bounded classical psh functions, D[h] is positive if and only if h itself is classical psh. This is a separately adopted analytic input, with curve order transfer and recovery of the actual upper-semicontinuous representative."];
"n-core-curvature-invariance" [id="overview-principal-n-core-curvature-invariance",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Actual curvature kernel and<BR ALIGN="LEFT"/>background order</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M03 · M04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-curvature-invariance",tooltip="The kernel on bounded classical differences consists of actual continuous functions whose two signs are classical psh. Curvature order D[u] >= D[v] transfers to D(uS) >= D(vS); equality therefore permits replacement of any potential slot by another with the same curvature."];
"n-core-maximum-locality" [id="overview-principal-n-core-maximum-locality",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Locality on strict maximum regions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · C03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-maximum-locality",tooltip="The mixed current of max(u,v) agrees with that of u on the Borel region {u > v}, and analogously on {v > u}. These regions need not be ordinary open, so ordinary restriction locality alone does not give this statement."];
"n-core-compact-gap-comparison" [id="overview-principal-n-core-compact-gap-comparison",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Comparison under a compact<BR ALIGN="LEFT"/>boundary gap</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-compact-gap-comparison",tooltip="If the ordinary closure of every strict gap {u < v-epsilon} is compactly contained in V, then the top relative measure of v on {u < v} is at most that of u there. The proof uses maximum locality and the bounded calculus; it requires no capacity theorem or strictly psh exhaustion."];
"n-core-borel-inner-regularity" [id="overview-principal-n-core-borel-inner-regularity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Outer capacity on arbitrary Borel<BR ALIGN="LEFT"/>sets</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · C05 · N01 · N02 · N03 · O03</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-core-borel-inner-regularity",tooltip="For every strict Laurent box and allowed extending background, is the relative outer capacity of each Borel set the supremum of its values on compact subsets? The question includes passage from relatively compact sets to an exhaustion. Counterexamples to raw/outer equality, strong subadditivity and extremal total-mass calibration do not refute this Borel inner-regularity question."];
"r-core-r1-ordered-construction" [id="overview-principal-r-core-r1-ordered-construction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r1-ordered-construction",tooltip="Use the continuous arbitrary-background positivity theorem of R, transported to the local analytic setting as in B. The background is fixed and allowed; the potentials and their limits are locally bounded classical psh, with k <= q. For continuous p_j decreasing to u, the continuous theorem makes D(p_j R) positive. Bounded convergence against the fixed coefficient measures gives p_j R -> uR; differentiation and closedness of the positive cone give D(uR). Iteration uses the resulting positive closed current as the next background. This is the construction stage, before permutation symmetry."];
"r-core-r2-collar-and-traces" [id="overview-principal-r-core-r2-collar-and-traces",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r2-collar-and-traces",tooltip="Shrink to nested polynomial norm boxes around a compact original test and retain every coordinate used by that test. All finitely many potential families have one local bound and one projective extension collar; use the smooth regularized maximum with its exact inactive branch. The lower trace estimate compares coordinatewise ordered potentials. The upper estimate assumes locally bounded decreasing weights and positive currents already convergent on all original tests. Patch the potentials to one smooth psh function near the derivative support of a cutoff. Green exchange moves a smooth majorant into a differentiated slot. Successive fixed-background limits give trace monotonicity; continuous majorants and coefficient control give the complementary upper bound for decreasing weights."];
"r-core-r3-weighted-induction" [id="overview-principal-r-core-r3-weighted-induction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r3-weighted-induction",tooltip="All k differentiated rows and the undifferentiated weight decrease to locally bounded classical psh limits on a common neighborhood. The background stays fixed and 0 <= k <= q; the test is any original compact smooth complementary form. Induct on k. Weighted convergence in degree k-1 gives unweighted convergence in degree k after differentiation. The two collar trace bounds identify the weighted degree-k limit. Positive tests of the form C times a trace plus or minus the given test then recover convergence on every original test."];
"r-core-r4-full-bounded-calculus" [id="overview-principal-r-core-r4-full-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r4-full-bounded-calculus",tooltip="Use symmetry of the continuous arbitrary-background products, obtained by smooth uniform approximation. For CLN bounds, work between nested compact cutoff neighborhoods and bound each potential there; k <= q. Continuous regularizations satisfy permutation symmetry; joint decreasing continuity passes that identity to bounded potentials. The coefficient CLN bound is obtained separately from the ordered recursion: integrate by parts through nested cutoffs, gaining one potential sup norm per slot. No curvature-quotient assertion is used in either argument."];
"r-core-r5-capacity-energy-estimate" [id="overview-principal-r-core-r5-capacity-energy-estimate",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 05</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r5-capacity-energy-estimate",tooltip="Omega is the interior of one polynomial norm box; a compact L lies in a strictly smaller nested box. The row u_j decreases to u, is uniformly bounded near L, and u_j = u = one smooth psh h on Omega minus L. Fix the allowed background, a smooth trace form beta when k < q, and 1 <= k <= q. The bounded calculus first yields relative energy measures, Green's identity and Cauchy–Schwarz. For g_j = u_j-u and normalized testers v, these give I_r squared <= A_r I_(r-1), with A_r uniformly bounded by relative CLN. Iterate to exponent 2^(-k), use the level-set bound, and let I_0 tend to zero against the single fixed measure (Du)^k S beta^(q-k)."];
"r-core-r6-capacity-quasicontinuity" [id="overview-principal-r-core-r6-capacity-quasicontinuity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 06</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r6-capacity-quasicontinuity",tooltip="The decreasing family is defined on a neighborhood of the closure of a sufficiently small norm box Omega; V_0 is a smaller relatively compact core. Keep the admissibility domain and relative capacity fixed, and use its countable subadditivity. Patch the entire family to the common collar and apply the quantitative estimate on the core. For a continuous decreasing regularization, choose a subsequence whose exceptional capacities are summable. The union of its ordinary open error sets has arbitrarily small capacity; outside that union the subsequence converges uniformly, so its limit is continuous."];
"r-core-r7-curvature-order" [id="overview-principal-r-core-r7-curvature-order",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 07</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r7-curvature-order",tooltip="Use actual bounded classical differences, rather than representatives modulo an almost-everywhere relation. For background order, u and v are bounded classical potentials and p < n; a mixed replacement uses a positive closed mixed tail with total degree at most n. Positive D[u-v] makes the actual difference u-v classical psh by the separate criterion; first-order positivity then gives D((u-v)S) >= 0. Equality follows in both orders, and symmetry moves any chosen slot to the front. For the kernel, apply the criterion to both signs: both are upper semicontinuous, hence the actual function is continuous; pointedness gives the converse."];
"r-core-r10-strict-maximum-locality" [id="overview-principal-r-core-r10-strict-maximum-locality",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 08</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r10-strict-maximum-locality",tooltip="The background is fixed, u, v and the remaining slots lie in C_b, and 1 <= k <= q. Borel restrictions are coefficient-measure restrictions; no closedness of a restricted current is asserted. On continuous approximants, ordinary locality gives h_j A_j = h_j B_j for h_j = max(u_j,v_j)-v_j. Pass to the limit by subtracting two applications of weighted decreasing continuity; the differences h_j need not decrease. The resulting identity h(A-B)=0 can be divided by h on {h >= 1/m}; a countable union recovers {u > v}."];
"r-core-r11-compact-gap-comparison" [id="overview-principal-r-core-r11-compact-gap-comparison",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 09</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r11-compact-gap-comparison",tooltip="q >= 1 and u,v belong to C_b(V). For every epsilon > 0, the ordinary closure of {u < v-epsilon} is compact and contained in V. The background is defined and separately closed throughout V; use the top relative measures mu_a = T(S,q)(a,...,a). Put w = max(u,v-epsilon). The mixed telescoping identity writes mu_w-mu_u = D((w-u)Q), with compact support. A cutoff makes its total signed mass zero. Maximum locality identifies the measures on the two strict regions; positivity controls the equality region. Let epsilon decrease to zero. This argument does not pass through quasicontinuity or a capacity theorem."];
"r-core-r14-borel-remainder-open" [id="overview-principal-r-core-r14-borel-remainder-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 10</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r14-borel-remainder-open",tooltip="Fix a strict Laurent box V, q >= 1, and an allowed background S extending to a neighborhood of its closure. Use outer capacity C*_S and the full family of actual normalized classical testers defined on this same V. One proposed sufficient local route remains to be proved: for a relatively compact Borel E and each epsilon > 0, find a compact H contained in E and an ordinary open G containing E minus H whose mass is below epsilon uniformly for every actual normalized tester measure. Separately justify passage to an exhaustion of V while preserving the full tester family and the uniform estimates; a countable dominating-measure reduction or replacement by completed sources needs its own theorem. The established convergence and quasicontinuity results provide the local capacity calculus, but do not supply uniform Borel remainders across the entire tester family. The finite-Hausdorff saturated model proves such a remainder estimate in a restricted range and suggests this route. Its extension and the exhaustion step remain open. Failure of raw/outer equality or strong subadditivity blocks shortcuts, not CAP-BOREL itself."];
"n-d-transgression" [id="overview-principal-n-d-transgression",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Quadratic transgression and first<BR ALIGN="LEFT"/>derivatives</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-d-transgression",tooltip="For a finite admissible quadratic presentation P, the full degree-one action obeys A_S(P) = D M_S(α_P) = −D M_S(Z_P). The singular term A₀ = ½Dδ(Σcνhνkν) is retained. Full first derivatives commute with M_S, including polyhedral boundary contributions."];
"n-d-full-exact" [id="overview-principal-n-d-full-exact",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>An actual full-exact certificate</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01 · G06 · O02</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-d-full-exact",tooltip="On one ordinary representative chosen for P, α_P = d′β + d″ζ in the actual delta-form sheaf. This is a hypothesis available in proved special cases; its existence for every quadratic actual zero remains open. It does not require a continuous smooth-form double primitive."];
"n-d-fixed-control" [id="overview-principal-n-d-fixed-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Exact approximants with one<BR ALIGN="LEFT"/>control</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G06 · O02</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-d-fixed-control",tooltip="Actual symmetric full-exact forms a_j approximate α_P in the represented order interval −ε_jQ ≤ [α_P]−[a_j] ≤ ε_jQ, with ε_j → 0 and one fixed positive represented Q. The all-background degree-one estimate is part of this certificate. The same ordinary domain, Q and approximants precede later backgrounds, tests and refinements."];
"n-d-carrier" [id="overview-principal-n-d-carrier",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A zero full-carrier seminorm</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G05 · O02</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-d-carrier",tooltip="For the specified closed carrier F, the unchanged carrier-CLN seminorm of P vanishes at every required enlarged compact stage. Only the permitted harmonic, pointwise-zero-product and ambient-cycle generators are used. Whether every actual PL-zero has the required absolute-cap certificates is open; zero action does not imply this stronger certificate."];
"n-d-vanishing" [id="overview-principal-n-d-vanishing",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>The specified quadratic action<BR ALIGN="LEFT"/>vanishes</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01 · G05 · G06</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-d-vanishing",tooltip="The action A_S(P) is zero on all original compact smooth complementary tests under any one incoming sufficient route and that route’s displayed hypotheses. Exactness and fixed-control approximation allow every legal S. The direct carrier theorem allows the S carried by its specified F. This node does not assert that every actual relation already has such a certificate."];
"n-d-weak-class" [id="overview-principal-n-d-weak-class",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Descent over weakly approximable<BR ALIGN="LEFT"/>backgrounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-d-weak-class",tooltip="For S in W_loc, actual delta-form action is presentation independent, local and compatible with full first derivatives. W_loc uses weak convergence on all original smooth tests on one fixed ordinary domain, allowing nets. Fixed continuous curvature slots preserve the required weak convergence; bounded BT tails remain in the class."];
"n-d-background-density" [id="overview-principal-n-d-background-density",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Every allowed background lies in<BR ALIGN="LEFT"/>W_loc</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G02 · O01</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-background-density",tooltip="The proposed density theorem would put each arbitrary symmetric middle-positive, separately closed original background in the same-domain weak closure of actual positive closed delta-form backgrounds. Existing potential, cap and geometric examples do not establish this assertion for an arbitrary current."];
"n-d-general-descent" [id="overview-principal-n-d-general-descent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>General actual-relation descent</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O01 · O02</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-general-descent",tooltip="For every admissible finite actual curvature relation of every degree b, choose an ordinary representative for the relation before S and tests, and prove A_S(P) = 0 for all legal backgrounds and all actual refinements. The general quadratic case remains open; low-rank and supplied-model conclusions retain their hypotheses."];
"n-d-differential-interfaces" [id="overview-principal-n-d-differential-interfaces",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Higher and coefficient interfaces</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O06</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-differential-interfaces",tooltip="A general differential calculus still needs presentation independence for variable finite PS coefficients and higher coupled tails, the differential identities, the intended delta-test extension, and gluing and naturality in the stated mapping class. One common BT tail can be absorbed into S; different termwise tails cannot be absorbed by that argument."];
"n-d-model-input" [id="overview-principal-n-d-model-input",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A supplied normal-three actual<BR ALIGN="LEFT"/>zero</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G09 · G10 · G11</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-d-model-input",tooltip="A supplied smooth integral normal-three model germ (Y,y) over the original field, with unchanged value group and residue transcendence degree three, carries the fixed finite closed-cell PL/PS quadratic actual zero. The supplied data include original-field lifting, complete-source comparison on a smooth projective SNC model, all labelled Gauss families and lower strata, and ordinary convergence uniform in the angular parameter."];
"n-d-punctured" [id="overview-principal-n-d-punctured",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Action vanishes off the center</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G07 · G09 · G10 · G11</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-d-punctured",tooltip="In that supplied model, an ordinary U chosen for P before S and tests satisfies A_S(P)|_(U minus {y}) = 0. The proof covers actual ordinary points through top-cone neighborhoods, marked-curve tubes, completed surface core fibers and the rank-two complement. It uses current locality, not a single global primitive on the puncture."];
"n-d-point-residual" [id="overview-principal-n-d-point-residual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Only a top-degree Dirac remains</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G11</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-d-point-residual",tooltip="The finite signed BT action is coefficient-Radon and separately closed. In the supplied threefold, punctured vanishing therefore gives zero everywhere for p = 0, and A_S(P) = c_S(P) δ_y for p = 1. The scalar is independent of the compact cutoff equal to one near y."];
"n-d-protected-tangent" [id="overview-principal-n-d-protected-tangent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Protected tangents retain the wall<BR ALIGN="LEFT"/>terms</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G12 · G13</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-d-protected-tangent",tooltip="For the same degree-one S and a protected actual presentation, the full-fiber transpose T has critical trace mass O(r²) and positive closed conic tangent limits T₀. The paired leading PL energy Z₀ satisfies an all-face O(r) error estimate. Compatible-PS continuity retains wall mass when passing its pairing to a tangent; ordinary smooth weak convergence alone would not suffice."];
"n-d-spherical-residual" [id="overview-principal-n-d-spherical-residual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>An exact spherical residual<BR ALIGN="LEFT"/>formula</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G12 · G13 · G14</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-d-spherical-residual",tooltip="For every critical tangent jointly realized by this P and S, c_S(P) equals Σcν(∫hν^[1]kν^[1] dσ − ∫d_S hν^[1] ⊗ d_S kν^[1] : dM). The finite positive semidefinite angular matrix measure satisfies Mθ = 0, div_S M = 0 and σ = tr M. The value is tangent independent. Classification of real cones does not show that an arbitrary real cone is analytically realized."];
"n-d-critical-cancellation" [id="overview-principal-n-d-critical-cancellation",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>The realized spherical pairing<BR ALIGN="LEFT"/>vanishes</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G14 · O07</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-critical-cancellation",tooltip="The missing assertion is cancellation for every actual jointly realized pair (Z₀,M) in this supplied-model category. It is known for zero tangent density, globally linear first jets, and a leading tensor with an actual full-exact identity near the whole protected central fiber; the established potential and W_loc subclasses are also covered. No argument yet covers all allowed S and all actual zero relations."];
"n-d-model-descent" [id="overview-principal-n-d-model-descent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Full quadratic descent in this<BR ALIGN="LEFT"/>model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G11 · O07</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-model-descent",tooltip="If the open cancellation assertion is proved throughout the supplied normal-three class, its quadratic actual zeros have zero action on U in both legal degrees p = 0 and p = 1. This is a specific conditional target. It neither returns the model to every original germ nor settles higher coupled or variable-coefficient relations."];
"n-d-shortcut-limits" [id="overview-principal-n-d-shortcut-limits",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Why shortcut arguments stop</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G03 · G04 · N07 · N08 · N09 · N10 · N11</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="#logic-node-d-shortcut-limits",tooltip="Normal-current constructions retain a harmonic boundary defect; scalar harmonic identifications do not supply a missing continuous potential. N07 excludes an automatic continuous smooth-form double primitive. N08 gives a real Killing-gluing obstruction, N09 retains graph Hessian-wall drift, N10 obstructs stronger residue-section and whole-central-fiber Hensel lifts, and N11 shows that O(r²) growth can retain a point residual. These examples do not refute the actual analytic-zero conjecture."];
"r-d-e-exact" [id="overview-principal-r-d-e-exact",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 23</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-exact",tooltip="P is the specified admissible finite quadratic actual zero on the same ordinary representative as its full-exact identity. S is any allowed original background of degree 0 ≤ p ≤ n−2; retain all original compact smooth tests and actual refinements. Full derivative compatibility gives M_S(α_P) = d′(β ∧ S) + d″(ζ ∧ S). Applying D kills both terms by nilpotence and anticommutation. No higher-degree arbitrary-current product is assumed."];
"r-d-e-control" [id="overview-principal-r-d-e-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 24</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-control",tooltip="P is the specified admissible finite quadratic actual zero, with exact a_j, ε_j → 0 and a single positive represented Q on one fixed ordinary neighborhood. The represented order estimate transfers to the all-background degree-one action for every allowed 0 ≤ p ≤ n−2; Q and the neighborhood do not vary with the test or later refinement. Each exact a_j has zero differentiated action. The fixed positive control bounds every remaining compact pairing by ε_j times a finite fixed mass; distributional continuity of D then gives zero. Approximating only Z_P retains the complete singular A₀ term."];
"r-d-e-carrier" [id="overview-principal-r-d-e-carrier",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 25</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-carrier",tooltip="Here P is a finite quadratic PL curvature polynomial and S is an allowed background carried by the specified unchanged closed F, in a legal degree. Zero seminorm holds at every enlarged compact stage required for the test, using finite decompositions on the same ordinary domain and only the permitted generator space. An absolute-cap certificate directly kills its relative capped background. Returning from all such caps to an uncapped S uses the separate KC9 detector: q = n−(p+b) > 0 and 1 ≤ c ≤ max(q mod 2, q−2 floor(p/2)). That proposition gives no positive-rank cap route when q = 0 or this upper bound is zero. Permitted carrier relations act by zero. Apply the uniform carrier-only CLN estimate to each remainder and take the seminorm infimum. This proves a sufficient annihilation criterion; it does not identify the actual analytic kernel or all seminorm polars."];
"r-d-e-density-route" [id="overview-principal-r-d-e-density-route",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 26</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-density-route",tooltip="Assume the open density statement for every allowed background in every legal degree on fixed ordinary representatives, with convergence against all original compact smooth tests. Keep the admissible finite continuous PL/PS scalar presentation fixed while the positive separately closed backgrounds vary; apply the established fixed-slot and compatible-PS continuity. For actual delta-form backgrounds the zero relation has zero product. On a fixed local domain, pass each term of the finite expression through the established weak-continuity theorem. This kills actual zero presentations for S; subtracting presentations and ordinary locality give descent. This route does not require an exactness certificate for each relation."];
"r-d-e-puncture" [id="overview-principal-r-d-e-puncture",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 27</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-puncture",tooltip="Retain every supplied original-field model/source comparison, labelled cone, calibration and completed core fiber in the model hypothesis. P is the fixed admissible quadratic actual zero; S is any allowed original background with p = 0 or p = 1 on the supplied threefold. Choose the ordinary U for P before S and compact tests; the cover is a cover of actual ordinary points. Top interiors have ambient strain neighborhoods, positive two-faces use completed marked-curve data, and rays use ordinary neighborhoods of completed surface core fibers. Outside the fixed old source, the original scalar tuple has rank at most two. A finite partition of each compact test and ordinary current locality assemble the punctured equality."];
"r-d-e-dirac" [id="overview-principal-r-d-e-dirac",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 28</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-dirac",tooltip="The current is the finite signed bounded BT action of the specified continuous PL/PS quadratic presentation, so it is coefficient-Radon and separately d′- and d″-closed. The ambient analytic dimension is three and p is 0 or 1. Punctured vanishing puts the support at y. A separately closed order-zero point current vanishes below top bidegree; in top degree it is a scalar Dirac measure. Thus p = 0 is complete, while p = 1 has precisely c_S(P)δ_y left."];
"r-d-e-protected" [id="overview-principal-r-d-e-protected",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 29</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-protected",tooltip="Use the same actual quadratic presentation and an allowed degree-one background S. Supply a finite protected actual moment map t containing every scalar, with t(y) = 0 and the whole inverse image of every compact target support compact in U. Retain the complete finite closed-cell scalar jets and their tangential values on every face. Transposing original tests through the protected whole fiber gives a positive separately closed real current. The critical monotonicity estimate supplies conic tangent subsequences; the paired first-jet estimate gives O(r) coefficient error, and the compatible-PS approximation controls the wall terms for the tangent pairing."];
"r-d-e-sphere" [id="overview-principal-r-d-e-sphere",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 30</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-sphere",tooltip="The residual, transpose, leading tensor and tangent come from the same P, S and protected actual presentation; take p = 1. Use the full paired tensor Z₀ and canonical tangential face values, with the complete protected inverse image retained in every shrinking cutoff. A cutoff Hessian has size O(δ⁻²), while trace mass is O(δ²) and the leading-energy error is O(δ), so the replacement error tends to zero. Compatible-PS continuity passes the remaining pairing to T₀. Radial and tangential decomposition then gives the spherical formula and D(Z₀ ∧ T₀) = −c_S(P)δ₀."];
"r-d-e-model-close" [id="overview-principal-r-d-e-model-close",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 31</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-model-close",tooltip="Assume the still-open cancellation statement for every admissible quadratic actual zero and every degree-one S in this supplied-model category, with their common protected presentations. Retain the already proved p = 0 case and punctured vanishing from the point-residual theorem. The formula identifies the only remaining coefficient c_S(P) with the hypothesized zero pairing. This removes the central Dirac in degree p = 1; the degree p = 0 action already vanishes. The implication is proved, but its universal cancellation premise remains open."];
"r-d-e-critical-obstructions" [id="overview-principal-r-d-e-critical-obstructions",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#9a4b30"><B>Blocks this shortcut 32</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fffef9",URL="#logic-descent-d-e-critical-obstructions",tooltip="The shortcut under examination uses local strain primitives, graph pullback or critical O(r²) mass alone, without additional actual-zero realization data. The real Killing example is not separately closed; the critical-mass example is not an actual analytic-zero presentation. Their counterexamples have precisely these restricted targets. Local primitives can fail to glue, pulling a primitive through a PL graph retains a Hessian-wall measure, and O(r²) mass can survive a second-order cutoff. In the analytic cancellation problem the available ε⁻¹ times O(ε) wall bound is only O(1). These results block those shortcuts, while leaving cancellation for jointly realized actual zero pairs open."];
"r-d-e-model-to-general" [id="overview-principal-r-d-e-model-to-general",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 33</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-descent-d-e-model-to-general",tooltip="A new return theorem must cover arbitrary original ordinary germs, including higher joint residue rank and model data not supplied in advance. Higher degrees need treatment of coupled relations with different termwise tails; a common-tail absorption argument only treats its stated subclass. Preserve the original field, all original tests and actual refinements, and choose the ordinary relation neighborhood before S and tests. Even complete cancellation would settle the quadratic supplied normal-three case. These missing general-germ and higher-degree bridges are additional research tasks; no implication from that model theorem alone to REL-ALL is claimed."];
"r-d-e-interface-step" [id="overview-principal-r-d-e-interface-step",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 34</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-descent-d-e-interface-step",tooltip="Even after pure scalar relation descent, specify and prove the variable-coefficient quotient and the differential identities in their object sheaves. Establish the intended enlarged delta-test action, ordinary gluing and naturality for an explicit mapping class; equality on smooth tests alone does not define that extension. Scalar descent would make its curvature expressions presentation independent. Variable PS coefficients, differential operations and enlarged tests ask for separate compatibility statements, so neither low-rank descent nor central cancellation supplies this interface automatically."];
"or-d-vanishing" [id="overview-principal-or-d-vanishing",label="OR
Any one sufficient route",fontsize=12,shape=ellipse,fillcolor="#eef4ec",color="#315e50",tooltip="Each incoming deduction has its own full joint premises and hypotheses."];
"n-energy-tail-calculus" [id="overview-principal-n-energy-tail-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Capacity tails and truncation<BR ALIGN="LEFT"/>calculus</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · U01 · U02 · U03 · U04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-tail-calculus",tooltip="In the stated zero-boundary class, no loss is equivalent to t^q C_S({u<−t})→0, and finite σ-energy is equivalent to the weighted capacity integral J_σ(u)<∞. Bounded capacity completion and graded truncation bounds then control curvature, first-order and energy coefficients. Local finiteness is required for the nonpolar product; restricted truncation stages need not be closed."];
"n-energy-global-green" [id="overview-principal-n-energy-global-green",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Bounded global Green exchange</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-global-green",tooltip="For bounded negative classical potentials with compact negative sublevels and finite total curvature masses, Green exchange identifies the two weighted curvature integrals with the integrated cross-energy. This supplies the exchange of the undifferentiated slot needed for global mixed energy."];
"n-energy-mixed-energy" [id="overview-principal-n-energy-mixed-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric mixed energy and Hölder</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-mixed-energy",tooltip="For actual first-energy potentials, B(u₀,…,u_q) is finite and symmetric in every slot. Positive energy matrices give Cauchy–Schwarz, the mixed Hölder inequality has constant one, and the energy root satisfies Minkowski. The associated tester and sharp midpoint estimates control strong discrepancy."];
"n-energy-completion" [id="overview-principal-n-energy-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Complete relative first-energy<BR ALIGN="LEFT"/>space</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E02 · E03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-completion",tooltip="Strongly Cauchy rows have uniform deep tails and global weighted tightness. Their relative Borel limits carry intrinsic currents and critical weighted limits. The completed cone C is complete, with strong convergence exactly equivalent to local truncated outer-capacity convergence together with energy convergence. A common lower barrier is not required for a Cauchy row."];
"n-energy-dual" [id="overview-principal-n-energy-dual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Banach differences and closed<BR ALIGN="LEFT"/>sources</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-dual",tooltip="The actual Borel difference space D_S=C−C is Banach. The curvature functional J(u)(h)=B(h,u,…,u) is injective; its image is norm closed, and the dual distance between sources gives a complete metric inducing the strong topology on C. Closed image does not assert surjectivity onto the dual."];
"n-energy-strong-datum" [id="overview-principal-n-energy-strong-datum",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Literal, strongly continuous datum</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q04 · O04</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-energy-strong-datum",tooltip="The positive Radon measure μ defines ℓ_μ(h)=−∫h dμ literally on every Borel difference in D_S: absolute integrability, independence of relative-null representatives, norm boundedness and strong continuity on C are all required. Fixed completed-source domination is one proved sufficient condition. Norm boundedness alone is the open ED-STRONG question."];
"n-energy-projection" [id="overview-principal-n-energy-projection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Projection and a normal residual</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-projection",tooltip="For a strongly continuous dual datum, maximizing ℓ(v)−e(v)/(q+1) on C gives a unique u=Π(ℓ). Its decomposition ℓ=J(u)+n satisfies n(v)≤0 on C and n(u)=0. The source equation still requires the residual to vanish in the appropriate literal sense."];
"n-energy-probe" [id="overview-principal-n-energy-probe",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>One probe with both test<BR ALIGN="LEFT"/>directions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-probe",tooltip="The strict Laurent geometry supplies a single bounded continuous negative classical ψ₀. For every original compact smooth scalar φ, both ψ₀+ε_φφ and ψ₀−ε_φφ lie in the actual first-energy cone for some ε_φ>0. The same probe works for every extending allowed background."];
"n-energy-defect-zero" [id="overview-principal-n-energy-defect-zero",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Additional compatibility: Ξ=0</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03 · O05</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-energy-defect-zero",tooltip="For the normal pair of a literal strongly continuous positive datum, Ξ=J(Πℓ_μ)(ψ₀)−ℓ_μ(ψ₀)=−n(ψ₀) is nonnegative. Requiring Ξ=0 is the extra compatibility condition. Strong continuity and fixed-source domination do not force this equality."];
"n-energy-source-solution" [id="overview-principal-n-energy-source-solution",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Unique source solution in the<BR ALIGN="LEFT"/>completed cone</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-source-solution",tooltip="Under the literal strong-dual hypotheses, Ξ=0 if and only if μ̂_{Πℓ_μ}=μ, if and only if some v∈C has source μ. Any solution equals Πℓ_μ. More generally, every compact original test error is bounded by ε_φ⁻¹Ξ. This is an exact compatibility criterion, not an assertion that arbitrary data are compatible."];
"n-energy-source-gap" [id="overview-principal-n-energy-source-gap",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Smooth dominated data can have Ξ&gt;0</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N06</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="#logic-node-energy-source-gap",tooltip="In a fixed two-dimensional torus model with q=1, smooth positive densities f_j→1 uniformly can make f_jμ_w leave the entire strong-completion source image, even at a fixed reference admitting every two-sided compact test direction. These data remain literal, strongly continuous and uniformly source dominated. Their zero-boundary Poisson traces fail convexity."];
"n-energy-compatible-classes" [id="overview-principal-n-energy-compatible-classes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Find source conditions from the<BR ALIGN="LEFT"/>data</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O05</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-energy-compatible-classes",tooltip="Find substantial geometric classes of given μ for which strong continuity and Ξ=0 follow from checkable input conditions. A local inverse route needs a specified linearized range, a right inverse with boundary and moment estimates, and preservation of that range by the nonlinear remainder. Assuming an unknown solution would restate the goal."];
"n-energy-green-products" [id="overview-principal-n-energy-green-products",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite-energy Green products</B></FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-energy-green-products",tooltip="Define integrable truncation products for Green currents Dg_Z+δ_Z=ω_Z, with presentation independence, symmetry and comparison to existing smooth, formal and delta-form products. Products involving cycle currents require proper-intersection or replacement hypotheses and their own integrability argument."];
"n-energy-scalar-chain" [id="overview-principal-n-energy-scalar-chain",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Bounded scalar chain calculus</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">U05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-scalar-chain",tooltip="For a bounded difference f=a−b of actual classical psh functions and a positive separately closed tail current Q, Γ_Q(f) is a positive coefficient-Radon current and smooth scalar compositions satisfy the full original current chain rule. All multipliers are the actual Borel functions."];
"r-energy-r1-mixed-energy" [id="overview-principal-r-energy-r1-mixed-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 14</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r1-mixed-energy",tooltip="Fix the original field and tests, the strict Laurent domain, and one allowed S extending to a neighborhood of its closure; q=n−p≥1. Every input u_i is an actual negative classical first-energy potential with compact negative sublevels, canonical no loss and finite first energy. Use the Laurent barrier approximants max(u_i,jρ), their finite mixed masses, and the critical weighted convergence supplied by the truncation theorem. The proof applies bounded Green exchange after fixing the other curvature slots, then passes the barrier approximants to obtain full mixed symmetry. The positive energy matrix gives Cauchy–Schwarz and Hölder constant one. Repeated slot exchange gives the tester estimate; the segment second-variation formula gives the midpoint bound. These are joint proof inputs, not a claim that a tail bound alone yields global symmetry."];
"r-energy-r2-completion" [id="overview-principal-r-energy-r2-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 15</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r2-completion",tooltip="Retain the same strict Laurent domain and extending background, and actual first-energy approximating rows. For constructing an unbounded limit, each defining row must be strongly Cauchy: sup_{j,l≥N} I(u_j,u_l)→0. Use bounded capacity completion at every fixed clipping level and the uniform tester/discrepancy estimates; legal weighted currents satisfy a+b≤q+1. Strong Cauchy control, tested against a late fixed row member, gives uniform deep tails and global weighted tightness. Fixed-level capacity limits and vanishing tails define the unbounded coefficients before differentiation. Uniform discrepancy continuity then gives completeness. Energy boundedness plus capacity convergence alone does not supply the critical tail step."];
"r-energy-r3-banach-sources" [id="overview-principal-r-energy-r3-banach-sources",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 16</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r3-banach-sources",tooltip="Form actual Borel differences of the same completed cone C modulo its relative outer-capacity null ideal. Use the energy-difference norm inf{e(a)^(1/d)+e(b)^(1/d): h=a−b}, completed mixed multilinearity and monotone closure. Use the exact curvature norm and the two quantitative comparisons between I(u,v) and ‖J(u)−J(v)‖*. Summable decomposed increments converge as two monotone cone series, proving Banach completeness in actual Borel differences. A norm-Cauchy sequence of sources has bounded energy roots and is strongly Cauchy; completion produces its limiting potential, and curvature continuity identifies the source limit. This proves closed image, not arbitrary-data solvability."];
"r-energy-r4-fixed-domination" [id="overview-principal-r-energy-r4-fixed-domination",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 17</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r4-fixed-domination",tooltip="Keep one fixed strict Laurent geometry and background S. Supply a completed reference potential v∈C and a finite constant M≥0 with 0≤μ≤M μ̂_v as Radon measures on every Borel set. Mixed Hölder proves literal integrability and the norm bound on every difference. Domination transfers the completed tester estimate to ∫|u_j−u| dμ, proving strong L¹ continuity. The fixed dominated interval is also weak-star compact and norm closed. This route supplies strong continuity but does not supply Ξ=0."];
"r-energy-r5-literal-continuity-open" [id="overview-principal-r-energy-r5-literal-continuity-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 18</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r5-literal-continuity-open",tooltip="Fix S and the strict Laurent geometry, and let μ be positive Radon, annihilate the relative null ideal, and define an absolutely integrable norm-bounded literal functional on all of D_S. No fixed-source domination and no additional finite-total-mass assumption is available. Missing: prove ∫|u_j−u| dμ→0 for every strongly convergent row in C, including a general nonzero limit; a qualified ordered-rooftop or finite-minorant estimate is a proposed route. ED-STRONG asks whether literal norm boundedness already implies the continuity needed for the variational datum. It is a separate unresolved route to the same condition supplied by fixed domination. Nonliteral dual counterexamples and varying-background estimates do not settle this fixed-background literal question."];
"r-energy-r6-projection" [id="overview-principal-r-energy-r6-projection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 19</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r6-projection",tooltip="Work on the same complete cone C with the established sharp midpoint estimate and completed energy continuity. The datum belongs to the norm dual and is strongly continuous on C; literal positive data are the source-equation subclass used here. The dual norm bounds the energies of maximizing rows. The midpoint gap makes those rows strongly Cauchy. Completeness gives a limit, and strong continuity passes the datum term. First variations only along segments in C give the polar normal n; they do not assert arbitrary two-sided variations at the optimizer."];
"r-energy-r7-zero-defect-solves" [id="overview-principal-r-energy-r7-zero-defect-solves",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 20</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r7-zero-defect-solves",tooltip="Use the normal pair u=Π(ℓ_μ), n=ℓ_μ−J(u) for the literal positive Radon datum in the fixed geometry. For every original compact smooth φ, both ψ₀±ε_φφ are admissible, and the two probe integrals defining Ξ are finite. Impose the additional equality Ξ=−n(ψ₀)=0. Testing the normal inequality in both probe directions gives |n(φ)|≤ε_φ⁻¹Ξ. Zero defect therefore kills every original scalar test error; literal integration and Radon uniqueness identify μ̂_u=μ. Variational uniqueness identifies every solution with u. The same theorem proves the converse: existence of a source solution forces Ξ=0, so zero defect and solvability are equivalent under these hypotheses."];
"r-energy-r8-nonzero-defect-obstruction" [id="overview-principal-r-energy-r8-nonzero-defect-obstruction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#9a4b30"><B>Blocks this shortcut 21</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r8-nonzero-defect-obstruction",tooltip="Use the fixed q=1 two-dimensional torus background and a bounded actual admissible reference w<0, with finite total source mass, compact strict negative sublevels, canonical no loss, and all two-sided compact test directions. The counterexample data are μ_j=f_jμ_w, with 1≤f_j≤3/2 and f_j→1 uniformly; they remain literal and strongly continuous. A source in the full completed cone would have a convex zero-boundary moment trace solving the prescribed real Poisson equation. The constructed Poisson solution is not convex, so no such source exists. The exact probe equivalence forces Ξ(μ_j)>0. This blocks the proposed inference from strong continuity, domination or smooth positive density to zero defect."];
"r-energy-r9-compatible-input-open" [id="overview-principal-r-energy-r9-compatible-input-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 22</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r9-compatible-input-open",tooltip="The zero-defect criterion is available after the variational optimizer is constructed. Missing: hypotheses on the given measure, geometry and explicitly supplied reference objects that force both strong continuity and zero defect before assuming a solution. For the proposed local inverse route, additionally establish the linearized range, a bounded right inverse with all boundary and harmonic-moment constraints, and preservation of that range by the nonlinear remainder. The exact compatibility criterion locates the remaining task but does not perform it. Existing finite-mode inverse constructions motivate a range-controlled route; smooth positive perturbations alone cannot be used as its hypothesis because the source-gap counterexample rules them out."];
"n-bridge-degree-one-action" [id="overview-principal-n-bridge-degree-one-action",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Available degree-one action and<BR ALIGN="LEFT"/>full Leibniz rule</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-bridge-degree-one-action",tooltip="Use the established R6 input: every actual delta-form of total bidegree (1,1) acts on every allowed background S of degree p<n, intrinsically on all original tests. Its agreement with PS multiplication and the full PS Leibniz rule give M_S(d′β)=d′(β∧S) and M_S(d″γ)=d″(γ∧S). This is an available input, not an additional open conjecture or a higher-degree arbitrary-current product."];
"r-bridge-capacity-to-energy" [id="overview-principal-r-bridge-capacity-to-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 11</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">4 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-cross-branch-connections-bridge-capacity-to-energy",tooltip="Fix a strict original Laurent domain V and one allowed background S extending to a neighborhood of its closure; the remaining degree is q=n−p≥1. Use the analytic Laurent-collar and affinoid capacity-localization results, the original coefficient controls and countably cofinal compact test stages, with the full classical normalized tester family on the stated domain. The actual negative classical power classes have compact strict negative sublevel closures, canonical no loss and the displayed finite power energy where those conditions are required. Local coefficient finiteness is required when first defining the nonpolar product. For the completed bounded calculus use actual Borel limits in ordinary-open outer capacity. Keep the coefficient budget a+b≤q+σ and distinguish closed locally finite limits from individual restricted truncation stages. The bounded weighted recursion, relative coefficient estimates, quasicontinuity and boundary comparison supply the local multiplier and sublevel estimates. The analytic collar and capacity-localization arguments put them on the required Laurent domain. These inputs support the no-loss criterion, capacity-energy equivalence, graded tail bounds and bounded Borel completion used in the energy branch. The proof uses outer capacity and does not require general relative raw/outer equality on arbitrary Borel sets."];
"r-bridge-bounded-scalar-chain" [id="overview-principal-r-bridge-bounded-scalar-chain",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 12</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-cross-branch-connections-bridge-bounded-scalar-chain",tooltip="Work on one original ordinary domain with a symmetric middle-positive separately closed background Q of degree (p,p), where p<n. Each scalar difference f=a−b has actual locally bounded classical psh summands; use finitely many such presentations on every compact test support. Retain finite polarization, original coefficient-Radon control, and the smooth convex decomposition of scalar functions on an interval containing the local range. All multipliers use the actual Borel values. Simultaneous bounded regularizations and the weighted theorem pass the three-term energy identity to actual differences. Positivity gives coefficient-Radon control, and polarization treats cross terms. A finite difference of convex coordinatewise-increasing compositions passes every weighted term of the smooth chain identities. The resulting scalar calculus is intrinsic and needs no general analytic relation-descent conjecture."];
"r-bridge-bounded-transgression" [id="overview-principal-r-bridge-bounded-transgression",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 13</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-cross-branch-connections-bridge-bounded-transgression",tooltip="Use a finite real quadratic presentation P=Σcν[hν][kν], with constant cν∈R, whose continuous PL/PS scalars are admissible on one ordinary representative over the original field; retain the full actual delta curvatures and closed-cell face data. The quadratic action uses an allowed original S of degree 0≤p≤n−2. The separately established degree-one action and full derivative compatibility are explicit joint inputs; no higher-degree arbitrary-current multiplication is assumed. Retain α_P=A₀−Z_P with the complete singular term A₀=½D_δ(Σcνhνkν), all original compact smooth complementary tests and every actual refinement. When P is an actual zero, its transgression class lies in the actual Aeppli quotient. Bounded products define the finite signed quadratic action, while the degree-one operation identifies the action of each scalar-curvature primitive. Full derivative compatibility and the intrinsic Leibniz identity give A_S(P)=D M_S(α_P)=−D M_S(Z_P). This is the bridge to the quadratic certificate arguments; it does not construct an exact certificate for every actual zero."];
"r-bridge-descent-energy-green" [id="overview-principal-r-bridge-descent-energy-green",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 35</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">4 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-cross-branch-connections-bridge-descent-energy-green",tooltip="Specify Green currents g_Z satisfying Dg_Z+δ_Z=ω_Z, their permitted cycle classes and an actual first-energy truncation class on the intended ordinary domains. General actual-relation descent is itself still open. In a curvature-generated expression it would make the differential presentation intrinsic; it would not define multiplication by a cycle current on its own. Still prove proper-intersection or replacement hypotheses, coefficient integrability, and independence of admissible presentations and truncations, with all relevant degree and boundary conditions. Still establish the required mapping properties, Green symmetry and comparison with existing smooth, formal and delta-form products on their common domains. The two branches have different roles in the proposed construction: relation descent addresses algebraic presentation independence, while capacity tails and mixed energy control limiting integrals. They meet at the Green-product problem, but cycle multiplication, intersection, integrability and comparison remain additional mathematical interfaces. This connection is a research route, not an established implication to finite-energy intersection theory."];
