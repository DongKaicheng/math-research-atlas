digraph "overview-complete" {
graph [id="svg-overview-complete",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.3",nodesep="0.4",ranksep="0.65",splines=polyline,compound=true,pack=true,packmode="array_u3"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
subgraph "cluster-bounded-calculus-and-relative-capacity" {
graph [id="overview-complete-cluster-bounded-calculus-and-relative-capacity",label=<Regularization, curvature currents and<BR ALIGN="LEFT"/>qualified capacity theories>,labelloc=t,labeljust=l,fontsize=19,fontcolor="#31483b",style="rounded",color="#b9c9b5",margin=24];
"n-core-regularization" [id="overview-complete-n-core-regularization",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Regularization on one fixed<BR ALIGN="LEFT"/>neighborhood</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B01 · R01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-regularization",tooltip="Bounded classical potentials admit decreasing continuous semipositive rational PL approximants over the original field. Finite families share one ordinary neighborhood. Continuous members admit smooth positive uniform approximants; smooth majorants used in the collar argument need not form a decreasing row."];
"n-core-coefficient-control" [id="overview-complete-n-core-coefficient-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite control of original test<BR ALIGN="LEFT"/>coefficients</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-coefficient-control",tooltip="A positive current has Radon coefficient measures. On each compact original test presentation, one positive trace controls all coefficient variations and bounded Borel multiplication. Positivity and the estimate survive actual moment refinements, including rank drops."];
"n-core-ordered-products" [id="overview-complete-n-core-ordered-products",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ordered bounded products exist</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-ordered-products",tooltip="The recursion T(S,k) = D(u_1 T(S,k-1)) gives positive, separately closed coefficient-Radon currents. At this stage the order of the differentiated slots is retained; permutation symmetry and joint decreasing continuity are proved later."];
"n-core-collar-estimates" [id="overview-complete-n-core-collar-estimates",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Common collars and two trace<BR ALIGN="LEFT"/>bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-collar-estimates",tooltip="On smaller norm boxes, all relevant potentials can be patched to the same smooth psh collar. Green exchange with a smooth argument gives a lower trace bound; continuous majorants give a separate upper bound for decreasing weights. The limits are arranged with a fixed coefficient measure at each discontinuous multiplication."];
"n-core-weighted-continuity" [id="overview-complete-n-core-weighted-continuity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Weighted joint decreasing<BR ALIGN="LEFT"/>continuity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-weighted-continuity",tooltip="For a fixed allowed background and locally bounded decreasing classical potentials, the mixed products converge with an additional undifferentiated classical psh weight. Convergence holds on every original compact smooth complementary test, not merely on a selected trace family."];
"n-core-bounded-calculus" [id="overview-complete-n-core-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric bounded calculus and CLN<BR ALIGN="LEFT"/>bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02 · B02 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-bounded-calculus",tooltip="Ordered products become symmetric in their potential slots, while retaining positivity, separate closedness, ordinary locality and weighted decreasing continuity. Relative CLN bounds control compact coefficient mass. This node does not yet assert that changing a potential while preserving its curvature leaves every background product unchanged."];
"n-core-capacity-estimate" [id="overview-complete-n-core-capacity-estimate",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Quantitative relative capacity<BR ALIGN="LEFT"/>estimate</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-capacity-estimate",tooltip="For a bounded decreasing row with one fixed smooth collar, the capacity of {u_j-u > delta} is bounded by C/delta times a fixed-measure error to the power 2^(-k). Thus the row converges in relative capacity on that norm-box domain."];
"n-core-quasicontinuity" [id="overview-complete-n-core-quasicontinuity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Local capacity convergence and<BR ALIGN="LEFT"/>quasicontinuity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-quasicontinuity",tooltip="Bounded decreasing classical potentials converge in relative capacity on a smaller norm-box core. Every bounded classical potential is continuous outside an ordinary open set of arbitrarily small relative capacity. In top degree the capacity needs no auxiliary trace form."];
"n-core-difference-criterion" [id="overview-complete-n-core-difference-criterion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Separate bounded-difference<BR ALIGN="LEFT"/>criterion</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M03 · M04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-difference-criterion",tooltip="For an actual function h locally expressible as a difference of bounded classical psh functions, D[h] is positive if and only if h itself is classical psh. This is a separately adopted analytic input, with curve order transfer and recovery of the actual upper-semicontinuous representative."];
"n-core-curvature-invariance" [id="overview-complete-n-core-curvature-invariance",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Actual curvature kernel and<BR ALIGN="LEFT"/>background order</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M03 · M04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-curvature-invariance",tooltip="The kernel on bounded classical differences consists of actual continuous functions whose two signs are classical psh. Curvature order D[u] >= D[v] transfers to D(uS) >= D(vS); equality therefore permits replacement of any potential slot by another with the same curvature."];
"n-core-potential-gluing" [id="overview-complete-n-core-potential-gluing",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Products glue from local curvature<BR ALIGN="LEFT"/>potentials</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-potential-gluing",tooltip="When each curvature current locally has a bounded classical potential, the local mixed products agree on overlaps. They define a unique positive, separately closed, symmetric product of those curvature currents and the chosen background."];
"n-core-continuous-module" [id="overview-complete-n-core-continuous-module",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous degree-one curvature<BR ALIGN="LEFT"/>relations descend</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-continuous-module",tooltip="Finite continuous-coefficient relations between degree-one curvature currents remain relations after inserting a fixed positive closed background. Applying this one slot at a time gives a well-defined positive symmetric mixed operation on the continuous curvature module."];
"n-core-maximum-locality" [id="overview-complete-n-core-maximum-locality",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Locality on strict maximum regions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · C03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-maximum-locality",tooltip="The mixed current of max(u,v) agrees with that of u on the Borel region {u > v}, and analogously on {v > u}. These regions need not be ordinary open, so ordinary restriction locality alone does not give this statement."];
"n-core-compact-gap-comparison" [id="overview-complete-n-core-compact-gap-comparison",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Comparison under a compact<BR ALIGN="LEFT"/>boundary gap</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-compact-gap-comparison",tooltip="If the ordinary closure of every strict gap {u < v-epsilon} is compactly contained in V, then the top relative measure of v on {u < v} is at most that of u there. The proof uses maximum locality and the bounded calculus; it requires no capacity theorem or strictly psh exhaustion."];
"n-core-qe-domination" [id="overview-complete-n-core-qe-domination",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Domination and uniqueness modulo<BR ALIGN="LEFT"/>capacity zero</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-qe-domination",tooltip="With the required compact gaps, zero u-mass on {u < v} forces that set to have zero relative capacity. Equal relative Monge–Ampere measures, with gaps in both orders, force {u != v} to have zero relative capacity. Neither conclusion alone identifies pointwise representatives."];
"n-core-strict-gap-detection" [id="overview-complete-n-core-strict-gap-detection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Additional condition: detect every<BR ALIGN="LEFT"/>strict gap</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-core-strict-gap-detection",tooltip="For the proposed pair (S,V), every nonempty strict gap {a < b-delta} of admissible bounded classical potentials with compact gaps must have positive relative capacity. Establishing useful intrinsic hypotheses remains part of CAP-DETECT. The condition fails for S = 0 and can fail away from a nonzero background's support."];
"n-core-conditional-pointwise" [id="overview-complete-n-core-conditional-pointwise",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Pointwise order and uniqueness,<BR ALIGN="LEFT"/>conditionally</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-core-conditional-pointwise",tooltip="Once strict-gap detection is supplied for (S,V), the preceding capacity-zero conclusions imply u >= v, or u = v in the uniqueness case. The conditional implication is proved; the required detection property is not asserted for arbitrary positive closed backgrounds."];
"n-core-borel-inner-regularity" [id="overview-complete-n-core-borel-inner-regularity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Outer capacity on arbitrary Borel<BR ALIGN="LEFT"/>sets</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · C05 · N01 · N02 · N03 · O03</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-core-borel-inner-regularity",tooltip="For every strict Laurent box and allowed extending background, is the relative outer capacity of each Borel set the supremum of its values on compact subsets? The question includes passage from relatively compact sets to an exhaustion. Counterexamples to raw/outer equality, strong subadditivity and extremal total-mass calibration do not refute this Borel inner-regularity question."];
"n-core-approachable-calculus" [id="overview-complete-n-core-approachable-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous calculus for<BR ALIGN="LEFT"/>approachable potentials</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-approachable-calculus",tooltip="For continuous potentials already locally approximable uniformly by smooth positive potentials, insertion into a positive separately closed background preserves positivity and closedness. It is jointly continuous for locally uniform potentials and weakly converging positive closed backgrounds; successive insertions are symmetric."];
"n-core-projective-curves" [id="overview-complete-n-core-projective-curves",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>One normalized<BR ALIGN="LEFT"/>complete-intersection curve at a<BR ALIGN="LEFT"/>time</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-projective-curves",tooltip="On a smooth projective variety, a mixed current of uniform Fubini–Study limits on ample lines is a weak limit of individual normalized smooth complete-intersection curves over the original field. Every member retains the specified normalized intersection degrees."];
"n-core-contact-rigidity" [id="overview-complete-n-core-contact-rigidity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Zero contact identifies the upper<BR ALIGN="LEFT"/>metric</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-contact-rigidity",tooltip="A finite continuous curve-positive metric above a uniform Fubini–Study lower metric on an ample line equals it when their gap has zero integral against the lower Monge–Ampere measure. Only the lower metric needs its higher-dimensional product in advance."];
"n-core-regular-test-ideals" [id="overview-complete-n-core-regular-test-ideals",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Uniform test-ideal control on a<BR ALIGN="LEFT"/>regular model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-regular-test-ideals",tooltip="Weighted test ideals give one degree-independent vertical error and global generation after one fixed ample twist. After dividing weights by their degree, the error is O(1/m). These are the algebraic estimates used to construct the regular-model envelope."];
"n-core-regular-envelopes" [id="overview-complete-n-core-regular-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous orthogonal envelopes on<BR ALIGN="LEFT"/>regular models</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-regular-envelopes",tooltip="For a regular integral projective flat model with smooth generic fibre and an ample rational line, every finite continuous obstacle has a continuous orthogonal envelope and uniform pure-Fubini–Study approximation. Model obstacles have the stated one-sided O(1/m) approximation."];
"n-core-projective-criterion" [id="overview-complete-n-core-projective-criterion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Four equivalent forms of<BR ALIGN="LEFT"/>projective semipositivity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-projective-criterion",tooltip="Under the regular-model and ample-line hypotheses, curve positivity, positivity of the original CLD Chern current, uniform Fubini–Study approximability, and uniform approximation by global smooth positive metrics are equivalent for a finite continuous metric."];
"n-core-normal-correction" [id="overview-complete-n-core-normal-correction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>One fixed vertical correction on a<BR ALIGN="LEFT"/>normal model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-normal-correction",tooltip="On the specified normal model, one power of the uniformizer corrects test-ideal subadditivity for every coherent ideal pair and rational exponent. The exponent is chosen before those ideals and exponents; regular-model uncorrected subadditivity alone does not provide this assertion."];
"n-core-normal-envelopes" [id="overview-complete-n-core-normal-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ample envelopes through a normal<BR ALIGN="LEFT"/>model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-normal-envelopes",tooltip="For a smooth projective geometrically integral generic fibre and an ample line, the continuous-obstacle envelope is continuous, model-semipositive on the same line, uniformly approximable by nef rational model metrics, and orthogonal. Its proof uses the separate fixed-correction theorem."];
"n-core-continuous-moving" [id="overview-complete-n-core-continuous-moving",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous products with moving<BR ALIGN="LEFT"/>backgrounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-continuous-moving",tooltip="For finite continuous current-positive potentials on a smooth quasi-projective analytification, mixed products are symmetric and depend only on their curvature currents. Locally uniform convergence of potentials and weak convergence of positive closed backgrounds give joint continuity, including nets."];
"n-core-etale-tuples" [id="overview-complete-n-core-etale-tuples",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Etale compatibility for specified<BR ALIGN="LEFT"/>potential tuples</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-etale-tuples",tooltip="For an etale map, pull back the specified bounded classical potentials and pass their continuous regularizations to the weighted mixed product upstairs. The result is independent of those regularizations and compatible with restriction and composition; it constructs no pullback of an arbitrary singular current."];
"n-core-etale-degree" [id="overview-complete-n-core-etale-degree",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite-etale degree and descent of<BR ALIGN="LEFT"/>a given function</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-etale-degree",tooltip="A finite etale map of constant degree d pushes a pulled-back weighted or unweighted ambient mixed product to d times the base product. A real function already given on the base is bounded classical if its pullback along a finite etale surjection is; this does not glue unrelated functions on different sheets."];
"n-core-pws-module" [id="overview-complete-n-core-pws-module",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Intrinsic differentials on the<BR ALIGN="LEFT"/>existing PS module</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M06</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-pws-module",tooltip="Finite actual tangentially compatible piecewise-smooth coefficients times allowed closed currents have intrinsic coefficient-Radon derivatives. The corrected bounded-potential insertion agrees with inserting into each closed tail, is independent of the chosen presentation, and retains the stated differential and symmetry identities. General higher delta-form relation descent is not included."];
"n-core-order-completion" [id="overview-complete-n-core-order-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Faithful completion for fixed<BR ALIGN="LEFT"/>local order gauges</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M07</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-order-completion",tooltip="Completing the continuous curvature module in fixed positive local gauges gives faithful actual coefficient-Radon currents and a unique local positive order-continuous mixed action. Different controls are reconciled by a common sum. This completion is a specified subspace, with no identification with all positive currents or the strong first-energy space."];
"n-core-parameter-bands" [id="overview-complete-n-core-parameter-bands",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Closed bands and original<BR ALIGN="LEFT"/>conditional currents</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C04</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-core-parameter-bands",tooltip="When all parameter differentials annihilate the background, Borel parameter restrictions stay separately closed and commute with bounded BT insertion. On a second-countable ordinary domain they disintegrate into conditional currents on the original analytic space, with one exceptional set for all original tests and refinements."];
"n-core-band-completion" [id="overview-complete-n-core-band-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A qualified band-capacity<BR ALIGN="LEFT"/>completion</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C04</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-core-band-completion",tooltip="Starting from countable Borel-band combinations of globally continuous classical branches, local outer-capacity closure gives a complete quasicontinuous class with intrinsic bounded mixed currents. For the seed capacity, completed and seed outer capacities coincide. This does not identify all bounded-classical band testers with the seed family or prove raw/outer equality on compact sets."];
"n-core-ambient-no-jump" [id="overview-complete-n-core-ambient-no-jump",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ambient input N: envelopes and<BR ALIGN="LEFT"/>negligible defects</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-ambient-no-jump",tooltip="For the ambient background [1], the defect between the supremum of a locally uniformly upper-bounded classical family and its ordinary upper regularization is locally outer-null. Increasing families have no jump at ambient divisorial points. Local and fixed-domain null ideals are compared through the stated separate theorem."];
"n-core-ambient-extremals" [id="overview-complete-n-core-ambient-extremals",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ambient input E: open and compact<BR ALIGN="LEFT"/>extremals</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-ambient-extremals",tooltip="For an ordinary open G compactly contained in the specified negative-exhaustion domain V, its extremal equals -1 on G, has ordinary zero boundary value and compactly supported Monge–Ampere measure, and its total mass equals the capacity of G. Compact extremals have the corresponding total-mass identity."];
"n-core-ambient-polarity" [id="overview-complete-n-core-ambient-polarity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ambient outer-null, polar and<BR ALIGN="LEFT"/>negligible sets</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-ambient-polarity",tooltip="An outer-null subset of a relatively compact core has a nontrivial pole witness on the qualified exhaustion domain. Local ambient outer-nullity, local pluripolarity and local negligibility therefore agree. A single global pole witness on an arbitrary analytic space is not asserted."];
"n-core-ambient-extremal-mass" [id="overview-complete-n-core-ambient-extremal-mass",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Outer capacity equals ambient<BR ALIGN="LEFT"/>extremal total mass</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-ambient-extremal-mass",tooltip="For every arbitrary subset A of a relatively compact core in the qualified domain, its ambient outer capacity is the total Monge–Ampere mass of the upper-regularized extremal U_A. This theorem does not assume A is Borel or identify raw and outer capacity beforehand."];
"n-core-ambient-increasing-capacity" [id="overview-complete-n-core-ambient-increasing-capacity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Increasing continuity on arbitrary<BR ALIGN="LEFT"/>ambient sets</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-ambient-increasing-capacity",tooltip="On each fixed relatively compact core, ambient outer capacity is continuous from below on arbitrary increasing sets. The proof uses increasing ordinary open sublevel covers of extremals, not a Borel-cover substitution for the ordinary-open definition."];
"n-core-ambient-choquet" [id="overview-complete-n-core-ambient-choquet",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Qualified ambient Choquet and<BR ALIGN="LEFT"/>Borel regularity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-core-ambient-choquet",tooltip="On a fixed relatively compact core of the specified exhaustion domain, ambient outer capacity is a finite Choquet capacity. Suslin sets are capacitable; Borel sets have equal raw and outer capacities. These conclusions retain S=[1] and the domain hypotheses."];
"r-core-r1-ordered-construction" [id="overview-complete-r-core-r1-ordered-construction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r1-ordered-construction",tooltip="Use the continuous arbitrary-background positivity theorem of R, transported to the local analytic setting as in B. The background is fixed and allowed; the potentials and their limits are locally bounded classical psh, with k <= q. For continuous p_j decreasing to u, the continuous theorem makes D(p_j R) positive. Bounded convergence against the fixed coefficient measures gives p_j R -> uR; differentiation and closedness of the positive cone give D(uR). Iteration uses the resulting positive closed current as the next background. This is the construction stage, before permutation symmetry."];
"r-core-r2-collar-and-traces" [id="overview-complete-r-core-r2-collar-and-traces",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r2-collar-and-traces",tooltip="Shrink to nested polynomial norm boxes around a compact original test and retain every coordinate used by that test. All finitely many potential families have one local bound and one projective extension collar; use the smooth regularized maximum with its exact inactive branch. The lower trace estimate compares coordinatewise ordered potentials. The upper estimate assumes locally bounded decreasing weights and positive currents already convergent on all original tests. Patch the potentials to one smooth psh function near the derivative support of a cutoff. Green exchange moves a smooth majorant into a differentiated slot. Successive fixed-background limits give trace monotonicity; continuous majorants and coefficient control give the complementary upper bound for decreasing weights."];
"r-core-r3-weighted-induction" [id="overview-complete-r-core-r3-weighted-induction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r3-weighted-induction",tooltip="All k differentiated rows and the undifferentiated weight decrease to locally bounded classical psh limits on a common neighborhood. The background stays fixed and 0 <= k <= q; the test is any original compact smooth complementary form. Induct on k. Weighted convergence in degree k-1 gives unweighted convergence in degree k after differentiation. The two collar trace bounds identify the weighted degree-k limit. Positive tests of the form C times a trace plus or minus the given test then recover convergence on every original test."];
"r-core-r4-full-bounded-calculus" [id="overview-complete-r-core-r4-full-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r4-full-bounded-calculus",tooltip="Use symmetry of the continuous arbitrary-background products, obtained by smooth uniform approximation. For CLN bounds, work between nested compact cutoff neighborhoods and bound each potential there; k <= q. Continuous regularizations satisfy permutation symmetry; joint decreasing continuity passes that identity to bounded potentials. The coefficient CLN bound is obtained separately from the ordered recursion: integrate by parts through nested cutoffs, gaining one potential sup norm per slot. No curvature-quotient assertion is used in either argument."];
"r-core-r5-capacity-energy-estimate" [id="overview-complete-r-core-r5-capacity-energy-estimate",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 05</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r5-capacity-energy-estimate",tooltip="Omega is the interior of one polynomial norm box; a compact L lies in a strictly smaller nested box. The row u_j decreases to u, is uniformly bounded near L, and u_j = u = one smooth psh h on Omega minus L. Fix the allowed background, a smooth trace form beta when k < q, and 1 <= k <= q. The bounded calculus first yields relative energy measures, Green's identity and Cauchy–Schwarz. For g_j = u_j-u and normalized testers v, these give I_r squared <= A_r I_(r-1), with A_r uniformly bounded by relative CLN. Iterate to exponent 2^(-k), use the level-set bound, and let I_0 tend to zero against the single fixed measure (Du)^k S beta^(q-k)."];
"r-core-r6-capacity-quasicontinuity" [id="overview-complete-r-core-r6-capacity-quasicontinuity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 06</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r6-capacity-quasicontinuity",tooltip="The decreasing family is defined on a neighborhood of the closure of a sufficiently small norm box Omega; V_0 is a smaller relatively compact core. Keep the admissibility domain and relative capacity fixed, and use its countable subadditivity. Patch the entire family to the common collar and apply the quantitative estimate on the core. For a continuous decreasing regularization, choose a subsequence whose exceptional capacities are summable. The union of its ordinary open error sets has arbitrarily small capacity; outside that union the subsequence converges uniformly, so its limit is continuous."];
"r-core-r7-curvature-order" [id="overview-complete-r-core-r7-curvature-order",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 07</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r7-curvature-order",tooltip="Use actual bounded classical differences, rather than representatives modulo an almost-everywhere relation. For background order, u and v are bounded classical potentials and p < n; a mixed replacement uses a positive closed mixed tail with total degree at most n. Positive D[u-v] makes the actual difference u-v classical psh by the separate criterion; first-order positivity then gives D((u-v)S) >= 0. Equality follows in both orders, and symmetry moves any chosen slot to the front. For the kernel, apply the criterion to both signs: both are upper semicontinuous, hence the actual function is continuous; pointedness gives the converse."];
"r-core-r8-curvature-gluing" [id="overview-complete-r-core-r8-curvature-gluing",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 08</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r8-curvature-gluing",tooltip="Each input current locally has a potential a_i in C_b with alpha_i = D[a_i]; the chosen background is fixed and k <= q. On overlaps, the two local potentials represent the same actual curvature current. Replace the local potentials one slot at a time on each overlap. Background invariance identifies the mixed currents, and the sheaf property of currents glues them uniquely. Positivity, symmetry and separate closedness pass from the local bounded products."];
"r-core-r9-continuous-relations" [id="overview-complete-r-core-r9-continuous-relations",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 09</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r9-continuous-relations",tooltip="Use finite presentations A = sum f_i D[g_i], with f_i continuous and g_i in C_b; equality and positivity are those of actual original currents. The mixed degree remains at most n; other curvature slots and the background are positive when positivity is asserted. Freeze the continuous coefficients on small neighborhoods. The bounded-difference criterion converts each positive frozen curvature combination into a classical psh potential, so first-order positivity transfers it to the background. Finite coefficient control makes the freezing error tend to zero. Transfer zero relations one slot at a time to obtain presentation independence; the same estimate proves positivity of the mixed operation."];
"r-core-r10-strict-maximum-locality" [id="overview-complete-r-core-r10-strict-maximum-locality",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 10</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r10-strict-maximum-locality",tooltip="The background is fixed, u, v and the remaining slots lie in C_b, and 1 <= k <= q. Borel restrictions are coefficient-measure restrictions; no closedness of a restricted current is asserted. On continuous approximants, ordinary locality gives h_j A_j = h_j B_j for h_j = max(u_j,v_j)-v_j. Pass to the limit by subtracting two applications of weighted decreasing continuity; the differences h_j need not decrease. The resulting identity h(A-B)=0 can be divided by h on {h >= 1/m}; a countable union recovers {u > v}."];
"r-core-r11-compact-gap-comparison" [id="overview-complete-r-core-r11-compact-gap-comparison",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 11</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r11-compact-gap-comparison",tooltip="q >= 1 and u,v belong to C_b(V). For every epsilon > 0, the ordinary closure of {u < v-epsilon} is compact and contained in V. The background is defined and separately closed throughout V; use the top relative measures mu_a = T(S,q)(a,...,a). Put w = max(u,v-epsilon). The mixed telescoping identity writes mu_w-mu_u = D((w-u)Q), with compact support. A cutoff makes its total signed mass zero. Maximum locality identifies the measures on the two strict regions; positivity controls the equality region. Let epsilon decrease to zero. This argument does not pass through quasicontinuity or a capacity theorem."];
"r-core-r12-capacity-zero-conclusions" [id="overview-complete-r-core-r12-capacity-zero-conclusions",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 12</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r12-capacity-zero-conclusions",tooltip="Choose the relevant conclusion. Domination requires compact gaps in the order (u,v) and mu_u({u < v}) = 0. Uniqueness instead requires compact gaps in both orders and mu_u = mu_v as Radon measures. Capacity uses the full normalized classical tester family 0 <= h <= 1 on the same V. Perturb the comparison potential by epsilon(h-1)-delta. Positivity of the mixed expansion exposes the term epsilon^q mu_h on a smaller strict gap. Comparison forces its mass to vanish for every normalized tester; taking the supremum and a countable union gives capacity zero. For uniqueness, cancel only finite masses on compact gaps and then repeat in the other order."];
"r-core-r13-conditional-pointwise" [id="overview-complete-r-core-r13-conditional-pointwise",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 13</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r13-conditional-pointwise",tooltip="Supply strict-gap detection for the same pair (S,V) and actual classical representatives. Retain the corresponding domination assumptions, or the equal-measure and two-sided-gap assumptions for uniqueness. A prohibited pointwise inequality would hold with some positive margin. Its nonempty strict gap would have positive capacity by the extra condition, contradicting the capacity-zero conclusion. The implication is proved; supplying detection for a proposed geometric class is the open obligation."];
"r-core-r14-borel-remainder-open" [id="overview-complete-r-core-r14-borel-remainder-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 14</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r14-borel-remainder-open",tooltip="Fix a strict Laurent box V, q >= 1, and an allowed background S extending to a neighborhood of its closure. Use outer capacity C*_S and the full family of actual normalized classical testers defined on this same V. One proposed sufficient local route remains to be proved: for a relatively compact Borel E and each epsilon > 0, find a compact H contained in E and an ordinary open G containing E minus H whose mass is below epsilon uniformly for every actual normalized tester measure. Separately justify passage to an exhaustion of V while preserving the full tester family and the uniform estimates; a countable dominating-measure reduction or replacement by completed sources needs its own theorem. The established convergence and quasicontinuity results provide the local capacity calculus, but do not supply uniform Borel remainders across the entire tester family. The finite-Hausdorff saturated model proves such a remainder estimate in a restricted range and suggests this route. Its extension and the exhaustion step remain open. Failure of raw/outer equality or strong subadditivity blocks shortcuts, not CAP-BOREL itself."];
"r-core-r15-approachable-calculus" [id="overview-complete-r-core-r15-approachable-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 15</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r15-approachable-calculus",tooltip="Work in the continuous theory on a smooth quasi-projective analytification over the original valued field; every potential already admits locally uniform smooth positive approximants on a fixed smaller neighborhood. All backgrounds in the net are positive and separately closed of the same bidegree; the total mixed degree is at most n. For a smooth approximant, D(u_j T)=Du_j wedge T is positive. Continuous coefficient control passes locally uniform approximation and weak background limits through multiplication, then differentiation. Iteration and simultaneous smooth approximation give symmetry. This foundational step assumes approachability; it does not first need the current-positivity regularization theorem."];
"r-core-r16-projective-curves" [id="overview-complete-r-core-r16-projective-curves",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 16</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r16-projective-curves",tooltip="Y is smooth projective of dimension n>=2; the n-1 line bundles are ample rational lines and their metrics are uniform Fubini–Study limits. Use characteristic-zero Bertini over K, the original calibrated Poincare–Lelong formula, and the total-variation nullity of tie hyperplanes for each smooth test. Choose generating sections with prescribed distinct coefficient valuations. For each smooth test, ties have zero mass eventually and the one-cut Poincare–Lelong error is O(1/N). Successive smooth cuts and continuity in the positive background give a net of individual normalized complete-intersection curves. Normalized degrees are preserved algebraically at every cut."];
"r-core-r17-contact-rigidity" [id="overview-complete-r-core-r17-contact-rigidity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 17</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r17-contact-rigidity",tooltip="Y is smooth projective integral of positive dimension; L is ample; the lower metric p is a uniform Fubini–Study limit and the upper metric r is finite continuous and positive on every smooth algebraic curve map. Assume r>=p and integral (r-p)c1(L,p)^n = 0. Use curve Green identities and the smooth-divisor concentration lemma; in dimension one use the curve argument directly. Normalized curves give positive upper comparison measures with controlled total variation. Zero contact makes the mixed energy vanish; testing its quadratic perturbation annihilates the mixed Laplacian. Divisor concentration transfers contact to smooth hyperplane sections, and dimension induction plus density of rigid points proves r=p."];
"r-core-r18-regular-envelopes" [id="overview-complete-r-core-r18-regular-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 18</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r18-regular-envelopes",tooltip="The model is regular, integral, projective and flat over the original valuation ring, with smooth generic fibre; L is an ample rational line and the obstacle is finite continuous. Use density of model metrics, the envelope Lipschitz estimate, and the cited orthogonality theorem for geometrically reduced generic fibres, with its measure identified with the CLD product. Global generation produces Fubini–Study metrics on the degree-m line plus a fixed auxiliary line. A fixed complementary generating tuple removes that twist. The test-ideal bounds and the envelope property give a one-sided O(1/m) error for model obstacles. Uniform density extends continuity and approximation to continuous obstacles; the cited orthogonality theorem supplies the contact integral."];
"r-core-r19-projective-criterion" [id="overview-complete-r-core-r19-projective-criterion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 19</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r19-projective-criterion",tooltip="Retain the regular integral projective flat model, smooth positive-dimensional generic fibre, ample line and finite continuous metric r. Use smooth approximation of Fubini–Study metrics and the curve-restriction theorem for a current-positive continuous weight; clear any rational tensor denominator. For curve-positive r, the envelope p is semipositive, lies below r and is orthogonal. Contact rigidity forces r=p. Smooth Fubini–Study approximation then gives smooth positive approximation and current positivity; curve restriction closes the reverse implication. The envelope and contact results are joint inputs."];
"r-core-r20-normal-envelopes" [id="overview-complete-r-core-r20-normal-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 20</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r20-normal-envelopes",tooltip="Use a normal integral projective flat model over the complete mixed-characteristic valuation ring, with smooth projective geometrically integral generic fibre and ample L. After the specified canonical-sheaf modification, choose an effective vertical Delta_0 with K+Delta_0 Cartier; use the stated test-ideal birational, summation and generation theorems. Use density of model metrics and the cited envelope orthogonality theorem; no regular-model resolution hypothesis is silently imposed on this normal-model proof. Iterating the same fixed vertical correction gives an O(1/m) lower estimate for weighted asymptotic test ideals. A fixed birational upper error and one fixed ample generation twist give the upper estimate. Cancelling the auxiliary line and dividing by degree gives uniform approximation on the original identified L; density and orthogonality finish the continuous-obstacle statement."];
"r-core-r21-continuous-moving-backgrounds" [id="overview-complete-r-core-r21-continuous-moving-backgrounds",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 21</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r21-continuous-moving-backgrounds",tooltip="Use the continuous part of local regularization on a smooth quasi-projective analytification: every finite continuous input has positive original curvature current. Potentials converge locally uniformly and backgrounds converge weakly on every original compact smooth test, remain positive and separately closed, and have one fixed bidegree. Regularization places each current-positive continuous potential in the approachable class. Iterate the foundational moving-background operation. If two potentials have equal curvature, their continuous difference and its negative are both approachable; positivity and pointedness force zero insertion of that difference against every allowed closed tail."];
"r-core-r22-etale-tuples" [id="overview-complete-r-core-r22-etale-tuples",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 22</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r22-etale-tuples",tooltip="f:Y->X is etale between the allowed analytic spaces. A specified tuple u_0,...,u_k lies in C_b on one base ordinary open, with simultaneous decreasing continuous semipositive regularizations there. Use the ambient integration backgrounds [1] on each space, the original pullback identity for smooth forms, and k<=n. At continuous stages, locally uniform smooth approximation identifies the pulled-back operation with the product of the pulled-back weights. Weighted decreasing continuity on Y gives the bounded limit on every original test. Reusing the same approximants proves compatibility with composition and ordinary restriction."];
"r-core-r23-etale-degree-and-descent" [id="overview-complete-r-core-r23-etale-degree-and-descent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 23</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r23-etale-degree-and-descent",tooltip="For the degree formula, f is finite etale of constant degree d, and all potentials are specified bounded classical functions on the base; locally constant degrees are handled componentwise. For class descent, f is a finite etale surjection and u is one real function already given on the base with u composed with f in C_b. Use the cited finite-surjection descent of classical curve subharmonicity. The calibrated finite-map integration formula gives the degree factor for smooth tuples; properness keeps pulled-back tests compact, so continuous approximation and weighted decreasing continuity pass the identity to bounded tuples. For the given base function, closedness of the finite map descends upper semicontinuity and local boundedness; curve subharmonicity descends separately."];
"r-core-r24-existing-pws-module" [id="overview-complete-r-core-r24-existing-pws-module",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 24</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r24-existing-pws-module",tooltip="Use the established actual codimension-zero PS multiplication, tangency and anchored finite Courant-word presentation, together with the uniform normal-wall variation estimate. R is a finite sum alpha_nu wedge S_nu, with actual tangentially compatible piecewise-smooth forms alpha_nu and allowed positive separately closed tails S_nu; R itself need not be closed or symmetric. Inserted potentials are actual locally bounded classical psh; in bidegree (a,b), the mixed insertion budget is max(a,b)+k<=n. No general variable-PS higher delta-form quotient is assumed. Simultaneously convolve the finite PL generators. Normal-factor errors are O(epsilon^(1/2)) uniformly over the relevant positive BT tails. First pass weighted BT limits against a fixed smooth test, then remove smoothing. Distributional differentiation makes the derivatives intrinsic. The corrected insertion cancels derivatives of the coefficient current and becomes the sum of the same coefficients times D(uS_nu), proving witness independence."];
"r-core-r25-fixed-gauge-completion" [id="overview-complete-r-core-r25-fixed-gauge-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 25</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r25-fixed-gauge-completion",tooltip="In each local slot choose a fixed positive represented gauge Q_i, and take an order-Cauchy sequence in its order ideal of symmetric coefficient-Radon (1,1) currents; the number of slots is at most n-p. Use finitely many common local controls, rather than asserting one global gauge. To conclude separate closedness of the limiting product, require its approximating mixed products to be separately closed. Decompose each controlled signed factor into the positive factors (M_i Q_i plus or minus A_i)/2 and telescope differences to get the sharp order bound. Finite test domination realizes order-Cauchy rows as actual currents; weak closedness of the cone proves faithfulness and isometry. Passing the mixed action to limits gives a unique extension, and replacing two choices of control by their sum proves independence and local gluing."];
"r-core-r26-closed-bands-and-disintegration" [id="overview-complete-r-core-r26-closed-bands-and-disintegration",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 26</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r26-closed-bands-and-disintegration",tooltip="Let s=(log|f_i|) for original analytic units and let R be an allowed symmetric positive separately closed coefficient-Radon current with both d′s_i wedge R=0 and d″s_i wedge R=0. For the Borel commutation identity, u is locally bounded Borel and D(uR) is coefficient-Radon; bounded classical BT potentials satisfy this requirement. For conditional currents, work on a second-countable ordinary U and use Radon measure disintegration with the proved countably cofinal original-test system. No rank, submersion, product-chart or fiber-field hypothesis is substituted for these conditions. The smooth chain rule kills every parameter derivative by annihilation. One Borel L1 approximation against the coefficient measures of R and D(uR) passes the identities to Borel bands. A countable control measure then permits simultaneous disintegration of original coefficients. Countably cofinal tests impose positivity, closedness and refinement identities outside one null set; continuity recovers every original test. The conditional currents live on U and are carried by its level sets."];
"r-core-r27-band-capacity-completion" [id="overview-complete-r-core-r27-band-capacity-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 27</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r27-band-capacity-completion",tooltip="Retain parameter annihilation and place the closure of V inside the interior of one compact original affinoid; the background has degree P and remaining degree k=n-P>=1. This construction does not require extension of R across the boundary. The seed family consists of [0,1]-valued countable Borel parameter-band combinations of globally continuous actual classical psh branches. Distinguish its capacity gamma_0 from gamma_1 for all bounded-classical band testers. Complete the seed family in local OUTER gamma_i capacity, for the chosen i=0 or 1, modulo the matching locally outer-null ideal. Do not assume gamma_0=gamma_1 or raw/outer equality on compact sets. Capacity convergence of the seed rows, together with uniform coefficient estimates by outer capacity, makes the bounded mixed currents Cauchy on every original test. Weighted weak passage and the distributional recursion give positive closed intrinsic limits, independent of rows. For the seed capacity, gamma_0<=completed gamma_0<=outer gamma_0, equality on ordinary opens and equality after outer regularization follow. The larger tester family has only the stated inequalities; its cofinality remains a separate issue."];
"r-core-r28-ambient-pole-witness" [id="overview-complete-r-core-r28-ambient-pole-witness",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 28</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r28-ambient-pole-witness",tooltip="The background is [1]. V is a connected ordinary open with compact closure in a smooth affine algebraic chart, nonempty ordinary boundary, and a bounded continuous negative classical exhaustion rho extending continuously as zero on that boundary. For a witness, E lies in W compactly contained in V and has fixed-domain ambient outer capacity zero. Use the established ambient increasing calculus, pointwise ambient domination, and local/fixed-domain null comparison. For the reverse implication use the already established ambient polar-to-outer-null theorem; local equivalence does not assert unrestricted global pole patching. Choose decreasing ordinary open covers of E with capacities tending to zero. Their extremals increase; the N and E inputs plus the adopted increasing calculus give a zero-mass upper-regularized limit. Ambient pointwise domination makes that limit zero. No jump at a fixed divisorial point allows a subsequence whose negative sum stays finite there but equals minus infinity on E. The existing polar-null implication and local arguments give the equivalence."];
"r-core-r29-ambient-extremal-formula" [id="overview-complete-r-core-r29-ambient-extremal-formula",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 29</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r29-ambient-extremal-formula",tooltip="Use S=[1] and the same qualified negative-exhaustion domain. A is any subset of a fixed W compactly contained in V; keep V as the admissibility domain. Use the total-mass order for bounded negative classical functions with ordinary zero boundary limit; retain the upper-regularized extremal U_A rather than its raw supremum. An open cover G gives U_G<=U_A, so total-mass order yields one inequality. Input N says A misses the -1 contact set of U_A only on an outer-null set. The truncation max(-1,U_A/(1-eta)) controls the ordinary open sublevel {U_A<-1+eta}; its mass bound gives the reverse inequality as eta tends to zero. No pole-witness theorem is used."];
"r-core-r30-ambient-increasing-capacity" [id="overview-complete-r-core-r30-ambient-increasing-capacity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 30</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r30-ambient-increasing-capacity",tooltip="A_j are arbitrary increasing subsets of one relatively compact core W in the same qualified domain V, with S=[1]. Use countable outer subadditivity and raw-capacity continuity from below only for Borel sets, in particular ordinary open sets. The extremals U_(A_j) decrease. Cover their countably many negligible contact defects by one ordinary open set of arbitrarily small capacity. Its union with {U_(A_j)<-1+eta} gives increasing ordinary open covers. The extremal mass estimate controls their capacities; raw continuity on these opens then gives the desired outer-capacity limit."];
"r-core-r31-ambient-choquet" [id="overview-complete-r-core-r31-ambient-choquet",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 31</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r31-ambient-choquet",tooltip="Retain S=[1] and a fixed relatively compact ordinary core W in the specified negative-exhaustion domain. This core is locally compact, second countable and metrizable in the fixed finite p-adic algebraic setting. Use the established outer-capacity continuity from above on decreasing compact sets, compact finiteness, and the classical Choquet capacitability theorem. The new increasing continuity supplies the missing Choquet axiom. The arbitrary-set mass formula and compact extremal identity identify raw and outer capacity on compact sets. Choquet capacitability handles Suslin sets. On Borel sets, Radon inner regularity permits interchanging two suprema, yielding raw/outer equality. The qualified ambient theorem leaves the general relative CAP-BOREL question open."];
}
subgraph "cluster-descent" {
graph [id="overview-complete-cluster-descent",label=<Actual-relation descent and the normal-three<BR ALIGN="LEFT"/>center>,labelloc=t,labeljust=l,fontsize=19,fontcolor="#31483b",style="rounded",color="#b9c9b5",margin=24];
"n-d-transgression" [id="overview-complete-n-d-transgression",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Quadratic transgression and first<BR ALIGN="LEFT"/>derivatives</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-d-transgression",tooltip="For a finite admissible quadratic presentation P, the full degree-one action obeys A_S(P) = D M_S(α_P) = −D M_S(Z_P). The singular term A₀ = ½Dδ(Σcνhνkν) is retained. Full first derivatives commute with M_S, including polyhedral boundary contributions."];
"n-d-full-exact" [id="overview-complete-n-d-full-exact",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>An actual full-exact certificate</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01 · G06 · O02</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-d-full-exact",tooltip="On one ordinary representative chosen for P, α_P = d′β + d″ζ in the actual delta-form sheaf. This is a hypothesis available in proved special cases; its existence for every quadratic actual zero remains open. It does not require a continuous smooth-form double primitive."];
"n-d-fixed-control" [id="overview-complete-n-d-fixed-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Exact approximants with one<BR ALIGN="LEFT"/>control</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G06 · O02</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-d-fixed-control",tooltip="Actual symmetric full-exact forms a_j approximate α_P in the represented order interval −ε_jQ ≤ [α_P]−[a_j] ≤ ε_jQ, with ε_j → 0 and one fixed positive represented Q. The all-background degree-one estimate is part of this certificate. The same ordinary domain, Q and approximants precede later backgrounds, tests and refinements."];
"n-d-carrier" [id="overview-complete-n-d-carrier",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A zero full-carrier seminorm</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G05 · O02</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-d-carrier",tooltip="For the specified closed carrier F, the unchanged carrier-CLN seminorm of P vanishes at every required enlarged compact stage. Only the permitted harmonic, pointwise-zero-product and ambient-cycle generators are used. Whether every actual PL-zero has the required absolute-cap certificates is open; zero action does not imply this stronger certificate."];
"n-d-vanishing" [id="overview-complete-n-d-vanishing",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>The specified quadratic action<BR ALIGN="LEFT"/>vanishes</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01 · G05 · G06</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-d-vanishing",tooltip="The action A_S(P) is zero on all original compact smooth complementary tests under any one incoming sufficient route and that route’s displayed hypotheses. Exactness and fixed-control approximation allow every legal S. The direct carrier theorem allows the S carried by its specified F. This node does not assert that every actual relation already has such a certificate."];
"n-d-rank-two" [id="overview-complete-n-d-rank-two",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Rank at most two constructs<BR ALIGN="LEFT"/>certificates</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G06 · G07</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-d-rank-two",tooltip="For an actual quadratic zero in a fixed finite continuous closed-cell PL/PS presentation with joint residue rank s_f(x) ≤ 2, the source construction returns a full strain covector to the whole actual moment image. It constructs both full first-order exactness and fixed-Q approximants on an ordinary neighborhood, in arbitrary ambient dimension."];
"n-d-low-rank-quotient" [id="overview-complete-n-d-low-rank-quotient",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A canonical quotient when s_K ≤ 2</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G08</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-d-low-rank-quotient",tooltip="If the entire residue dimension satisfies s_K(x) ≤ 2, the quadratic transgression class depends only on the actual quadratic curvature. The canonical map τ₂ satisfies D̄τ₂ = id. These classes glue on ordinary opens satisfying the bound, including analytic surfaces. Separately low-rank presentations are insufficient unless their union tuple also meets the bound."];
"n-d-weak-class" [id="overview-complete-n-d-weak-class",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Descent over weakly approximable<BR ALIGN="LEFT"/>backgrounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-d-weak-class",tooltip="For S in W_loc, actual delta-form action is presentation independent, local and compatible with full first derivatives. W_loc uses weak convergence on all original smooth tests on one fixed ordinary domain, allowing nets. Fixed continuous curvature slots preserve the required weak convergence; bounded BT tails remain in the class."];
"n-d-background-density" [id="overview-complete-n-d-background-density",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Every allowed background lies in<BR ALIGN="LEFT"/>W_loc</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G02 · O01</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-background-density",tooltip="The proposed density theorem would put each arbitrary symmetric middle-positive, separately closed original background in the same-domain weak closure of actual positive closed delta-form backgrounds. Existing potential, cap and geometric examples do not establish this assertion for an arbitrary current."];
"n-d-general-descent" [id="overview-complete-n-d-general-descent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>General actual-relation descent</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O01 · O02</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-general-descent",tooltip="For every admissible finite actual curvature relation of every degree b, choose an ordinary representative for the relation before S and tests, and prove A_S(P) = 0 for all legal backgrounds and all actual refinements. The general quadratic case remains open; low-rank and supplied-model conclusions retain their hypotheses."];
"n-d-differential-interfaces" [id="overview-complete-n-d-differential-interfaces",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Higher and coefficient interfaces</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O06</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-differential-interfaces",tooltip="A general differential calculus still needs presentation independence for variable finite PS coefficients and higher coupled tails, the differential identities, the intended delta-test extension, and gluing and naturality in the stated mapping class. One common BT tail can be absorbed into S; different termwise tails cannot be absorbed by that argument."];
"n-d-model-input" [id="overview-complete-n-d-model-input",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A supplied normal-three actual<BR ALIGN="LEFT"/>zero</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G09 · G10 · G11</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-d-model-input",tooltip="A supplied smooth integral normal-three model germ (Y,y) over the original field, with unchanged value group and residue transcendence degree three, carries the fixed finite closed-cell PL/PS quadratic actual zero. The supplied data include original-field lifting, complete-source comparison on a smooth projective SNC model, all labelled Gauss families and lower strata, and ordinary convergence uniform in the angular parameter."];
"n-d-punctured" [id="overview-complete-n-d-punctured",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Action vanishes off the center</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G07 · G09 · G10 · G11</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-d-punctured",tooltip="In that supplied model, an ordinary U chosen for P before S and tests satisfies A_S(P)|_(U minus {y}) = 0. The proof covers actual ordinary points through top-cone neighborhoods, marked-curve tubes, completed surface core fibers and the rank-two complement. It uses current locality, not a single global primitive on the puncture."];
"n-d-point-residual" [id="overview-complete-n-d-point-residual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Only a top-degree Dirac remains</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G11</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-d-point-residual",tooltip="The finite signed BT action is coefficient-Radon and separately closed. In the supplied threefold, punctured vanishing therefore gives zero everywhere for p = 0, and A_S(P) = c_S(P) δ_y for p = 1. The scalar is independent of the compact cutoff equal to one near y."];
"n-d-protected-tangent" [id="overview-complete-n-d-protected-tangent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Protected tangents retain the wall<BR ALIGN="LEFT"/>terms</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G12 · G13</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-d-protected-tangent",tooltip="For the same degree-one S and a protected actual presentation, the full-fiber transpose T has critical trace mass O(r²) and positive closed conic tangent limits T₀. The paired leading PL energy Z₀ satisfies an all-face O(r) error estimate. Compatible-PS continuity retains wall mass when passing its pairing to a tangent; ordinary smooth weak convergence alone would not suffice."];
"n-d-spherical-residual" [id="overview-complete-n-d-spherical-residual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>An exact spherical residual<BR ALIGN="LEFT"/>formula</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G12 · G13 · G14</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-d-spherical-residual",tooltip="For every critical tangent jointly realized by this P and S, c_S(P) equals Σcν(∫hν^[1]kν^[1] dσ − ∫d_S hν^[1] ⊗ d_S kν^[1] : dM). The finite positive semidefinite angular matrix measure satisfies Mθ = 0, div_S M = 0 and σ = tr M. The value is tangent independent. Classification of real cones does not show that an arbitrary real cone is analytically realized."];
"n-d-critical-cancellation" [id="overview-complete-n-d-critical-cancellation",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>The realized spherical pairing<BR ALIGN="LEFT"/>vanishes</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G14 · O07</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-critical-cancellation",tooltip="The missing assertion is cancellation for every actual jointly realized pair (Z₀,M) in this supplied-model category. It is known for zero tangent density, globally linear first jets, and a leading tensor with an actual full-exact identity near the whole protected central fiber; the established potential and W_loc subclasses are also covered. No argument yet covers all allowed S and all actual zero relations."];
"n-d-model-descent" [id="overview-complete-n-d-model-descent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Full quadratic descent in this<BR ALIGN="LEFT"/>model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G11 · O07</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-d-model-descent",tooltip="If the open cancellation assertion is proved throughout the supplied normal-three class, its quadratic actual zeros have zero action on U in both legal degrees p = 0 and p = 1. This is a specific conditional target. It neither returns the model to every original germ nor settles higher coupled or variable-coefficient relations."];
"n-d-shortcut-limits" [id="overview-complete-n-d-shortcut-limits",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Why shortcut arguments stop</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G03 · G04 · N07 · N08 · N09 · N10 · N11</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="#logic-node-d-shortcut-limits",tooltip="Normal-current constructions retain a harmonic boundary defect; scalar harmonic identifications do not supply a missing continuous potential. N07 excludes an automatic continuous smooth-form double primitive. N08 gives a real Killing-gluing obstruction, N09 retains graph Hessian-wall drift, N10 obstructs stronger residue-section and whole-central-fiber Hensel lifts, and N11 shows that O(r²) growth can retain a point residual. These examples do not refute the actual analytic-zero conjecture."];
"r-d-e-exact" [id="overview-complete-r-d-e-exact",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 32</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-exact",tooltip="P is the specified admissible finite quadratic actual zero on the same ordinary representative as its full-exact identity. S is any allowed original background of degree 0 ≤ p ≤ n−2; retain all original compact smooth tests and actual refinements. Full derivative compatibility gives M_S(α_P) = d′(β ∧ S) + d″(ζ ∧ S). Applying D kills both terms by nilpotence and anticommutation. No higher-degree arbitrary-current product is assumed."];
"r-d-e-control" [id="overview-complete-r-d-e-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 33</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-control",tooltip="P is the specified admissible finite quadratic actual zero, with exact a_j, ε_j → 0 and a single positive represented Q on one fixed ordinary neighborhood. The represented order estimate transfers to the all-background degree-one action for every allowed 0 ≤ p ≤ n−2; Q and the neighborhood do not vary with the test or later refinement. Each exact a_j has zero differentiated action. The fixed positive control bounds every remaining compact pairing by ε_j times a finite fixed mass; distributional continuity of D then gives zero. Approximating only Z_P retains the complete singular A₀ term."];
"r-d-e-carrier" [id="overview-complete-r-d-e-carrier",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 34</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-carrier",tooltip="Here P is a finite quadratic PL curvature polynomial and S is an allowed background carried by the specified unchanged closed F, in a legal degree. Zero seminorm holds at every enlarged compact stage required for the test, using finite decompositions on the same ordinary domain and only the permitted generator space. An absolute-cap certificate directly kills its relative capped background. Returning from all such caps to an uncapped S uses the separate KC9 detector: q = n−(p+b) > 0 and 1 ≤ c ≤ max(q mod 2, q−2 floor(p/2)). That proposition gives no positive-rank cap route when q = 0 or this upper bound is zero. Permitted carrier relations act by zero. Apply the uniform carrier-only CLN estimate to each remainder and take the seminorm infimum. This proves a sufficient annihilation criterion; it does not identify the actual analytic kernel or all seminorm polars."];
"r-d-e-rank-exact" [id="overview-complete-r-d-e-rank-exact",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 35</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-rank-exact",tooltip="The fixed relation is an actual quadratic zero in the finite continuous closed-cell PL/PS class, and its entire original scalar tuple f satisfies s_f(x) ≤ 2. Use the constructed ordinary neighborhood and finite actual original-unit refinement; all lower strata and later deficient-rank refinements remain included. The normal-surface construction returns a continuous finite-PS covector whose full strain is Z_P on the whole actual moment image. Since A₀ = ½Dδu is already full-exact, α_P = A₀−Z_P has an actual first-order exact expression."];
"r-d-e-rank-control" [id="overview-complete-r-d-e-rank-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 36</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-rank-control",tooltip="Retain the same actual zero, full finite closed-cell source data and joint bound s_f(x) ≤ 2. Fix 1 < κ < 2 and one ordinary truncation before later backgrounds and tests. Regularize the returned continuous covector and use the finitely many coefficient facets, |ℓ_H|^κ and a fixed strictly convex term to construct one positive Q = D[q]. The source-side all-background estimate is O(δ^((2−κ)/2)); setting a_j = A₀−e_δj yields the required full-exact approximation."];
"r-d-e-union-quotient" [id="overview-complete-r-d-e-union-quotient",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 37</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-union-quotient",tooltip="Impose the stronger intrinsic bound s_K(x) ≤ 2, so the union tuple of any two finite presentations has joint residue rank at most two. For a sheaf morphism, this bound holds at every point of the ordinary open; local finite presentations and the actual quotient sheaf are retained. Two presentations of one actual quadratic curvature differ by an actual zero. Apply rank-two exactness to their union tuple, so their transgression classes agree. The singular A₀ is exact, and ordinary sheaf gluing gives τ₂ with D̄τ₂ = id. Separate rank bounds on the two tuples alone would not justify this argument."];
"r-d-e-puncture" [id="overview-complete-r-d-e-puncture",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 38</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-puncture",tooltip="Retain every supplied original-field model/source comparison, labelled cone, calibration and completed core fiber in the model hypothesis. P is the fixed admissible quadratic actual zero; S is any allowed original background with p = 0 or p = 1 on the supplied threefold. Choose the ordinary U for P before S and compact tests; the cover is a cover of actual ordinary points. Top interiors have ambient strain neighborhoods, positive two-faces use completed marked-curve data, and rays use ordinary neighborhoods of completed surface core fibers. Outside the fixed old source, the original scalar tuple has rank at most two. A finite partition of each compact test and ordinary current locality assemble the punctured equality."];
"r-d-e-dirac" [id="overview-complete-r-d-e-dirac",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 39</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-dirac",tooltip="The current is the finite signed bounded BT action of the specified continuous PL/PS quadratic presentation, so it is coefficient-Radon and separately d′- and d″-closed. The ambient analytic dimension is three and p is 0 or 1. Punctured vanishing puts the support at y. A separately closed order-zero point current vanishes below top bidegree; in top degree it is a scalar Dirac measure. Thus p = 0 is complete, while p = 1 has precisely c_S(P)δ_y left."];
"r-d-e-protected" [id="overview-complete-r-d-e-protected",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 40</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-protected",tooltip="Use the same actual quadratic presentation and an allowed degree-one background S. Supply a finite protected actual moment map t containing every scalar, with t(y) = 0 and the whole inverse image of every compact target support compact in U. Retain the complete finite closed-cell scalar jets and their tangential values on every face. Transposing original tests through the protected whole fiber gives a positive separately closed real current. The critical monotonicity estimate supplies conic tangent subsequences; the paired first-jet estimate gives O(r) coefficient error, and the compatible-PS approximation controls the wall terms for the tangent pairing."];
"r-d-e-sphere" [id="overview-complete-r-d-e-sphere",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 41</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-sphere",tooltip="The residual, transpose, leading tensor and tangent come from the same P, S and protected actual presentation; take p = 1. Use the full paired tensor Z₀ and canonical tangential face values, with the complete protected inverse image retained in every shrinking cutoff. A cutoff Hessian has size O(δ⁻²), while trace mass is O(δ²) and the leading-energy error is O(δ), so the replacement error tends to zero. Compatible-PS continuity passes the remaining pairing to T₀. Radial and tangential decomposition then gives the spherical formula and D(Z₀ ∧ T₀) = −c_S(P)δ₀."];
"r-d-e-model-close" [id="overview-complete-r-d-e-model-close",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 42</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-model-close",tooltip="Assume the still-open cancellation statement for every admissible quadratic actual zero and every degree-one S in this supplied-model category, with their common protected presentations. Retain the already proved p = 0 case and punctured vanishing from the point-residual theorem. The formula identifies the only remaining coefficient c_S(P) with the hypothesized zero pairing. This removes the central Dirac in degree p = 1; the degree p = 0 action already vanishes. The implication is proved, but its universal cancellation premise remains open."];
"r-d-e-critical-obstructions" [id="overview-complete-r-d-e-critical-obstructions",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#9a4b30"><B>Blocks this shortcut 43</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fffef9",URL="#logic-descent-d-e-critical-obstructions",tooltip="The shortcut under examination uses local strain primitives, graph pullback or critical O(r²) mass alone, without additional actual-zero realization data. The real Killing example is not separately closed; the critical-mass example is not an actual analytic-zero presentation. Their counterexamples have precisely these restricted targets. Local primitives can fail to glue, pulling a primitive through a PL graph retains a Hessian-wall measure, and O(r²) mass can survive a second-order cutoff. In the analytic cancellation problem the available ε⁻¹ times O(ε) wall bound is only O(1). These results block those shortcuts, while leaving cancellation for jointly realized actual zero pairs open."];
"r-d-e-density-route" [id="overview-complete-r-d-e-density-route",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 44</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-density-route",tooltip="Assume the open density statement for every allowed background in every legal degree on fixed ordinary representatives, with convergence against all original compact smooth tests. Keep the admissible finite continuous PL/PS scalar presentation fixed while the positive separately closed backgrounds vary; apply the established fixed-slot and compatible-PS continuity. For actual delta-form backgrounds the zero relation has zero product. On a fixed local domain, pass each term of the finite expression through the established weak-continuity theorem. This kills actual zero presentations for S; subtracting presentations and ordinary locality give descent. This route does not require an exactness certificate for each relation."];
"r-d-e-model-to-general" [id="overview-complete-r-d-e-model-to-general",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 45</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-descent-d-e-model-to-general",tooltip="A new return theorem must cover arbitrary original ordinary germs, including higher joint residue rank and model data not supplied in advance. Higher degrees need treatment of coupled relations with different termwise tails; a common-tail absorption argument only treats its stated subclass. Preserve the original field, all original tests and actual refinements, and choose the ordinary relation neighborhood before S and tests. Even complete cancellation would settle the quadratic supplied normal-three case. These missing general-germ and higher-degree bridges are additional research tasks; no implication from that model theorem alone to REL-ALL is claimed."];
"r-d-e-interface-step" [id="overview-complete-r-d-e-interface-step",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 46</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-descent-d-e-interface-step",tooltip="Even after pure scalar relation descent, specify and prove the variable-coefficient quotient and the differential identities in their object sheaves. Establish the intended enlarged delta-test action, ordinary gluing and naturality for an explicit mapping class; equality on smooth tests alone does not define that extension. Scalar descent would make its curvature expressions presentation independent. Variable PS coefficients, differential operations and enlarged tests ask for separate compatibility statements, so neither low-rank descent nor central cancellation supplies this interface automatically."];
"r-d-e-return-obstructions" [id="overview-complete-r-d-e-return-obstructions",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#9a4b30"><B>Blocks this shortcut 47</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fffef9",URL="#logic-descent-d-e-return-obstructions",tooltip="The proposed shortcut strengthens finite original-unit lifting into a relation-preserving residue-field section, or extends a selected Hensel logarithm continuously over the entire central moment image. The cited obstructions concern these stronger constructions, not every possible route to actual-relation descent. The residue-field example has no rational coefficient-field section and even a displayed pair of units cannot lift with its prescribed equation. The Hensel example has two approaching branches with incompatible limiting norms after any finite unit refinement. A general return theorem must respect these failures rather than assume those stronger lifts."];
"or-d-vanishing" [id="overview-complete-or-d-vanishing",label="OR
Any one sufficient route",fontsize=12,shape=ellipse,fillcolor="#eef4ec",color="#315e50",tooltip="Each incoming deduction has its own full joint premises and hypotheses."];
}
subgraph "cluster-energy-and-equations" {
graph [id="overview-complete-cluster-energy-and-equations",label=<Capacity, energy and source equations>,labelloc=t,labeljust=l,fontsize=19,fontcolor="#31483b",style="rounded",color="#b9c9b5",margin=24];
"n-energy-tail-calculus" [id="overview-complete-n-energy-tail-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Capacity tails and truncation<BR ALIGN="LEFT"/>calculus</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · U01 · U02 · U03 · U04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-tail-calculus",tooltip="In the stated zero-boundary class, no loss is equivalent to t^q C_S({u<−t})→0, and finite σ-energy is equivalent to the weighted capacity integral J_σ(u)<∞. Bounded capacity completion and graded truncation bounds then control curvature, first-order and energy coefficients. Local finiteness is required for the nonpolar product; restricted truncation stages need not be closed."];
"n-energy-global-green" [id="overview-complete-n-energy-global-green",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Bounded global Green exchange</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-global-green",tooltip="For bounded negative classical potentials with compact negative sublevels and finite total curvature masses, Green exchange identifies the two weighted curvature integrals with the integrated cross-energy. This supplies the exchange of the undifferentiated slot needed for global mixed energy."];
"n-energy-mixed-energy" [id="overview-complete-n-energy-mixed-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric mixed energy and Hölder</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-mixed-energy",tooltip="For actual first-energy potentials, B(u₀,…,u_q) is finite and symmetric in every slot. Positive energy matrices give Cauchy–Schwarz, the mixed Hölder inequality has constant one, and the energy root satisfies Minkowski. The associated tester and sharp midpoint estimates control strong discrepancy."];
"n-energy-completion" [id="overview-complete-n-energy-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Complete relative first-energy<BR ALIGN="LEFT"/>space</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E02 · E03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-completion",tooltip="Strongly Cauchy rows have uniform deep tails and global weighted tightness. Their relative Borel limits carry intrinsic currents and critical weighted limits. The completed cone C is complete, with strong convergence exactly equivalent to local truncated outer-capacity convergence together with energy convergence. A common lower barrier is not required for a Cauchy row."];
"n-energy-dual" [id="overview-complete-n-energy-dual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Banach differences and closed<BR ALIGN="LEFT"/>sources</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-dual",tooltip="The actual Borel difference space D_S=C−C is Banach. The curvature functional J(u)(h)=B(h,u,…,u) is injective; its image is norm closed, and the dual distance between sources gives a complete metric inducing the strong topology on C. Closed image does not assert surjectivity onto the dual."];
"n-energy-strong-datum" [id="overview-complete-n-energy-strong-datum",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Literal, strongly continuous datum</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q04 · O04</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-energy-strong-datum",tooltip="The positive Radon measure μ defines ℓ_μ(h)=−∫h dμ literally on every Borel difference in D_S: absolute integrability, independence of relative-null representatives, norm boundedness and strong continuity on C are all required. Fixed completed-source domination is one proved sufficient condition. Norm boundedness alone is the open ED-STRONG question."];
"n-energy-projection" [id="overview-complete-n-energy-projection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Projection and a normal residual</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-projection",tooltip="For a strongly continuous dual datum, maximizing ℓ(v)−e(v)/(q+1) on C gives a unique u=Π(ℓ). Its decomposition ℓ=J(u)+n satisfies n(v)≤0 on C and n(u)=0. The source equation still requires the residual to vanish in the appropriate literal sense."];
"n-energy-probe" [id="overview-complete-n-energy-probe",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>One probe with both test<BR ALIGN="LEFT"/>directions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-probe",tooltip="The strict Laurent geometry supplies a single bounded continuous negative classical ψ₀. For every original compact smooth scalar φ, both ψ₀+ε_φφ and ψ₀−ε_φφ lie in the actual first-energy cone for some ε_φ>0. The same probe works for every extending allowed background."];
"n-energy-defect-zero" [id="overview-complete-n-energy-defect-zero",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Additional compatibility: Ξ=0</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03 · O05</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-energy-defect-zero",tooltip="For the normal pair of a literal strongly continuous positive datum, Ξ=J(Πℓ_μ)(ψ₀)−ℓ_μ(ψ₀)=−n(ψ₀) is nonnegative. Requiring Ξ=0 is the extra compatibility condition. Strong continuity and fixed-source domination do not force this equality."];
"n-energy-source-solution" [id="overview-complete-n-energy-source-solution",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Unique source solution in the<BR ALIGN="LEFT"/>completed cone</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-source-solution",tooltip="Under the literal strong-dual hypotheses, Ξ=0 if and only if μ̂_{Πℓ_μ}=μ, if and only if some v∈C has source μ. Any solution equals Πℓ_μ. More generally, every compact original test error is bounded by ε_φ⁻¹Ξ. This is an exact compatibility criterion, not an assertion that arbitrary data are compatible."];
"n-energy-source-gap" [id="overview-complete-n-energy-source-gap",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Smooth dominated data can have Ξ&gt;0</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N06</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="#logic-node-energy-source-gap",tooltip="In a fixed two-dimensional torus model with q=1, smooth positive densities f_j→1 uniformly can make f_jμ_w leave the entire strong-completion source image, even at a fixed reference admitting every two-sided compact test direction. These data remain literal, strongly continuous and uniformly source dominated. Their zero-boundary Poisson traces fail convexity."];
"n-energy-compatible-classes" [id="overview-complete-n-energy-compatible-classes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Find source conditions from the<BR ALIGN="LEFT"/>data</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O05</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-energy-compatible-classes",tooltip="Find substantial geometric classes of given μ for which strong continuity and Ξ=0 follow from checkable input conditions. A local inverse route needs a specified linearized range, a right inverse with boundary and moment estimates, and preservation of that range by the nonlinear remainder. Assuming an unknown solution would restate the goal."];
"n-energy-linear-form" [id="overview-complete-n-energy-linear-form",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>q=1, faithful part form, diffuse<BR ALIGN="LEFT"/>data</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q05</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-energy-linear-form",tooltip="Take remaining degree q=1, V compactly contained in an ordinary neighborhood inside an affinoid interior, and an allowed background S there. Use the faithful regular strongly local coercive part form of the original smooth core. The datum is finite signed Radon on V∩supp S, with total variation annihilating energy-capacity polar sets."];
"n-energy-linear-dirichlet" [id="overview-complete-n-energy-linear-dirichlet",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Renormalized linear Dirichlet<BR ALIGN="LEFT"/>solution</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q05 · Q06</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-linear-dirichlet",tooltip="Every such finite signed diffuse datum has a unique zero-boundary renormalized solution of D(uS)=μ. Its clippings lie in the part-energy space H; chain, radiation and stability identities hold on the original tests. The solution need not belong to the classical psh cone or the nonlinear strong first-energy cone C."];
"n-energy-domain-representatives" [id="overview-complete-n-energy-domain-representatives",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Extend domains and recover<BR ALIGN="LEFT"/>representatives</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O08</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-energy-domain-representatives",tooltip="Beyond strict Laurent domains, establish barriers, Green exchange, cutoff control and weighted boundary tightness under explicit geometric assumptions. Separately identify subclasses of completed Borel potentials with canonical ambient classical psh representatives, using a proved regularization or detection theorem rather than identifying different quotients by definition."];
"n-energy-singularity-invariants" [id="overview-complete-n-energy-singularity-invariants",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Relative singularity invariants</B></FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-energy-singularity-invariants",tooltip="For explicit potential and background classes, determine which nonpolar masses, no-loss conditions and energy integrability properties survive bounded changes of singularity. Construct the corresponding envelopes and comparison results with specified domains, boundaries and relative null ideals, and study only modifications for which the required current operations are defined."];
"n-energy-green-products" [id="overview-complete-n-energy-green-products",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite-energy Green products</B></FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-energy-green-products",tooltip="Define integrable truncation products for Green currents Dg_Z+δ_Z=ω_Z, with presentation independence, symmetry and comparison to existing smooth, formal and delta-form products. Products involving cycle currents require proper-intersection or replacement hypotheses and their own integrability argument."];
"n-energy-adelic-intersection" [id="overview-complete-n-energy-adelic-intersection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Adelic finite-energy intersection</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R06</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="#logic-node-energy-adelic-intersection",tooltip="Extend the specified continuous local Chern intersections to finite-energy metrics, then prove placewise summability, boundary control and approximation independence for a global pairing compatible with the product formula. Variation, projection and positivity require their stated global geometric hypotheses."];
"n-energy-scalar-chain" [id="overview-complete-n-energy-scalar-chain",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Bounded scalar chain calculus</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">U05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-scalar-chain",tooltip="For a bounded difference f=a−b of actual classical psh functions and a positive separately closed tail current Q, Γ_Q(f) is a positive coefficient-Radon current and smooth scalar compositions satisfy the full original current chain rule. All multipliers are the actual Borel functions."];
"n-energy-level-stieltjes" [id="overview-complete-n-energy-level-stieltjes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Positive levels, coarea and<BR ALIGN="LEFT"/>Stieltjes curvature</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">U05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-level-stieltjes",tooltip="The strict and weak level currents of f are positive and carried by the actual level {f=t}; they need not be closed. Coarea integrates them to Γ_Q(f), and a convex scalar function has a Stieltjes curvature formula retaining every corner atom. Uniform mixed-tail estimates give ordinary-open outer control for the energy capacity attached to f. This energy capacity is distinct from full BT capacity."];
"n-energy-all-power-poles" [id="overview-complete-n-energy-all-power-poles",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>All-power representatives of<BR ALIGN="LEFT"/>prescribed complete poles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">U05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-all-power-poles",tooltip="If an actual negative classical u has compact strict negative sublevels on the stated Laurent domain, logarithmic attenuation and barrier gluing produce a potential with exactly the same poles, canonical no loss, finite global top mass and every positive power energy. The representative has exponential capacity tails and can match −log(1−u)−ε near a prescribed compact set. This does not identify every polar set with a complete pole set."];
"n-energy-radial-shell-test" [id="overview-complete-n-energy-radial-shell-test",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Exact original radial-shell<BR ALIGN="LEFT"/>calibration</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N05</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-energy-radial-shell-test",tooltip="On the original q-dimensional unit polydisc with S=[V], g_T=−min(t,T), t=−log max_i|T_i|, has bounded top current δ_{σ(T)}. Scaling gives explicit energy and capacity formulas. As T tends to infinity, the Gauss points σ(T) tend to the rational origin on all original compact scalar tests."];
"n-energy-critical-shortcuts" [id="overview-complete-n-energy-critical-shortcuts",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Critical limits need more than<BR ALIGN="LEFT"/>bounded energy</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N05</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="#logic-node-energy-critical-shortcuts",tooltip="The normalized shell potentials have e_s=1 and converge to zero in full local truncated capacity, while their critical weighted currents converge to the Dirac mass at the origin. Separately, the logarithmic pole has an integrable lower-current multiplier but D(uN_{q−1})=δ_o and nonpolar top product zero. Thus same-power bounds do not replace strong or uniform-tail control, and multiplier integrability does not replace no loss."];
"n-energy-perron-obstacles" [id="overview-complete-n-energy-perron-obstacles",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Relative Perron envelopes and<BR ALIGN="LEFT"/>obstacle projection</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-perron-obstacles",tooltip="A nonempty family in the completed cone has a relative least upper bound selected by an increasing sequence of finite maxima. Borel upper bounds and a common lower source inequality pass to this envelope. This constructs the greatest cone minorant P(f) for every f∈D_S, with energy-root and curvature estimates. The construction is relative; it supplies neither ambient upper-semicontinuous regularization nor automatic contact orthogonality."];
"n-energy-barrier-maximum" [id="overview-complete-n-energy-barrier-maximum",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Unique constrained barrier<BR ALIGN="LEFT"/>maximizer</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="#logic-node-energy-barrier-maximum",tooltip="For a fixed actual first-energy lower barrier a and finite positive Radon μ that ignores relative outer-capacity null sets and integrates −a, the completed interval [a,0] has a unique maximizer of the functional −e(v)/(q+1)−∫v dμ. Its Euler variational inequality characterizes maximality. The inequality does not assert the unrestricted source equation."];
"n-energy-rooftop-coefficient" [id="overview-complete-n-energy-rooftop-coefficient",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Coefficient-one rooftop energy<BR ALIGN="LEFT"/>fails</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N04</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="#logic-node-energy-rooftop-coefficient",tooltip="In a two-dimensional original torus with q=1, explicit bounded actual obstacles and one smooth strongly positive background violate e(P(U,V))≤e(U)+e(V). The uniform binary coefficient 2 is sharp across the specified background class. This does not make 2 sharp for every fixed S and does not refute literal strong continuity or mixed-energy Hölder constant one."];
"n-energy-dual-shortcuts" [id="overview-complete-n-energy-dual-shortcuts",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Dual and weak-compactness<BR ALIGN="LEFT"/>shortcuts fail</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N12</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="#logic-node-energy-dual-shortcuts",tooltip="In the specified smooth torus model with 1≤q<r, canonical convex-trace evaluation is strongly continuous but is not literal integration on relative Borel classes. Literal positive data can converge in dual norm to this nonliteral functional when domination constants are not uniform. In a different radial-mixture background with n>q, an energy-bounded strongly convergent row has no Banach-weak convergent subnet. These examples preserve the fixed-domination closure theorem and closedness of the source image."];
"n-energy-parameter-cone" [id="overview-complete-n-energy-parameter-cone",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A separate parameter L^(k+1) cone</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q07</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-energy-parameter-cone",tooltip="For an explicitly conormal background R and an actual parameter map s, the new potentials h_c=ψc(s) form a complete L^(k+1)_+(θ) cone, θ=s_*((-ψ)(Dψ)^k∧R). Their mixed currents and energies have exact coefficient-product formulas. This is a new parameter completion with its own boundary interpretation; it is not an identification with the full ambient classical or strong cone."];
"n-energy-parameter-inverse" [id="overview-complete-n-energy-parameter-inverse",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Exact parameter inverse and energy<BR ALIGN="LEFT"/>capacity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q07</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-energy-parameter-inverse",tooltip="For b≥0 in L^((k+1)/k)(θ), h=ψb(s)^(1/k) solves μ_h=b(s)(Dψ)^k∧R uniquely within the parameter cone. Its energy-normalized capacity equals the L^(k+1)(θ) norm of the conditional source density, has local regularity, and has the null ideal of its fixed source measure. The tester family is explicitly different from full classical [0,1] testers."];
"n-energy-radial-inverse" [id="overview-complete-n-energy-radial-inverse",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A compatible radial-flux inverse</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q07</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-energy-radial-inverse",tooltip="For the fixed radial-mixture background of (PO3), nonnegative data with open tail H_ν(t) and nonincreasing e^tH_ν(t) admit the explicit slope A=(e^tH_ν)^(1/q), provided the stated weighted energy integral is finite. The resulting actual potential has no loss and solves the full original source equation. It is unique in the full completed cone; the necessity of the flux condition is asserted for the radial class."];
"n-energy-countable-probe-gap" [id="overview-complete-n-energy-countable-probe-gap",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Countable Radon probes miss full<BR ALIGN="LEFT"/>capacity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N12</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="#logic-node-energy-countable-probe-gap",tooltip="For the allowed coordinate-subtorus background R=[Y] in every n≥q≥1, uncountably many Gauss singletons have uniformly positive full tester capacity. Any countable family of Radon measures misses at least one such singleton. Parameter energy capacities therefore cannot be substituted for full BT capacity. This does not obstruct the single geometry probe for normal defects, test-stage cofinality, or Choquet regularity."];
"n-energy-clamped-projection" [id="overview-complete-n-energy-clamped-projection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Complemented clamped linear range</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q08</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-energy-clamped-projection",tooltip="On a real ball, a bounded right inverse E of normal trace gives P=I−ET from the zero-Dirichlet C^(2,α) space to functions with both boundary traces zero. The Dirichlet inverse yields K and the projection Π onto the clamped Laplacian range. Its complement Q is harmonic, and all harmonic moments characterize the linear range. The infinite-dimensional range condition is explicit."];
"n-energy-clamped-source-graph" [id="overview-complete-n-energy-clamped-source-graph",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A small clamped nonlinear source<BR ALIGN="LEFT"/>graph</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q08</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-energy-clamped-source-graph",tooltip="For the fixed torus background S=β^(n−q)[X], 2≤q≤n, and a protected quadratic reference, the contraction h=C₁⁻¹K(g−N(h)) gives small source data f=g+QN(h(g)). The exact local condition is Qf=QN(h(Πf)). Zero extension adds no sphere mass because both traces vanish. The resulting bounded actual potentials satisfy the source identity on every original test, with a separate negativity budget."];
"n-energy-interface-source-graph" [id="overview-complete-n-energy-interface-source-graph",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A bulk-and-sphere source graph</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q08</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="#logic-node-energy-interface-source-graph",tooltip="For a specified strictly convex reference, small bulk parameters and a prescribed nonpositive C^(1,α) normal trace produce actual source data with an explicit positive sphere term. The density is ∫_ψ^0 σ_(q−1)(A_T+(s/R)I_T) ds. A quadratic reference also permits explicit inversion of a small nonnegative sphere density. General C^(2,α) references permit prescribed trace; the stronger surface-density regularity is not automatic. A fixed interface admits a common enlarged additive ideal."];
"n-energy-moving-interface-gap" [id="overview-complete-n-energy-moving-interface-gap",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Moving interfaces separate the<BR ALIGN="LEFT"/>topologies</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q08</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="#logic-node-energy-moving-interface-gap",tooltip="With q=1 in a fixed smooth torus background and n≥2, moving-sphere potentials converge uniformly and strongly while distinct radii remain separated in the full energy-difference norm. They yield an energy-difference-bounded positive cone functional that is neither strong-continuous nor literal Radon integration. An uncountable family of sphere interfaces also admits no single common principal ideal. None is a counterexample for literal positive Radon data."];
"r-energy-r1-mixed-energy" [id="overview-complete-r-energy-r1-mixed-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 48</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r1-mixed-energy",tooltip="Fix the original field and tests, the strict Laurent domain, and one allowed S extending to a neighborhood of its closure; q=n−p≥1. Every input u_i is an actual negative classical first-energy potential with compact negative sublevels, canonical no loss and finite first energy. Use the Laurent barrier approximants max(u_i,jρ), their finite mixed masses, and the critical weighted convergence supplied by the truncation theorem. The proof applies bounded Green exchange after fixing the other curvature slots, then passes the barrier approximants to obtain full mixed symmetry. The positive energy matrix gives Cauchy–Schwarz and Hölder constant one. Repeated slot exchange gives the tester estimate; the segment second-variation formula gives the midpoint bound. These are joint proof inputs, not a claim that a tail bound alone yields global symmetry."];
"r-energy-r2-completion" [id="overview-complete-r-energy-r2-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 49</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r2-completion",tooltip="Retain the same strict Laurent domain and extending background, and actual first-energy approximating rows. For constructing an unbounded limit, each defining row must be strongly Cauchy: sup_{j,l≥N} I(u_j,u_l)→0. Use bounded capacity completion at every fixed clipping level and the uniform tester/discrepancy estimates; legal weighted currents satisfy a+b≤q+1. Strong Cauchy control, tested against a late fixed row member, gives uniform deep tails and global weighted tightness. Fixed-level capacity limits and vanishing tails define the unbounded coefficients before differentiation. Uniform discrepancy continuity then gives completeness. Energy boundedness plus capacity convergence alone does not supply the critical tail step."];
"r-energy-r3-banach-sources" [id="overview-complete-r-energy-r3-banach-sources",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 50</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r3-banach-sources",tooltip="Form actual Borel differences of the same completed cone C modulo its relative outer-capacity null ideal. Use the energy-difference norm inf{e(a)^(1/d)+e(b)^(1/d): h=a−b}, completed mixed multilinearity and monotone closure. Use the exact curvature norm and the two quantitative comparisons between I(u,v) and ‖J(u)−J(v)‖*. Summable decomposed increments converge as two monotone cone series, proving Banach completeness in actual Borel differences. A norm-Cauchy sequence of sources has bounded energy roots and is strongly Cauchy; completion produces its limiting potential, and curvature continuity identifies the source limit. This proves closed image, not arbitrary-data solvability."];
"r-energy-r4-fixed-domination" [id="overview-complete-r-energy-r4-fixed-domination",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 51</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r4-fixed-domination",tooltip="Keep one fixed strict Laurent geometry and background S. Supply a completed reference potential v∈C and a finite constant M≥0 with 0≤μ≤M μ̂_v as Radon measures on every Borel set. Mixed Hölder proves literal integrability and the norm bound on every difference. Domination transfers the completed tester estimate to ∫|u_j−u| dμ, proving strong L¹ continuity. The fixed dominated interval is also weak-star compact and norm closed. This route supplies strong continuity but does not supply Ξ=0."];
"r-energy-r5-literal-continuity-open" [id="overview-complete-r-energy-r5-literal-continuity-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 52</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r5-literal-continuity-open",tooltip="Fix S and the strict Laurent geometry, and let μ be positive Radon, annihilate the relative null ideal, and define an absolutely integrable norm-bounded literal functional on all of D_S. No fixed-source domination and no additional finite-total-mass assumption is available. Missing: prove ∫|u_j−u| dμ→0 for every strongly convergent row in C, including a general nonzero limit; a qualified ordered-rooftop or finite-minorant estimate is a proposed route. ED-STRONG asks whether literal norm boundedness already implies the continuity needed for the variational datum. It is a separate unresolved route to the same condition supplied by fixed domination. Nonliteral dual counterexamples and varying-background estimates do not settle this fixed-background literal question."];
"r-energy-r6-projection" [id="overview-complete-r-energy-r6-projection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 53</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r6-projection",tooltip="Work on the same complete cone C with the established sharp midpoint estimate and completed energy continuity. The datum belongs to the norm dual and is strongly continuous on C; literal positive data are the source-equation subclass used here. The dual norm bounds the energies of maximizing rows. The midpoint gap makes those rows strongly Cauchy. Completeness gives a limit, and strong continuity passes the datum term. First variations only along segments in C give the polar normal n; they do not assert arbitrary two-sided variations at the optimizer."];
"r-energy-r7-zero-defect-solves" [id="overview-complete-r-energy-r7-zero-defect-solves",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 54</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r7-zero-defect-solves",tooltip="Use the normal pair u=Π(ℓ_μ), n=ℓ_μ−J(u) for the literal positive Radon datum in the fixed geometry. For every original compact smooth φ, both ψ₀±ε_φφ are admissible, and the two probe integrals defining Ξ are finite. Impose the additional equality Ξ=−n(ψ₀)=0. Testing the normal inequality in both probe directions gives |n(φ)|≤ε_φ⁻¹Ξ. Zero defect therefore kills every original scalar test error; literal integration and Radon uniqueness identify μ̂_u=μ. Variational uniqueness identifies every solution with u. The same theorem proves the converse: existence of a source solution forces Ξ=0, so zero defect and solvability are equivalent under these hypotheses."];
"r-energy-r8-nonzero-defect-obstruction" [id="overview-complete-r-energy-r8-nonzero-defect-obstruction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#9a4b30"><B>Blocks this shortcut 55</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r8-nonzero-defect-obstruction",tooltip="Use the fixed q=1 two-dimensional torus background and a bounded actual admissible reference w<0, with finite total source mass, compact strict negative sublevels, canonical no loss, and all two-sided compact test directions. The counterexample data are μ_j=f_jμ_w, with 1≤f_j≤3/2 and f_j→1 uniformly; they remain literal and strongly continuous. A source in the full completed cone would have a convex zero-boundary moment trace solving the prescribed real Poisson equation. The constructed Poisson solution is not convex, so no such source exists. The exact probe equivalence forces Ξ(μ_j)>0. This blocks the proposed inference from strong continuity, domination or smooth positive density to zero defect."];
"r-energy-r9-compatible-input-open" [id="overview-complete-r-energy-r9-compatible-input-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 56</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r9-compatible-input-open",tooltip="The zero-defect criterion is available after the variational optimizer is constructed. Missing: hypotheses on the given measure, geometry and explicitly supplied reference objects that force both strong continuity and zero defect before assuming a solution. For the proposed local inverse route, additionally establish the linearized range, a bounded right inverse with all boundary and harmonic-moment constraints, and preservation of that range by the nonlinear remainder. The exact compatibility criterion locates the remaining task but does not perform it. Existing finite-mode inverse constructions motivate a range-controlled route; smooth positive perturbations alone cannot be used as its hypothesis because the source-gap counterexample rules them out."];
"r-energy-r10-linear-dirichlet" [id="overview-complete-r-energy-r10-linear-dirichlet",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r10-linear-dirichlet",tooltip="The remaining degree is q=1, in arbitrary ambient dimension, and the original smooth core has the stated faithful regular strongly local coercive part-form realization on V∩supp S. The signed Radon datum has finite total variation and its total variation vanishes on energy-capacity polar Borel sets. The solution uses the renormalized zero-boundary class: clipped membership in H, the scalar chain identity and the vanishing radiation tail. Approximate diffuse data by finite-energy nests, solve by the Riesz potential and pass the L¹ and clipping estimates to the transposition limit. The chain and radiation conditions identify every renormalized candidate with that limit. This is an independent linear theorem in H; it provides no implication that the solution lies in the nonlinear positive-potential cone C."];
"r-energy-r11-domain-representatives-open" [id="overview-complete-r-energy-r11-domain-representatives-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 58</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">2 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r11-domain-representatives-open",tooltip="For domain extension, replace the strict Laurent hypotheses by proved barriers, cutoff-error estimates, global Green exchange and uniform weighted boundary tightness; specify which boundary notion is preserved under exhaustion. For classical representatives, supply actual regularization or relative detection linking the Borel capacity class to an ambient classical psh representative, together with its comparison and boundary properties. The existing proofs identify exactly where geometry controls truncation, integration by parts and loss at the boundary. Those are requirements for extension, not consequences of having a negative exhaustion alone. Recovering a classical representative is a second task: curvature quotients and capacity quotients cannot be identified without a theorem."];
"r-energy-r12-green-products-open" [id="overview-complete-r-energy-r12-green-products-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 59</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r12-green-products-open",tooltip="Specify a first-energy class of Green currents satisfying Dg_Z+δ_Z=ω_Z and admissible truncations. Missing: proper-intersection or replacement conditions controlling multiplication along cycles, coefficient integrability, and independence of presentations and truncations. For curvature-generated expressions, separately prove the required relation descent and comparison with the existing smooth, formal and delta-form products. Energy estimates can bound the proposed limiting integrals, while relation descent would address the differential presentation. Neither input alone defines products with cycle currents. The arrow marks the proposed interface to an open Green product theory, not an established implication."];
"r-energy-r13-adelic-open" [id="overview-complete-r-energy-r13-adelic-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 60</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r13-adelic-open",tooltip="Specify the adelic metrized line bundles and retain the geometric and boundary-completion hypotheses of the established continuous local Chern theory. Missing locally: the chosen finite-energy intersection integral and its metric-change formula, with approximation independence. Missing globally: a placewise summable dominating estimate, compatible boundary control and the product formula; global positivity retains its own geometric hypotheses. The local energy calculus is a candidate input for extending continuous local intersection terms. A separate summability argument must assemble them into a global pairing. Local measure positivity does not imply arithmetic nefness, and the Green-product project is not asserted to be a proved prerequisite or a sufficient route to this adelic goal."];
"r-energy-r14-singularities-open" [id="overview-complete-r-energy-r14-singularities-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 61</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r14-singularities-open",tooltip="Specify negative actual potential classes, allowed backgrounds, ordinary domains and boundary conditions; bounded singularity changes mean u−v is locally bounded in the intended comparison class. Missing: combine the capacity-tail estimates with a controlled model singularity and prove stability of the canonical truncation mass under a specified proper geometric modification. The modification must belong to a mapping class in which the required current operations are already defined; retain the relative null ideal instead of identifying it with ambient polarity. The known tail formulas turn no loss and energy integrability into quantitative sublevel estimates. They supply a proposed starting point for singularity invariance, but invariance of nonpolar mass and transport through a modification still require their own stability proof. No arbitrary-current pullback is inferred."];
"r-energy-r15-level-calculus" [id="overview-complete-r-energy-r15-level-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 62</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r15-level-calculus",tooltip="Work on an original ordinary domain, with f=a−b bounded actual classical psh differences and an allowed positive separately closed tail Q of sub-top degree. For Stieltjes curvature, the scalar function is finite convex on an interval containing the local range of f; its second derivative is used as a measure, including its atoms. For uniform outer coarea, a and b are bounded on the same ordinary domain Ω, and Q=T_(S,q−1)(v₁,…,v_(q−1)) is a top-minus-one normalized mixed tail of the same S on Ω; use compact cutoffs, relative CLN estimates and bounded relative quasicontinuity. Smooth convex approximations of the hinge produce positive actual level currents. Fubini and the scalar chain rule give coarea; the hinge representation of a convex function gives Stieltjes curvature with the strict/weak jump correction. Uniform trace bounds and relative quasicontinuity pass the fixed energy measures to an ordinary-open outer energy-capacity bound. Neither level closedness nor raw/outer equality of full BT capacity is inferred."];
"r-energy-r16-pole-representatives" [id="overview-complete-r-energy-r16-pole-representatives",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 63</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r16-pole-representatives",tooltip="Use the original strict Laurent domain and an extending allowed S, with q≥1 and its fixed zero-boundary barrier ρ. The starting actual negative classical u has compact strict negative sublevels; no initial no-loss or finite-energy hypothesis is imposed on u. Choose a prescribed compact H inside the domain and a positive matching tolerance; the construction glues to Aρ on a boundary collar. The attenuation v=−log(1−u) transforms the basic capacity-tail estimate into an exponential tail and hence gives no loss. Gluing v minus the tolerance to a large barrier preserves its exact pole set, supplies finite total boundary mass, and converts the exponential tail into every positive power energy. These are representatives for specified complete pole sets, not a characterization of all polar sets."];
"r-energy-r17-critical-counterexamples" [id="overview-complete-r-energy-r17-critical-counterexamples",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 64</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r17-critical-counterexamples",tooltip="Use the exact original q-dimensional polydisc background S=[V] and its Gauss shell calibration, with q≥1. For the continuity example fix s>0 and set u_T=T^(−s/(q+s))g_T, so e_s(u_T)=1. For the recursive example take the unbounded logarithmic pole u=log max_i|T_i|; its lower multipliers are coefficient-integrable, but it has persistent truncation loss. The scaled shell has critical weighted mass exactly one at σ(T), while local truncated gap capacities tend to zero; this leaves a Dirac limit at the origin. For the logarithmic pole, bounded uncut top products tend to the same Dirac mass but every nonpolar restriction removes it. These constructions disprove the proposed weaker hypotheses; they do not contradict strong critical continuity, strict subcritical continuity, or the no-loss recursion."];
"r-energy-r18-relative-envelopes" [id="overview-complete-r-energy-r18-relative-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 65</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r18-relative-envelopes",tooltip="Use the same strict Laurent geometry, extending allowed S and completed relative Borel cone C; the envelope family is nonempty. For P(f), f is an actual Borel difference in D_S, so a difference decomposition supplies a cone minorant. Any retained upper obstacle is Borel and interpreted relatively, and any common lower source inequality uses a fixed positive Radon measure; no total-mass assumption is needed for that inequality. Select finite maxima whose energies approach the infimum. Strong completeness gives a limit; adjoining any further family member and using ordered energy separation proves least-upper-bound status. Apply this envelope to all cone minorants of f to obtain P(f); difference decompositions and mixed energy give its root and curvature estimates. Exceptional sets may depend on the family member, and no uncountable union of null sets is taken."];
"r-energy-r19-barrier-variational" [id="overview-complete-r-energy-r19-barrier-variational",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 66</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r19-barrier-variational",tooltip="Restrict to the completed order interval above one fixed actual first-energy barrier a and below zero. The datum μ is finite positive Radon, annihilates outer-capacity null sets and satisfies ∫(−a)dμ<∞. All competitors and maximizing rows belong to this constrained interval. Midpoint strictness makes a maximizing row strongly Cauchy. Barrier domination, finite measure and capacity diffuseness give L¹(μ) continuity, so the functional attains its maximum in the interval. First variation gives the Euler inequality and energy separation gives uniqueness. Passing from this constrained inequality to a source equation requires an additional contact or compatibility argument."];
"r-energy-r20-sharp-rooftop" [id="overview-complete-r-energy-r20-sharp-rooftop",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 67</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r20-sharp-rooftop",tooltip="For sharpness use n=2, q=1 on the original torus box, the explicit convex pyramid obstacles u_a,v_a and smooth strongly positive backgrounds S_(δ,ε). Identify the completed relative rooftop with the real convex envelope using the actual trace and energy arguments; do not assume trace injectivity. The constant is universal across these backgrounds; the chosen background may depend on the proposed constant below 2. The root rooftop bound r(P)≤r(U)+r(V) gives the upper coefficient 2. The explicit convex envelope and full original Green calibration concentrate energy along the diagonal, and the ratio tends to 2. A fixed smooth parameter choice already gives an exact positive gap against coefficient one. This rules out that rooftop shortcut without deciding the literal strong-continuity question."];
"r-energy-r21-dual-boundaries" [id="overview-complete-r-energy-r21-dual-boundaries",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 68</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r21-dual-boundaries",tooltip="For nonliteral evaluation use the smooth torus trace model S=β^(r−q)[V] with 1≤q<r, its canonical finite convex traces, and proper-moment fibers of zero full outer capacity. The approximating literal data are μ_ε≤c_ε μ_ψ for one fixed source, but c_ε is not uniformly bounded; they are not members of the nonlinear source image. For nonreflexivity use the different radial-mixture background (PO3), n>q≥1, and its proved pole functional on both Banach realizations. Canonical trace evaluation is strong-continuous, whereas changing a Borel representative at a null Gauss point prevents literal Dirac integration. Smoothing the trace evaluation gives dual-norm convergence of literal data to that nonliteral limit. In the separate radial example, source functionals force any weak limit to equal the strong limit, while the pole functional gives contradictory values. Thus neither unrestricted dual identification nor weak compactness follows from the Banach and strong-completion theorems."];
"r-energy-r22-parameter-calculus" [id="overview-complete-r-energy-r22-parameter-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 69</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r22-parameter-calculus",tooltip="Fix a strict Laurent box, actual unit-moment parameters s and an allowed symmetric middle-positive separately closed current R of degree (P,P), all defined on an ordinary neighborhood of its closure; k=n−P≥1. Require the explicit conormal identities d′s_i∧R=d″s_i∧R=0; for R=Ω_s∧S retain Ω_s throughout instead of assuming the original S is conormal. Use a bounded negative geometric probe ψ with finite ω=(Dψ)^k∧R, θ=s_*((−ψ)ω), and nonnegative coefficient functions in L^(k+1)(θ). Closed-band identities first establish the formulas for bounded parameter coefficients. The geometric probe bounds every lower coefficient on compact sets; Hölder then passes truncated coefficients to the full L^(k+1) cone. Mixed energies become scalar L^d products and yield completeness. Null sets and the unbounded boundary convention belong to this parameter module."];
"r-energy-r23-parameter-inversion" [id="overview-complete-r-energy-r23-parameter-inversion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 70</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r23-parameter-inversion",tooltip="Keep the same conormal R, probe ψ, parameter measure θ and new parameter cone; put d=k+1. For the source inverse require b≥0 in L^(d/k)(θ), with datum b(s)ω. For its capacity use only h_c=ψc(s), c≥0, ||c||_(L^d)≤1; on compact cores the conditional density g_A=d s_*(1_Aω)/dθ is bounded. The exact coefficient formula makes c↦c^k the source map, so c=b^(1/k) gives the inverse and Young equality gives uniqueness within this cone. Hölder duality gives the capacity formula ||g_A||_(L^d); Radon approximation proves local regularity. These conclusions use the printed tester family and do not identify it with full normalized classical capacity."];
"r-energy-r24-radial-inversion" [id="overview-complete-r-energy-r24-radial-inversion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 71</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r24-radial-inversion",tooltip="Fix the original n-dimensional polydisc with n>q≥1 and exactly the integrated radial-shell background S of (PO3), not an arbitrary background. The positive radial datum ν has finite open tails H_ν(t)=ν((t,∞)); e^tH_ν(t) is nonincreasing. Require ∫₀∞ e^(t/q)H_ν(t)^((q+1)/q)dt<∞. For finite total ν, the compatibility condition is equivalently ν≥H_ν(t)dt and the energy condition follows. Invert the flux by A(t)=(e^tH_ν(t))^(1/q) and integrate the slope to obtain the actual potential. Clipped radial calibration and the vanishing terminal flux establish no loss before passing the energy formula. Injectivity of the full source map then proves uniqueness in C, while the asserted necessity of the flux condition remains restricted to radial potentials."];
"r-energy-r25-capacity-null-separation" [id="overview-complete-r-energy-r25-capacity-null-separation",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 72</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r25-capacity-null-separation",tooltip="For the counterexample choose the allowed torus-box background R=[Y], where Y is the q-dimensional coordinate subtorus and n≥q≥1. Use the full original [0,1] tester h_a=(2L)⁻¹ max_i|t_i−a_i| at every Gauss point x_a; its top measure is L^(−q)δ_(x_a). To compare with parameter energy capacity choose the empty parameter tuple and any countable family of allowed probes. The fixed compact Gauss set is uncountable, while countably many Radon measures have only countably many atoms there. Choose a missed point; its full capacity remains at least L^(−q). The exact parameter null-ideal formula makes the same singleton null for each chosen energy capacity. This proves strict separation of the capacities without invalidating the single-probe normal-defect criterion."];
"r-energy-r26-clamped-graph" [id="overview-complete-r-energy-r26-clamped-graph",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 73</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r26-clamped-graph",tooltip="Use 0<α<1, a real ball and the fixed original torus background S=β^(n−q)[X] with 2≤q≤n; the known negative reference is quadratic on a larger protected neighborhood. Let C₁=binom(n−1,q−1), N(h)=σ_q(I+D²h)−binom(n,q)−C₁Δh, and choose the small radius so ||K||Lip(N)/C₁≤1/2. Take g in the clamped linear range with the stated norm budget, retain small Hessians and impose a separate bound by half the negative reference margin. The projected contraction solves for h without assuming that the full nonlinear residual belongs to the linear range. Applying the Laplacian yields the exact graph f=g+QN(h(g)). Both zero traces make the extension C¹,¹ without sphere mass. Local convex smoothing, bounded Hessian convergence and the original BT continuity estimate transfer the equality to every original test."];
"r-energy-r27-interface-graph" [id="overview-complete-r-energy-r27-interface-graph",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 74</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r27-interface-graph",tooltip="For a nonquadratic reference fix a known C^(2,α) profile v with D²v≥cI on the protected ball, the corresponding uniformly elliptic Dirichlet inverse, and its own clamped projections K_v,Π_v,Q_v. Choose small bulk parameter g in the clamped range and prescribed ψ≤0 in C^(1,α) on the sphere; the boundary lift and contraction satisfy the printed common norm and negativity budgets. The explicit inversion from a prescribed C^(1,α) sphere density is claimed only for the quadratic reference; general C^(2,α) tangential coefficients need not have that regularity. Replace the zero normal trace by Eψ and run the projected contraction for the specified reference. Convex gluing creates the positive normal Hessian jump; a boundary-layer argument gives the exact integral sphere density rather than discarding the interface mass. The full original source has the factor q!(n−q)! on both bulk and sphere terms. A larger anchor controls both signs of fixed-interface variations in the additive ideal."];
"r-energy-r28-moving-interfaces" [id="overview-complete-r-energy-r28-moving-interfaces",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 75</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r28-moving-interfaces",tooltip="For the topology example set q=1 and n≥2 in the fixed smooth torus background; independently use the explicit linear sphere-source formula, not the q≥2 contraction theorem. Choose radii in a compact interval inside the quadratic patch and one common small positive amplitude preserving negativity. Energy-difference lower bounds take the infimum over all decompositions in the full completed cone; the common-ideal obstruction uses the entire uncountable radius family. The linear sphere-source formula gives an exact discrepancy tending to zero with the radius. Positive curvature on disjoint spheres forces every energy-difference decomposition to have a fixed positive size. Testing against the union of a countable converging sequence of spheres constructs a bounded nonliteral dual that fails strong continuity. A single Radon source cannot charge uncountably many disjoint sphere sets on one compact core, so no common principal ideal covers every radius."];
"r-energy-r29-model-source-extension" [id="overview-complete-r-energy-r29-model-source-extension",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 76</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r29-model-source-extension",tooltip="To go beyond the specified toric smooth backgrounds, identify an original linearized range with its boundary and moment constraints for the proposed new reference. Prove a bounded right inverse and estimates preserving that range under the nonlinear remainder; where interfaces occur, derive their original source measures and matching conditions. Verify literal strong continuity and zero normal defect for the resulting input class; the existing model graphs do not make these universal. The constructive graphs show how an explicit complemented range and controlled boundary terms can produce compatible data. Extending their method requires these new range, inverse and interface theorems. The model existence statements do not settle general SOURCE-COMPAT or permit silently adding sphere mass to an unchanged datum."];
}
subgraph "cluster-cross-branch-connections" {
graph [id="overview-complete-cluster-cross-branch-connections",label=<Connections between the proof branches>,labelloc=t,labeljust=l,fontsize=19,fontcolor="#31483b",style="rounded",color="#b9c9b5",margin=24];
"n-bridge-degree-one-action" [id="overview-complete-n-bridge-degree-one-action",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Available degree-one action and<BR ALIGN="LEFT"/>full Leibniz rule</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="#logic-node-bridge-degree-one-action",tooltip="Use the established R6 input: every actual delta-form of total bidegree (1,1) acts on every allowed background S of degree p<n, intrinsically on all original tests. Its agreement with PS multiplication and the full PS Leibniz rule give M_S(d′β)=d′(β∧S) and M_S(d″γ)=d″(γ∧S). This is an available input, not an additional open conjecture or a higher-degree arbitrary-current product."];
"r-bridge-capacity-to-energy" [id="overview-complete-r-bridge-capacity-to-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 77</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">4 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-cross-branch-connections-bridge-capacity-to-energy",tooltip="Fix a strict original Laurent domain V and one allowed background S extending to a neighborhood of its closure; the remaining degree is q=n−p≥1. Use the analytic Laurent-collar and affinoid capacity-localization results, the original coefficient controls and countably cofinal compact test stages, with the full classical normalized tester family on the stated domain. The actual negative classical power classes have compact strict negative sublevel closures, canonical no loss and the displayed finite power energy where those conditions are required. Local coefficient finiteness is required when first defining the nonpolar product. For the completed bounded calculus use actual Borel limits in ordinary-open outer capacity. Keep the coefficient budget a+b≤q+σ and distinguish closed locally finite limits from individual restricted truncation stages. The bounded weighted recursion, relative coefficient estimates, quasicontinuity and boundary comparison supply the local multiplier and sublevel estimates. The analytic collar and capacity-localization arguments put them on the required Laurent domain. These inputs support the no-loss criterion, capacity-energy equivalence, graded tail bounds and bounded Borel completion used in the energy branch. The proof uses outer capacity and does not require general relative raw/outer equality on arbitrary Borel sets."];
"r-bridge-bounded-scalar-chain" [id="overview-complete-r-bridge-bounded-scalar-chain",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 78</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-cross-branch-connections-bridge-bounded-scalar-chain",tooltip="Work on one original ordinary domain with a symmetric middle-positive separately closed background Q of degree (p,p), where p<n. Each scalar difference f=a−b has actual locally bounded classical psh summands; use finitely many such presentations on every compact test support. Retain finite polarization, original coefficient-Radon control, and the smooth convex decomposition of scalar functions on an interval containing the local range. All multipliers use the actual Borel values. Simultaneous bounded regularizations and the weighted theorem pass the three-term energy identity to actual differences. Positivity gives coefficient-Radon control, and polarization treats cross terms. A finite difference of convex coordinatewise-increasing compositions passes every weighted term of the smooth chain identities. The resulting scalar calculus is intrinsic and needs no general analytic relation-descent conjecture."];
"r-bridge-bounded-transgression" [id="overview-complete-r-bridge-bounded-transgression",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 79</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">3 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-cross-branch-connections-bridge-bounded-transgression",tooltip="Use a finite real quadratic presentation P=Σcν[hν][kν], with constant cν∈R, whose continuous PL/PS scalars are admissible on one ordinary representative over the original field; retain the full actual delta curvatures and closed-cell face data. The quadratic action uses an allowed original S of degree 0≤p≤n−2. The separately established degree-one action and full derivative compatibility are explicit joint inputs; no higher-degree arbitrary-current multiplication is assumed. Retain α_P=A₀−Z_P with the complete singular term A₀=½D_δ(Σcνhνkν), all original compact smooth complementary tests and every actual refinement. When P is an actual zero, its transgression class lies in the actual Aeppli quotient. Bounded products define the finite signed quadratic action, while the degree-one operation identifies the action of each scalar-curvature primitive. Full derivative compatibility and the intrinsic Leibniz identity give A_S(P)=D M_S(α_P)=−D M_S(Z_P). This is the bridge to the quadratic certificate arguments; it does not construct an exact certificate for every actual zero."];
"r-bridge-descent-energy-green" [id="overview-complete-r-bridge-descent-energy-green",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 80</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">4 additional hypotheses apply</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-cross-branch-connections-bridge-descent-energy-green",tooltip="Specify Green currents g_Z satisfying Dg_Z+δ_Z=ω_Z, their permitted cycle classes and an actual first-energy truncation class on the intended ordinary domains. General actual-relation descent is itself still open. In a curvature-generated expression it would make the differential presentation intrinsic; it would not define multiplication by a cycle current on its own. Still prove proper-intersection or replacement hypotheses, coefficient integrability, and independence of admissible presentations and truncations, with all relevant degree and boundary conditions. Still establish the required mapping properties, Green symmetry and comparison with existing smooth, formal and delta-form products on their common domains. The two branches have different roles in the proposed construction: relation descent addresses algebraic presentation independence, while capacity tails and mixed energy control limiting integrals. They meet at the Green-product problem, but cycle multiplication, intersection, integrability and comparison remain additional mathematical interfaces. This connection is a research route, not an established implication to finite-energy intersection theory."];
}
"or-d-vanishing" -> "n-d-vanishing" [color="#315e50"];
"n-core-regularization" -> "r-core-r1-ordered-construction" [id="overview-complete-input-core-r1-ordered-construction-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r1-ordered-construction" [id="overview-complete-input-core-r1-ordered-construction-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r1-ordered-construction" -> "n-core-ordered-products" [id="overview-complete-output-core-r1-ordered-construction",style="dashed",color="#64757c",arrowhead="normal",];
"n-core-regularization" -> "r-core-r2-collar-and-traces" [id="overview-complete-input-core-r2-collar-and-traces-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r2-collar-and-traces" [id="overview-complete-input-core-r2-collar-and-traces-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
