digraph "descent-descent-central" {
graph [id="svg-descent-descent-central",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-d-model-input" [id="descent-descent-central-n-d-model-input",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A supplied normal-three actual<BR ALIGN="LEFT"/>zero</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G09 · G10 · G11</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#def:normal-three-model",tooltip="A supplied smooth integral normal-three model germ (Y,y) over the original field, with unchanged value group and residue transcendence degree three, carries the fixed finite closed-cell PL/PS quadratic actual zero. The supplied data include original-field lifting, complete-source comparison on a smooth projective SNC model, all labelled Gauss families and lower strata, and ordinary convergence uniform in the angular parameter."];
"n-d-punctured" [id="descent-descent-central-n-d-punctured",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Action vanishes off the center</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G07 · G09 · G10 · G11</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/2ef0bcff2d19/#thm:r13-punctured-quadratic-action",tooltip="In that supplied model, an ordinary U chosen for P before S and tests satisfies A_S(P)|_(U minus {y}) = 0. The proof covers actual ordinary points through top-cone neighborhoods, marked-curve tubes, completed surface core fibers and the rank-two complement. It uses current locality, not a single global primitive on the puncture."];
"n-d-point-residual" [id="descent-descent-central-n-d-point-residual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Only a top-degree Dirac remains</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G11</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/2ef0bcff2d19/#lem:r13-point-supported-order-zero",tooltip="The finite signed BT action is coefficient-Radon and separately closed. In the supplied threefold, punctured vanishing therefore gives zero everywhere for p = 0, and A_S(P) = c_S(P) δ_y for p = 1. The scalar is independent of the compact cutoff equal to one near y."];
"n-d-protected-tangent" [id="descent-descent-central-n-d-protected-tangent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Protected tangents retain the<BR ALIGN="LEFT"/>wall terms</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G12 · G13</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/9f7cae18bde8/#thm:r13-protected-quadratic-trace-growth",tooltip="For the same degree-one S and a protected actual presentation, the full-fiber transpose T has critical trace mass O(r²) and positive closed conic tangent limits T₀. The paired leading PL energy Z₀ satisfies an all-face O(r) error estimate. Compatible-PS continuity retains wall mass when passing its pairing to a tangent; ordinary smooth weak convergence alone would not suffice."];
"n-d-spherical-residual" [id="descent-descent-central-n-d-spherical-residual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>An exact spherical residual<BR ALIGN="LEFT"/>formula</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G12 · G13 · G14</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/35290a2e4db3/#thm:r13-spherical-realized-residual",tooltip="For every critical tangent jointly realized by this P and S, c_S(P) equals Σcν(∫hν^[1]kν^[1] dσ − ∫d_S hν^[1] ⊗ d_S kν^[1] : dM). The finite positive semidefinite angular matrix measure satisfies Mθ = 0, div_S M = 0 and σ = tr M. The value is tangent independent. Classification of real cones does not show that an arbitrary real cone is analytically realized."];
"n-d-critical-cancellation" [id="descent-descent-central-n-d-critical-cancellation",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>The realized spherical pairing<BR ALIGN="LEFT"/>vanishes</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G14 · O07</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#conj:critical",tooltip="The missing assertion is cancellation for every actual jointly realized pair (Z₀,M) in this supplied-model category. It is known for zero tangent density, globally linear first jets, and a leading tensor with an actual full-exact identity near the whole protected central fiber; the established potential and W_loc subclasses are also covered. No argument yet covers all allowed S and all actual zero relations."];
"n-d-model-descent" [id="descent-descent-central-n-d-model-descent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Full quadratic descent in this<BR ALIGN="LEFT"/>model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G11 · O07</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#thm:punctured",tooltip="If the open cancellation assertion is proved throughout the supplied normal-three class, its quadratic actual zeros have zero action on U in both legal degrees p = 0 and p = 1. This is a specific conditional target. It neither returns the model to every original germ nor settles higher coupled or variable-coefficient relations."];
"n-d-shortcut-limits" [id="descent-descent-central-n-d-shortcut-limits",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Why shortcut arguments stop</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G03 · G04 · N07 · N08 · N09 · N10 · N11</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/3a68e09b5f7a/#sec:r18-intrinsic-normal-current",tooltip="Normal-current constructions retain a harmonic boundary defect; scalar harmonic identifications do not supply a missing continuous potential. N07 excludes an automatic continuous smooth-form double primitive. N08 gives a real Killing-gluing obstruction, N09 retains graph Hessian-wall drift, N10 obstructs stronger residue-section and whole-central-fiber Hensel lifts, and N11 shows that O(r²) growth can retain a point residual. These examples do not refute the actual analytic-zero conjecture."];
"r-d-e-puncture" [id="descent-descent-central-r-d-e-puncture",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-puncture",tooltip="Retain every supplied original-field model/source comparison, labelled cone, calibration and completed core fiber in the model hypothesis. P is the fixed admissible quadratic actual zero; S is any allowed original background with p = 0 or p = 1 on the supplied threefold. Choose the ordinary U for P before S and compact tests; the cover is a cover of actual ordinary points. Top interiors have ambient strain neighborhoods, positive two-faces use completed marked-curve data, and rays use ordinary neighborhoods of completed surface core fibers. Outside the fixed old source, the original scalar tuple has rank at most two. A finite partition of each compact test and ordinary current locality assemble the punctured equality."];
"n-d-model-input" -> "r-d-e-puncture" [id="descent-descent-central-input-d-e-puncture-d-model-input",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-puncture" -> "n-d-punctured" [id="descent-descent-central-output-d-e-puncture",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-dirac" [id="descent-descent-central-r-d-e-dirac",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-dirac",tooltip="The current is the finite signed bounded BT action of the specified continuous PL/PS quadratic presentation, so it is coefficient-Radon and separately d′- and d″-closed. The ambient analytic dimension is three and p is 0 or 1. Punctured vanishing puts the support at y. A separately closed order-zero point current vanishes below top bidegree; in top degree it is a scalar Dirac measure. Thus p = 0 is complete, while p = 1 has precisely c_S(P)δ_y left."];
"n-d-punctured" -> "r-d-e-dirac" [id="descent-descent-central-input-d-e-dirac-d-punctured",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-dirac" -> "n-d-point-residual" [id="descent-descent-central-output-d-e-dirac",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-protected" [id="descent-descent-central-r-d-e-protected",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-protected",tooltip="Use the same actual quadratic presentation and an allowed degree-one background S. Supply a finite protected actual moment map t containing every scalar, with t(y) = 0 and the whole inverse image of every compact target support compact in U. Retain the complete finite closed-cell scalar jets and their tangential values on every face. Transposing original tests through the protected whole fiber gives a positive separately closed real current. The critical monotonicity estimate supplies conic tangent subsequences; the paired first-jet estimate gives O(r) coefficient error, and the compatible-PS approximation controls the wall terms for the tangent pairing."];
"n-d-model-input" -> "r-d-e-protected" [id="descent-descent-central-input-d-e-protected-d-model-input",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-protected" -> "n-d-protected-tangent" [id="descent-descent-central-output-d-e-protected",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-sphere" [id="descent-descent-central-r-d-e-sphere",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-sphere",tooltip="The residual, transpose, leading tensor and tangent come from the same P, S and protected actual presentation; take p = 1. Use the full paired tensor Z₀ and canonical tangential face values, with the complete protected inverse image retained in every shrinking cutoff. A cutoff Hessian has size O(δ⁻²), while trace mass is O(δ²) and the leading-energy error is O(δ), so the replacement error tends to zero. Compatible-PS continuity passes the remaining pairing to T₀. Radial and tangential decomposition then gives the spherical formula and D(Z₀ ∧ T₀) = −c_S(P)δ₀."];
"n-d-point-residual" -> "r-d-e-sphere" [id="descent-descent-central-input-d-e-sphere-d-point-residual",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-d-protected-tangent" -> "r-d-e-sphere" [id="descent-descent-central-input-d-e-sphere-d-protected-tangent",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-sphere" -> "n-d-spherical-residual" [id="descent-descent-central-output-d-e-sphere",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-model-close" [id="descent-descent-central-r-d-e-model-close",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 05</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-model-close",tooltip="Assume the still-open cancellation statement for every admissible quadratic actual zero and every degree-one S in this supplied-model category, with their common protected presentations. Retain the already proved p = 0 case and punctured vanishing from the point-residual theorem. The formula identifies the only remaining coefficient c_S(P) with the hypothesized zero pairing. This removes the central Dirac in degree p = 1; the degree p = 0 action already vanishes. The implication is proved, but its universal cancellation premise remains open."];
"n-d-spherical-residual" -> "r-d-e-model-close" [id="descent-descent-central-input-d-e-model-close-d-spherical-residual",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-d-critical-cancellation" -> "r-d-e-model-close" [id="descent-descent-central-input-d-e-model-close-d-critical-cancellation",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-model-close" -> "n-d-model-descent" [id="descent-descent-central-output-d-e-model-close",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-critical-obstructions" [id="descent-descent-central-r-d-e-critical-obstructions",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#9a4b30"><B>Blocks this shortcut 06</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fffef9",URL="#logic-descent-d-e-critical-obstructions",tooltip="The shortcut under examination uses local strain primitives, graph pullback or critical O(r²) mass alone, without additional actual-zero realization data. The real Killing example is not separately closed; the critical-mass example is not an actual analytic-zero presentation. Their counterexamples have precisely these restricted targets. Local primitives can fail to glue, pulling a primitive through a PL graph retains a Hessian-wall measure, and O(r²) mass can survive a second-order cutoff. In the analytic cancellation problem the available ε⁻¹ times O(ε) wall bound is only O(1). These results block those shortcuts, while leaving cancellation for jointly realized actual zero pairs open."];
"n-d-shortcut-limits" -> "r-d-e-critical-obstructions" [id="descent-descent-central-input-d-e-critical-obstructions-d-shortcut-limits",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-critical-obstructions" -> "n-d-critical-cancellation" [id="descent-descent-central-output-d-e-critical-obstructions",style="solid",color="#9a4b30",arrowhead="tee",];
}
