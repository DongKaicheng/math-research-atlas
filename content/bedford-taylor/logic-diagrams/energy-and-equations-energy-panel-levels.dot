digraph "energy-and-equations-energy-panel-levels" {
graph [id="svg-energy-and-equations-energy-panel-levels",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-energy-tail-calculus" [id="energy-and-equations-energy-panel-levels-n-energy-tail-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Capacity tails and truncation<BR ALIGN="LEFT"/>calculus</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · U01 · U02 · U03 · U04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:analytic-estimates",tooltip="In the stated zero-boundary class, no loss is equivalent to t^q C_S({u<−t})→0, and finite σ-energy is equivalent to the weighted capacity integral J_σ(u)<∞. Bounded capacity completion and graded truncation bounds then control curvature, first-order and energy coefficients. Local finiteness is required for the nonpolar product; restricted truncation stages need not be closed."];
"n-energy-scalar-chain" [id="energy-and-equations-energy-panel-levels-n-energy-scalar-chain",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Bounded scalar chain calculus</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">U05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/dee638e93809/#lem:r11-bounded-difference-chain",tooltip="For a bounded difference f=a−b of actual classical psh functions and a positive separately closed tail current Q, Γ_Q(f) is a positive coefficient-Radon current and smooth scalar compositions satisfy the full original current chain rule. All multipliers are the actual Borel functions."];
"n-energy-level-stieltjes" [id="energy-and-equations-energy-panel-levels-n-energy-level-stieltjes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Positive levels, coarea and<BR ALIGN="LEFT"/>Stieltjes curvature</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">U05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/dee638e93809/#thm:r11-positive-level-current",tooltip="The strict and weak level currents of f are positive and carried by the actual level {f=t}; they need not be closed. Coarea integrates them to Γ_Q(f), and a convex scalar function has a Stieltjes curvature formula retaining every corner atom. Uniform mixed-tail estimates give ordinary-open outer control for the energy capacity attached to f. This energy capacity is distinct from full BT capacity."];
"n-energy-all-power-poles" [id="energy-and-equations-energy-panel-levels-n-energy-all-power-poles",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>All-power representatives of<BR ALIGN="LEFT"/>prescribed complete poles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">U05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/27b4c3bad6a0/#lem:r11-logarithmic-attenuation",tooltip="If an actual negative classical u has compact strict negative sublevels on the stated Laurent domain, logarithmic attenuation and barrier gluing produce a potential with exactly the same poles, canonical no loss, finite global top mass and every positive power energy. The representative has exponential capacity tails and can match −log(1−u)−ε near a prescribed compact set. This does not identify every polar set with a complete pole set."];
"n-energy-radial-shell-test" [id="energy-and-equations-energy-panel-levels-n-energy-radial-shell-test",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Exact original radial-shell<BR ALIGN="LEFT"/>calibration</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N05</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/e5cfb0148dc0/#prop:r11-power-energy-continuity-failure",tooltip="On the original q-dimensional unit polydisc with S=[V], g_T=−min(t,T), t=−log max_i|T_i|, has bounded top current δ_{σ(T)}. Scaling gives explicit energy and capacity formulas. As T tends to infinity, the Gauss points σ(T) tend to the rational origin on all original compact scalar tests."];
"n-energy-critical-shortcuts" [id="energy-and-equations-energy-panel-levels-n-energy-critical-shortcuts",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Critical limits need more than<BR ALIGN="LEFT"/>bounded energy</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N05</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/e5cfb0148dc0/#prop:r11-power-energy-continuity-failure",tooltip="The normalized shell potentials have e_s=1 and converge to zero in full local truncated capacity, while their critical weighted currents converge to the Dirac mass at the origin. Separately, the logarithmic pole has an integrable lower-current multiplier but D(uN_{q−1})=δ_o and nonpolar top product zero. Thus same-power bounds do not replace strong or uniform-tail control, and multiplier integrability does not replace no loss."];
"r-energy-r15-level-calculus" [id="energy-and-equations-energy-panel-levels-r-energy-r15-level-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r15-level-calculus",tooltip="Work on an original ordinary domain, with f=a−b bounded actual classical psh differences and an allowed positive separately closed tail Q of sub-top degree. For Stieltjes curvature, the scalar function is finite convex on an interval containing the local range of f; its second derivative is used as a measure, including its atoms. For uniform outer coarea, a and b are bounded on the same ordinary domain Ω, and Q=T_(S,q−1)(v₁,…,v_(q−1)) is a top-minus-one normalized mixed tail of the same S on Ω; use compact cutoffs, relative CLN estimates and bounded relative quasicontinuity. Smooth convex approximations of the hinge produce positive actual level currents. Fubini and the scalar chain rule give coarea; the hinge representation of a convex function gives Stieltjes curvature with the strict/weak jump correction. Uniform trace bounds and relative quasicontinuity pass the fixed energy measures to an ordinary-open outer energy-capacity bound. Neither level closedness nor raw/outer equality of full BT capacity is inferred."];
"n-energy-scalar-chain" -> "r-energy-r15-level-calculus" [id="energy-and-equations-energy-panel-levels-input-energy-r15-level-calculus-energy-scalar-chain",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r15-level-calculus" -> "n-energy-level-stieltjes" [id="energy-and-equations-energy-panel-levels-output-energy-r15-level-calculus",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r16-pole-representatives" [id="energy-and-equations-energy-panel-levels-r-energy-r16-pole-representatives",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r16-pole-representatives",tooltip="Use the original strict Laurent domain and an extending allowed S, with q≥1 and its fixed zero-boundary barrier ρ. The starting actual negative classical u has compact strict negative sublevels; no initial no-loss or finite-energy hypothesis is imposed on u. Choose a prescribed compact H inside the domain and a positive matching tolerance; the construction glues to Aρ on a boundary collar. The attenuation v=−log(1−u) transforms the basic capacity-tail estimate into an exponential tail and hence gives no loss. Gluing v minus the tolerance to a large barrier preserves its exact pole set, supplies finite total boundary mass, and converts the exponential tail into every positive power energy. These are representatives for specified complete pole sets, not a characterization of all polar sets."];
"n-energy-tail-calculus" -> "r-energy-r16-pole-representatives" [id="energy-and-equations-energy-panel-levels-input-energy-r16-pole-representatives-energy-tail-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r16-pole-representatives" -> "n-energy-all-power-poles" [id="energy-and-equations-energy-panel-levels-output-energy-r16-pole-representatives",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r17-critical-counterexamples" [id="energy-and-equations-energy-panel-levels-r-energy-r17-critical-counterexamples",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r17-critical-counterexamples",tooltip="Use the exact original q-dimensional polydisc background S=[V] and its Gauss shell calibration, with q≥1. For the continuity example fix s>0 and set u_T=T^(−s/(q+s))g_T, so e_s(u_T)=1. For the recursive example take the unbounded logarithmic pole u=log max_i|T_i|; its lower multipliers are coefficient-integrable, but it has persistent truncation loss. The scaled shell has critical weighted mass exactly one at σ(T), while local truncated gap capacities tend to zero; this leaves a Dirac limit at the origin. For the logarithmic pole, bounded uncut top products tend to the same Dirac mass but every nonpolar restriction removes it. These constructions disprove the proposed weaker hypotheses; they do not contradict strong critical continuity, strict subcritical continuity, or the no-loss recursion."];
"n-energy-radial-shell-test" -> "r-energy-r17-critical-counterexamples" [id="energy-and-equations-energy-panel-levels-input-energy-r17-critical-counterexamples-energy-radial-shell-test",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r17-critical-counterexamples" -> "n-energy-critical-shortcuts" [id="energy-and-equations-energy-panel-levels-output-energy-r17-critical-counterexamples",style="dashed",color="#64757c",arrowhead="normal",];
}
