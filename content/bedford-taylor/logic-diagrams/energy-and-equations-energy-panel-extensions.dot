digraph "energy-and-equations-energy-panel-extensions" {
graph [id="svg-energy-and-equations-energy-panel-extensions",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-energy-tail-calculus" [id="energy-and-equations-energy-panel-extensions-n-energy-tail-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Capacity tails and truncation<BR ALIGN="LEFT"/>calculus</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · U01 · U02 · U03 · U04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:analytic-estimates",tooltip="In the stated zero-boundary class, no loss is equivalent to t^q C_S({u<−t})→0, and finite σ-energy is equivalent to the weighted capacity integral J_σ(u)<∞. Bounded capacity completion and graded truncation bounds then control curvature, first-order and energy coefficients. Local finiteness is required for the nonpolar product; restricted truncation stages need not be closed."];
"n-energy-mixed-energy" [id="energy-and-equations-energy-panel-extensions-n-energy-mixed-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric mixed energy and<BR ALIGN="LEFT"/>Hölder</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:first-mixed-energy",tooltip="For actual first-energy potentials, B(u₀,…,u_q) is finite and symmetric in every slot. Positive energy matrices give Cauchy–Schwarz, the mixed Hölder inequality has constant one, and the energy root satisfies Minkowski. The associated tester and sharp midpoint estimates control strong discrepancy."];
"n-energy-completion" [id="energy-and-equations-energy-panel-extensions-n-energy-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Complete relative first-energy<BR ALIGN="LEFT"/>space</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E02 · E03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:r11-strong-cauchy-uniform-tails",tooltip="Strongly Cauchy rows have uniform deep tails and global weighted tightness. Their relative Borel limits carry intrinsic currents and critical weighted limits. The completed cone C is complete, with strong convergence exactly equivalent to local truncated outer-capacity convergence together with energy convergence. A common lower barrier is not required for a Cauchy row."];
"n-energy-linear-form" [id="energy-and-equations-energy-panel-extensions-n-energy-linear-form",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>q=1, faithful part form, diffuse<BR ALIGN="LEFT"/>data</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q05</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#sec:linear-dirichlet",tooltip="Take remaining degree q=1, V compactly contained in an ordinary neighborhood inside an affinoid interior, and an allowed background S there. Use the faithful regular strongly local coercive part form of the original smooth core. The datum is finite signed Radon on V∩supp S, with total variation annihilating energy-capacity polar sets."];
"n-energy-linear-dirichlet" [id="energy-and-equations-energy-panel-extensions-n-energy-linear-dirichlet",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Renormalized linear Dirichlet<BR ALIGN="LEFT"/>solution</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q05 · Q06</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:linear-transposition",tooltip="Every such finite signed diffuse datum has a unique zero-boundary renormalized solution of D(uS)=μ. Its clippings lie in the part-energy space H; chain, radiation and stability identities hold on the original tests. The solution need not belong to the classical psh cone or the nonlinear strong first-energy cone C."];
"n-energy-domain-representatives" [id="energy-and-equations-energy-panel-extensions-n-energy-domain-representatives",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Extend domains and recover<BR ALIGN="LEFT"/>representatives</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O08</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#problem:domains",tooltip="Beyond strict Laurent domains, establish barriers, Green exchange, cutoff control and weighted boundary tightness under explicit geometric assumptions. Separately identify subclasses of completed Borel potentials with canonical ambient classical psh representatives, using a proved regularization or detection theorem rather than identifying different quotients by definition."];
"n-energy-singularity-invariants" [id="energy-and-equations-energy-panel-extensions-n-energy-singularity-invariants",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Relative singularity invariants</B></FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#problem:singularities",tooltip="For explicit potential and background classes, determine which nonpolar masses, no-loss conditions and energy integrability properties survive bounded changes of singularity. Construct the corresponding envelopes and comparison results with specified domains, boundaries and relative null ideals, and study only modifications for which the required current operations are defined."];
"n-energy-green-products" [id="energy-and-equations-energy-panel-extensions-n-energy-green-products",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite-energy Green products</B></FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#problem:green",tooltip="Define integrable truncation products for Green currents Dg_Z+δ_Z=ω_Z, with presentation independence, symmetry and comparison to existing smooth, formal and delta-form products. Products involving cycle currents require proper-intersection or replacement hypotheses and their own integrability argument."];
"n-energy-adelic-intersection" [id="energy-and-equations-energy-panel-extensions-n-energy-adelic-intersection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Adelic finite-energy<BR ALIGN="LEFT"/>intersection</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R06</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#problem:adelic",tooltip="Extend the specified continuous local Chern intersections to finite-energy metrics, then prove placewise summability, boundary control and approximation independence for a global pairing compatible with the product formula. Variation, projection and positivity require their stated global geometric hypotheses."];
"r-energy-r10-linear-dirichlet" [id="energy-and-equations-energy-panel-extensions-r-energy-r10-linear-dirichlet",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r10-linear-dirichlet",tooltip="The remaining degree is q=1, in arbitrary ambient dimension, and the original smooth core has the stated faithful regular strongly local coercive part-form realization on V∩supp S. The signed Radon datum has finite total variation and its total variation vanishes on energy-capacity polar Borel sets. The solution uses the renormalized zero-boundary class: clipped membership in H, the scalar chain identity and the vanishing radiation tail. Approximate diffuse data by finite-energy nests, solve by the Riesz potential and pass the L¹ and clipping estimates to the transposition limit. The chain and radiation conditions identify every renormalized candidate with that limit. This is an independent linear theorem in H; it provides no implication that the solution lies in the nonlinear positive-potential cone C."];
"n-energy-linear-form" -> "r-energy-r10-linear-dirichlet" [id="energy-and-equations-energy-panel-extensions-input-energy-r10-linear-dirichlet-energy-linear-form",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r10-linear-dirichlet" -> "n-energy-linear-dirichlet" [id="energy-and-equations-energy-panel-extensions-output-energy-r10-linear-dirichlet",style="solid",color="#315e50",arrowhead="normal",];
"r-energy-r11-domain-representatives-open" [id="energy-and-equations-energy-panel-extensions-r-energy-r11-domain-representatives-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r11-domain-representatives-open",tooltip="For domain extension, replace the strict Laurent hypotheses by proved barriers, cutoff-error estimates, global Green exchange and uniform weighted boundary tightness; specify which boundary notion is preserved under exhaustion. For classical representatives, supply actual regularization or relative detection linking the Borel capacity class to an ambient classical psh representative, together with its comparison and boundary properties. The existing proofs identify exactly where geometry controls truncation, integration by parts and loss at the boundary. Those are requirements for extension, not consequences of having a negative exhaustion alone. Recovering a classical representative is a second task: curvature quotients and capacity quotients cannot be identified without a theorem."];
"n-energy-tail-calculus" -> "r-energy-r11-domain-representatives-open" [id="energy-and-equations-energy-panel-extensions-input-energy-r11-domain-representatives-open-energy-tail-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-mixed-energy" -> "r-energy-r11-domain-representatives-open" [id="energy-and-equations-energy-panel-extensions-input-energy-r11-domain-representatives-open-energy-mixed-energy",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-completion" -> "r-energy-r11-domain-representatives-open" [id="energy-and-equations-energy-panel-extensions-input-energy-r11-domain-representatives-open-energy-completion",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r11-domain-representatives-open" -> "n-energy-domain-representatives" [id="energy-and-equations-energy-panel-extensions-output-energy-r11-domain-representatives-open",style="dashed",color="#76518c",arrowhead="normal",];
"r-energy-r14-singularities-open" [id="energy-and-equations-energy-panel-extensions-r-energy-r14-singularities-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r14-singularities-open",tooltip="Specify negative actual potential classes, allowed backgrounds, ordinary domains and boundary conditions; bounded singularity changes mean u−v is locally bounded in the intended comparison class. Missing: combine the capacity-tail estimates with a controlled model singularity and prove stability of the canonical truncation mass under a specified proper geometric modification. The modification must belong to a mapping class in which the required current operations are already defined; retain the relative null ideal instead of identifying it with ambient polarity. The known tail formulas turn no loss and energy integrability into quantitative sublevel estimates. They supply a proposed starting point for singularity invariance, but invariance of nonpolar mass and transport through a modification still require their own stability proof. No arbitrary-current pullback is inferred."];
"n-energy-tail-calculus" -> "r-energy-r14-singularities-open" [id="energy-and-equations-energy-panel-extensions-input-energy-r14-singularities-open-energy-tail-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r14-singularities-open" -> "n-energy-singularity-invariants" [id="energy-and-equations-energy-panel-extensions-output-energy-r14-singularities-open",style="dashed",color="#76518c",arrowhead="normal",];
"r-energy-r12-green-products-open" [id="energy-and-equations-energy-panel-extensions-r-energy-r12-green-products-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r12-green-products-open",tooltip="Specify a first-energy class of Green currents satisfying Dg_Z+δ_Z=ω_Z and admissible truncations. Missing: proper-intersection or replacement conditions controlling multiplication along cycles, coefficient integrability, and independence of presentations and truncations. For curvature-generated expressions, separately prove the required relation descent and comparison with the existing smooth, formal and delta-form products. Energy estimates can bound the proposed limiting integrals, while relation descent would address the differential presentation. Neither input alone defines products with cycle currents. The arrow marks the proposed interface to an open Green product theory, not an established implication."];
"n-energy-tail-calculus" -> "r-energy-r12-green-products-open" [id="energy-and-equations-energy-panel-extensions-input-energy-r12-green-products-open-energy-tail-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-mixed-energy" -> "r-energy-r12-green-products-open" [id="energy-and-equations-energy-panel-extensions-input-energy-r12-green-products-open-energy-mixed-energy",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r12-green-products-open" -> "n-energy-green-products" [id="energy-and-equations-energy-panel-extensions-output-energy-r12-green-products-open",style="dashed",color="#76518c",arrowhead="normal",];
"r-energy-r13-adelic-open" [id="energy-and-equations-energy-panel-extensions-r-energy-r13-adelic-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 05</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r13-adelic-open",tooltip="Specify the adelic metrized line bundles and retain the geometric and boundary-completion hypotheses of the established continuous local Chern theory. Missing locally: the chosen finite-energy intersection integral and its metric-change formula, with approximation independence. Missing globally: a placewise summable dominating estimate, compatible boundary control and the product formula; global positivity retains its own geometric hypotheses. The local energy calculus is a candidate input for extending continuous local intersection terms. A separate summability argument must assemble them into a global pairing. Local measure positivity does not imply arithmetic nefness, and the Green-product project is not asserted to be a proved prerequisite or a sufficient route to this adelic goal."];
"n-energy-tail-calculus" -> "r-energy-r13-adelic-open" [id="energy-and-equations-energy-panel-extensions-input-energy-r13-adelic-open-energy-tail-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-mixed-energy" -> "r-energy-r13-adelic-open" [id="energy-and-equations-energy-panel-extensions-input-energy-r13-adelic-open-energy-mixed-energy",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r13-adelic-open" -> "n-energy-adelic-intersection" [id="energy-and-equations-energy-panel-extensions-output-energy-r13-adelic-open",style="dashed",color="#76518c",arrowhead="normal",];
}
