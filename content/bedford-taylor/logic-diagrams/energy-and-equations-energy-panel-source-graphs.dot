digraph "energy-and-equations-energy-panel-source-graphs" {
graph [id="svg-energy-and-equations-energy-panel-source-graphs",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-energy-dual" [id="energy-and-equations-energy-panel-source-graphs-n-energy-dual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Banach differences and closed<BR ALIGN="LEFT"/>sources</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:r12-energy-difference-Banach",tooltip="The actual Borel difference space D_S=C−C is Banach. The curvature functional J(u)(h)=B(h,u,…,u) is injective; its image is norm closed, and the dual distance between sources gives a complete metric inducing the strong topology on C. Closed image does not assert surjectivity onto the dual."];
"n-energy-compatible-classes" [id="energy-and-equations-energy-panel-source-graphs-n-energy-compatible-classes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Find source conditions from the<BR ALIGN="LEFT"/>data</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O05</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#problem:sources",tooltip="Find substantial geometric classes of given μ for which strong continuity and Ξ=0 follow from checkable input conditions. A local inverse route needs a specified linearized range, a right inverse with boundary and moment estimates, and preservation of that range by the nonlinear remainder. Assuming an unknown solution would restate the goal."];
"n-energy-clamped-projection" [id="energy-and-equations-energy-panel-source-graphs-n-energy-clamped-projection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Complemented clamped linear<BR ALIGN="LEFT"/>range</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q08</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/0708831dbea1/#complemented-clamped-range-and-all-harmonic-moments",tooltip="On a real ball, a bounded right inverse E of normal trace gives P=I−ET from the zero-Dirichlet C^(2,α) space to functions with both boundary traces zero. The Dirichlet inverse yields K and the projection Π onto the clamped Laplacian range. Its complement Q is harmonic, and all harmonic moments characterize the linear range. The infinite-dimensional range condition is explicit."];
"n-energy-clamped-source-graph" [id="energy-and-equations-energy-panel-source-graphs-n-energy-clamped-source-graph",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A small clamped nonlinear source<BR ALIGN="LEFT"/>graph</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q08</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/0708831dbea1/#an-explicit-convergent-graph-of-nonlinear-source-data",tooltip="For the fixed torus background S=β^(n−q)[X], 2≤q≤n, and a protected quadratic reference, the contraction h=C₁⁻¹K(g−N(h)) gives small source data f=g+QN(h(g)). The exact local condition is Qf=QN(h(Πf)). Zero extension adds no sphere mass because both traces vanish. The resulting bounded actual potentials satisfy the source identity on every original test, with a separate negativity budget."];
"n-energy-interface-source-graph" [id="energy-and-equations-energy-panel-source-graphs-n-energy-interface-source-graph",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A bulk-and-sphere source graph</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q08</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/ded90f071b1e/#the-full-original-radon-source",tooltip="For a specified strictly convex reference, small bulk parameters and a prescribed nonpositive C^(1,α) normal trace produce actual source data with an explicit positive sphere term. The density is ∫_ψ^0 σ_(q−1)(A_T+(s/R)I_T) ds. A quadratic reference also permits explicit inversion of a small nonnegative sphere density. General C^(2,α) references permit prescribed trace; the stronger surface-density regularity is not automatic. A fixed interface admits a common enlarged additive ideal."];
"n-energy-moving-interface-gap" [id="energy-and-equations-energy-panel-source-graphs-n-energy-moving-interface-gap",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Moving interfaces separate the<BR ALIGN="LEFT"/>topologies</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q08</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/88b92bed4012/#a-uniform-lower-bound-in-the-energy-difference-norm",tooltip="With q=1 in a fixed smooth torus background and n≥2, moving-sphere potentials converge uniformly and strongly while distinct radii remain separated in the full energy-difference norm. They yield an energy-difference-bounded positive cone functional that is neither strong-continuous nor literal Radon integration. An uncountable family of sphere interfaces also admits no single common principal ideal. None is a counterexample for literal positive Radon data."];
"r-energy-r26-clamped-graph" [id="energy-and-equations-energy-panel-source-graphs-r-energy-r26-clamped-graph",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r26-clamped-graph",tooltip="Use 0<α<1, a real ball and the fixed original torus background S=β^(n−q)[X] with 2≤q≤n; the known negative reference is quadratic on a larger protected neighborhood. Let C₁=binom(n−1,q−1), N(h)=σ_q(I+D²h)−binom(n,q)−C₁Δh, and choose the small radius so ||K||Lip(N)/C₁≤1/2. Take g in the clamped linear range with the stated norm budget, retain small Hessians and impose a separate bound by half the negative reference margin. The projected contraction solves for h without assuming that the full nonlinear residual belongs to the linear range. Applying the Laplacian yields the exact graph f=g+QN(h(g)). Both zero traces make the extension C¹,¹ without sphere mass. Local convex smoothing, bounded Hessian convergence and the original BT continuity estimate transfer the equality to every original test."];
"n-energy-clamped-projection" -> "r-energy-r26-clamped-graph" [id="energy-and-equations-energy-panel-source-graphs-input-energy-r26-clamped-graph-energy-clamped-projection",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r26-clamped-graph" -> "n-energy-clamped-source-graph" [id="energy-and-equations-energy-panel-source-graphs-output-energy-r26-clamped-graph",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r27-interface-graph" [id="energy-and-equations-energy-panel-source-graphs-r-energy-r27-interface-graph",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r27-interface-graph",tooltip="For a nonquadratic reference fix a known C^(2,α) profile v with D²v≥cI on the protected ball, the corresponding uniformly elliptic Dirichlet inverse, and its own clamped projections K_v,Π_v,Q_v. Choose small bulk parameter g in the clamped range and prescribed ψ≤0 in C^(1,α) on the sphere; the boundary lift and contraction satisfy the printed common norm and negativity budgets. The explicit inversion from a prescribed C^(1,α) sphere density is claimed only for the quadratic reference; general C^(2,α) tangential coefficients need not have that regularity. Replace the zero normal trace by Eψ and run the projected contraction for the specified reference. Convex gluing creates the positive normal Hessian jump; a boundary-layer argument gives the exact integral sphere density rather than discarding the interface mass. The full original source has the factor q!(n−q)! on both bulk and sphere terms. A larger anchor controls both signs of fixed-interface variations in the additive ideal."];
"n-energy-clamped-projection" -> "r-energy-r27-interface-graph" [id="energy-and-equations-energy-panel-source-graphs-input-energy-r27-interface-graph-energy-clamped-projection",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-clamped-source-graph" -> "r-energy-r27-interface-graph" [id="energy-and-equations-energy-panel-source-graphs-input-energy-r27-interface-graph-energy-clamped-source-graph",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r27-interface-graph" -> "n-energy-interface-source-graph" [id="energy-and-equations-energy-panel-source-graphs-output-energy-r27-interface-graph",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r28-moving-interfaces" [id="energy-and-equations-energy-panel-source-graphs-r-energy-r28-moving-interfaces",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r28-moving-interfaces",tooltip="For the topology example set q=1 and n≥2 in the fixed smooth torus background; independently use the explicit linear sphere-source formula, not the q≥2 contraction theorem. Choose radii in a compact interval inside the quadratic patch and one common small positive amplitude preserving negativity. Energy-difference lower bounds take the infimum over all decompositions in the full completed cone; the common-ideal obstruction uses the entire uncountable radius family. The linear sphere-source formula gives an exact discrepancy tending to zero with the radius. Positive curvature on disjoint spheres forces every energy-difference decomposition to have a fixed positive size. Testing against the union of a countable converging sequence of spheres constructs a bounded nonliteral dual that fails strong continuity. A single Radon source cannot charge uncountably many disjoint sphere sets on one compact core, so no common principal ideal covers every radius."];
"n-energy-dual" -> "r-energy-r28-moving-interfaces" [id="energy-and-equations-energy-panel-source-graphs-input-energy-r28-moving-interfaces-energy-dual",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r28-moving-interfaces" -> "n-energy-moving-interface-gap" [id="energy-and-equations-energy-panel-source-graphs-output-energy-r28-moving-interfaces",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r29-model-source-extension" [id="energy-and-equations-energy-panel-source-graphs-r-energy-r29-model-source-extension",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r29-model-source-extension",tooltip="To go beyond the specified toric smooth backgrounds, identify an original linearized range with its boundary and moment constraints for the proposed new reference. Prove a bounded right inverse and estimates preserving that range under the nonlinear remainder; where interfaces occur, derive their original source measures and matching conditions. Verify literal strong continuity and zero normal defect for the resulting input class; the existing model graphs do not make these universal. The constructive graphs show how an explicit complemented range and controlled boundary terms can produce compatible data. Extending their method requires these new range, inverse and interface theorems. The model existence statements do not settle general SOURCE-COMPAT or permit silently adding sphere mass to an unchanged datum."];
"n-energy-clamped-source-graph" -> "r-energy-r29-model-source-extension" [id="energy-and-equations-energy-panel-source-graphs-input-energy-r29-model-source-extension-energy-clamped-source-graph",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-interface-source-graph" -> "r-energy-r29-model-source-extension" [id="energy-and-equations-energy-panel-source-graphs-input-energy-r29-model-source-extension-energy-interface-source-graph",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r29-model-source-extension" -> "n-energy-compatible-classes" [id="energy-and-equations-energy-panel-source-graphs-output-energy-r29-model-source-extension",style="dashed",color="#76518c",arrowhead="normal",];
}
