digraph "bounded-calculus-and-relative-capacity-core-continuous-etale-panel" {
graph [id="svg-bounded-calculus-and-relative-capacity-core-continuous-etale-panel",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-core-regularization" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-n-core-regularization",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Regularization on one fixed<BR ALIGN="LEFT"/>neighborhood</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B01 · R01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#prop:regularization",tooltip="Bounded classical potentials admit decreasing continuous semipositive rational PL approximants over the original field. Finite families share one ordinary neighborhood. Continuous members admit smooth positive uniform approximants; smooth majorants used in the collar argument need not form a decreasing row."];
"n-core-coefficient-control" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-n-core-coefficient-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite control of original test<BR ALIGN="LEFT"/>coefficients</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:finite-control",tooltip="A positive current has Radon coefficient measures. On each compact original test presentation, one positive trace controls all coefficient variations and bounded Borel multiplication. Positivity and the estimate survive actual moment refinements, including rank drops."];
"n-core-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-n-core-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric bounded calculus and<BR ALIGN="LEFT"/>CLN bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02 · B02 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#cor:full-calculus",tooltip="Ordered products become symmetric in their potential slots, while retaining positivity, separate closedness, ordinary locality and weighted decreasing continuity. Relative CLN bounds control compact coefficient mass. This node does not yet assert that changing a potential while preserving its curvature leaves every background product unchanged."];
"n-core-approachable-calculus" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-n-core-approachable-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous calculus for<BR ALIGN="LEFT"/>approachable potentials</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/83153cdc67ad/#prop:fixed-potential",tooltip="For continuous potentials already locally approximable uniformly by smooth positive potentials, insertion into a positive separately closed background preserves positivity and closedness. It is jointly continuous for locally uniform potentials and weakly converging positive closed backgrounds; successive insertions are symmetric."];
"n-core-continuous-moving" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-n-core-continuous-moving",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous products with moving<BR ALIGN="LEFT"/>backgrounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/83153cdc67ad/#thm:background-products",tooltip="For finite continuous current-positive potentials on a smooth quasi-projective analytification, mixed products are symmetric and depend only on their curvature currents. Locally uniform convergence of potentials and weak convergence of positive closed backgrounds give joint continuity, including nets."];
"n-core-etale-tuples" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-n-core-etale-tuples",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Etale compatibility for<BR ALIGN="LEFT"/>specified potential tuples</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/0478f925f64f/#thm:etale-compatibility",tooltip="For an etale map, pull back the specified bounded classical potentials and pass their continuous regularizations to the weighted mixed product upstairs. The result is independent of those regularizations and compatible with restriction and composition; it constructs no pullback of an arbitrary singular current."];
"n-core-etale-degree" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-n-core-etale-degree",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite-etale degree and descent<BR ALIGN="LEFT"/>of a given function</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/0478f925f64f/#prop:etale-degree",tooltip="A finite etale map of constant degree d pushes a pulled-back weighted or unweighted ambient mixed product to d times the base product. A real function already given on the base is bounded classical if its pullback along a finite etale surjection is; this does not glue unrelated functions on different sheets."];
"r-core-r15-approachable-calculus" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-r-core-r15-approachable-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r15-approachable-calculus",tooltip="Work in the continuous theory on a smooth quasi-projective analytification over the original valued field; every potential already admits locally uniform smooth positive approximants on a fixed smaller neighborhood. All backgrounds in the net are positive and separately closed of the same bidegree; the total mixed degree is at most n. For a smooth approximant, D(u_j T)=Du_j wedge T is positive. Continuous coefficient control passes locally uniform approximation and weak background limits through multiplication, then differentiation. Iteration and simultaneous smooth approximation give symmetry. This foundational step assumes approachability; it does not first need the current-positivity regularization theorem."];
"n-core-coefficient-control" -> "r-core-r15-approachable-calculus" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-input-core-r15-approachable-calculus-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r15-approachable-calculus" -> "n-core-approachable-calculus" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-output-core-r15-approachable-calculus",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r21-continuous-moving-backgrounds" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-r-core-r21-continuous-moving-backgrounds",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r21-continuous-moving-backgrounds",tooltip="Use the continuous part of local regularization on a smooth quasi-projective analytification: every finite continuous input has positive original curvature current. Potentials converge locally uniformly and backgrounds converge weakly on every original compact smooth test, remain positive and separately closed, and have one fixed bidegree. Regularization places each current-positive continuous potential in the approachable class. Iterate the foundational moving-background operation. If two potentials have equal curvature, their continuous difference and its negative are both approachable; positivity and pointedness force zero insertion of that difference against every allowed closed tail."];
"n-core-regularization" -> "r-core-r21-continuous-moving-backgrounds" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-input-core-r21-continuous-moving-backgrounds-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-approachable-calculus" -> "r-core-r21-continuous-moving-backgrounds" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-input-core-r21-continuous-moving-backgrounds-core-approachable-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r21-continuous-moving-backgrounds" -> "n-core-continuous-moving" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-output-core-r21-continuous-moving-backgrounds",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r22-etale-tuples" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-r-core-r22-etale-tuples",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r22-etale-tuples",tooltip="f:Y->X is etale between the allowed analytic spaces. A specified tuple u_0,...,u_k lies in C_b on one base ordinary open, with simultaneous decreasing continuous semipositive regularizations there. Use the ambient integration backgrounds [1] on each space, the original pullback identity for smooth forms, and k<=n. At continuous stages, locally uniform smooth approximation identifies the pulled-back operation with the product of the pulled-back weights. Weighted decreasing continuity on Y gives the bounded limit on every original test. Reusing the same approximants proves compatibility with composition and ordinary restriction."];
"n-core-regularization" -> "r-core-r22-etale-tuples" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-input-core-r22-etale-tuples-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-bounded-calculus" -> "r-core-r22-etale-tuples" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-input-core-r22-etale-tuples-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r22-etale-tuples" -> "n-core-etale-tuples" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-output-core-r22-etale-tuples",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r23-etale-degree-and-descent" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-r-core-r23-etale-degree-and-descent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r23-etale-degree-and-descent",tooltip="For the degree formula, f is finite etale of constant degree d, and all potentials are specified bounded classical functions on the base; locally constant degrees are handled componentwise. For class descent, f is a finite etale surjection and u is one real function already given on the base with u composed with f in C_b. Use the cited finite-surjection descent of classical curve subharmonicity. The calibrated finite-map integration formula gives the degree factor for smooth tuples; properness keeps pulled-back tests compact, so continuous approximation and weighted decreasing continuity pass the identity to bounded tuples. For the given base function, closedness of the finite map descends upper semicontinuity and local boundedness; curve subharmonicity descends separately."];
"n-core-etale-tuples" -> "r-core-r23-etale-degree-and-descent" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-input-core-r23-etale-degree-and-descent-core-etale-tuples",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-bounded-calculus" -> "r-core-r23-etale-degree-and-descent" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-input-core-r23-etale-degree-and-descent-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r23-etale-degree-and-descent" -> "n-core-etale-degree" [id="bounded-calculus-and-relative-capacity-core-continuous-etale-panel-output-core-r23-etale-degree-and-descent",style="dashed",color="#64757c",arrowhead="normal",];
}
