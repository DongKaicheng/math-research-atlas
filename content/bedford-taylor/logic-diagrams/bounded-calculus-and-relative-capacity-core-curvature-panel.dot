digraph "bounded-calculus-and-relative-capacity-core-curvature-panel" {
graph [id="svg-bounded-calculus-and-relative-capacity-core-curvature-panel",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-core-coefficient-control" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-n-core-coefficient-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite control of original test<BR ALIGN="LEFT"/>coefficients</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:finite-control",tooltip="A positive current has Radon coefficient measures. On each compact original test presentation, one positive trace controls all coefficient variations and bounded Borel multiplication. Positivity and the estimate survive actual moment refinements, including rank drops."];
"n-core-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-n-core-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric bounded calculus and<BR ALIGN="LEFT"/>CLN bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02 · B02 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#cor:full-calculus",tooltip="Ordered products become symmetric in their potential slots, while retaining positivity, separate closedness, ordinary locality and weighted decreasing continuity. Relative CLN bounds control compact coefficient mass. This node does not yet assert that changing a potential while preserving its curvature leaves every background product unchanged."];
"n-core-difference-criterion" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-n-core-difference-criterion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Separate bounded-difference<BR ALIGN="LEFT"/>criterion</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M03 · M04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:difference-criterion",tooltip="For an actual function h locally expressible as a difference of bounded classical psh functions, D[h] is positive if and only if h itself is classical psh. This is a separately adopted analytic input, with curve order transfer and recovery of the actual upper-semicontinuous representative."];
"n-core-curvature-invariance" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-n-core-curvature-invariance",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Actual curvature kernel and<BR ALIGN="LEFT"/>background order</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M03 · M04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:actual-kernel",tooltip="The kernel on bounded classical differences consists of actual continuous functions whose two signs are classical psh. Curvature order D[u] >= D[v] transfers to D(uS) >= D(vS); equality therefore permits replacement of any potential slot by another with the same curvature."];
"n-core-potential-gluing" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-n-core-potential-gluing",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Products glue from local<BR ALIGN="LEFT"/>curvature potentials</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#cor:potential-current-products",tooltip="When each curvature current locally has a bounded classical potential, the local mixed products agree on overlaps. They define a unique positive, separately closed, symmetric product of those curvature currents and the chosen background."];
"n-core-continuous-module" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-n-core-continuous-module",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous degree-one curvature<BR ALIGN="LEFT"/>relations descend</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:continuous-relations",tooltip="Finite continuous-coefficient relations between degree-one curvature currents remain relations after inserting a fixed positive closed background. Applying this one slot at a time gives a well-defined positive symmetric mixed operation on the continuous curvature module."];
"r-core-r7-curvature-order" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-r-core-r7-curvature-order",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r7-curvature-order",tooltip="Use actual bounded classical differences, rather than representatives modulo an almost-everywhere relation. For background order, u and v are bounded classical potentials and p < n; a mixed replacement uses a positive closed mixed tail with total degree at most n. Positive D[u-v] makes the actual difference u-v classical psh by the separate criterion; first-order positivity then gives D((u-v)S) >= 0. Equality follows in both orders, and symmetry moves any chosen slot to the front. For the kernel, apply the criterion to both signs: both are upper semicontinuous, hence the actual function is continuous; pointedness gives the converse."];
"n-core-bounded-calculus" -> "r-core-r7-curvature-order" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-input-core-r7-curvature-order-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-difference-criterion" -> "r-core-r7-curvature-order" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-input-core-r7-curvature-order-core-difference-criterion",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r7-curvature-order" -> "n-core-curvature-invariance" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-output-core-r7-curvature-order",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r8-curvature-gluing" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-r-core-r8-curvature-gluing",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r8-curvature-gluing",tooltip="Each input current locally has a potential a_i in C_b with alpha_i = D[a_i]; the chosen background is fixed and k <= q. On overlaps, the two local potentials represent the same actual curvature current. Replace the local potentials one slot at a time on each overlap. Background invariance identifies the mixed currents, and the sheaf property of currents glues them uniquely. Positivity, symmetry and separate closedness pass from the local bounded products."];
"n-core-curvature-invariance" -> "r-core-r8-curvature-gluing" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-input-core-r8-curvature-gluing-core-curvature-invariance",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r8-curvature-gluing" -> "n-core-potential-gluing" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-output-core-r8-curvature-gluing",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r9-continuous-relations" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-r-core-r9-continuous-relations",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r9-continuous-relations",tooltip="Use finite presentations A = sum f_i D[g_i], with f_i continuous and g_i in C_b; equality and positivity are those of actual original currents. The mixed degree remains at most n; other curvature slots and the background are positive when positivity is asserted. Freeze the continuous coefficients on small neighborhoods. The bounded-difference criterion converts each positive frozen curvature combination into a classical psh potential, so first-order positivity transfers it to the background. Finite coefficient control makes the freezing error tend to zero. Transfer zero relations one slot at a time to obtain presentation independence; the same estimate proves positivity of the mixed operation."];
"n-core-coefficient-control" -> "r-core-r9-continuous-relations" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-input-core-r9-continuous-relations-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-bounded-calculus" -> "r-core-r9-continuous-relations" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-input-core-r9-continuous-relations-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-difference-criterion" -> "r-core-r9-continuous-relations" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-input-core-r9-continuous-relations-core-difference-criterion",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r9-continuous-relations" -> "n-core-continuous-module" [id="bounded-calculus-and-relative-capacity-core-curvature-panel-output-core-r9-continuous-relations",style="dashed",color="#64757c",arrowhead="normal",];
}
