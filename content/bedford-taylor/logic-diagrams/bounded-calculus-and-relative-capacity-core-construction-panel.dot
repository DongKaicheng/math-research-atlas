digraph "bounded-calculus-and-relative-capacity-core-construction-panel" {
graph [id="svg-bounded-calculus-and-relative-capacity-core-construction-panel",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-core-regularization" [id="bounded-calculus-and-relative-capacity-core-construction-panel-n-core-regularization",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Regularization on one fixed<BR ALIGN="LEFT"/>neighborhood</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B01 · R01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#prop:regularization",tooltip="Bounded classical potentials admit decreasing continuous semipositive rational PL approximants over the original field. Finite families share one ordinary neighborhood. Continuous members admit smooth positive uniform approximants; smooth majorants used in the collar argument need not form a decreasing row."];
"n-core-coefficient-control" [id="bounded-calculus-and-relative-capacity-core-construction-panel-n-core-coefficient-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite control of original test<BR ALIGN="LEFT"/>coefficients</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:finite-control",tooltip="A positive current has Radon coefficient measures. On each compact original test presentation, one positive trace controls all coefficient variations and bounded Borel multiplication. Positivity and the estimate survive actual moment refinements, including rank drops."];
"n-core-ordered-products" [id="bounded-calculus-and-relative-capacity-core-construction-panel-n-core-ordered-products",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ordered bounded products exist</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#prop:ordered-construction",tooltip="The recursion T(S,k) = D(u_1 T(S,k-1)) gives positive, separately closed coefficient-Radon currents. At this stage the order of the differentiated slots is retained; permutation symmetry and joint decreasing continuity are proved later."];
"n-core-collar-estimates" [id="bounded-calculus-and-relative-capacity-core-construction-panel-n-core-collar-estimates",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Common collars and two trace<BR ALIGN="LEFT"/>bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:smooth-collar",tooltip="On smaller norm boxes, all relevant potentials can be patched to the same smooth psh collar. Green exchange with a smooth argument gives a lower trace bound; continuous majorants give a separate upper bound for decreasing weights. The limits are arranged with a fixed coefficient measure at each discontinuous multiplication."];
"n-core-weighted-continuity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-n-core-weighted-continuity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Weighted joint decreasing<BR ALIGN="LEFT"/>continuity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:relative-monotone",tooltip="For a fixed allowed background and locally bounded decreasing classical potentials, the mixed products converge with an additional undifferentiated classical psh weight. Convergence holds on every original compact smooth complementary test, not merely on a selected trace family."];
"n-core-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-construction-panel-n-core-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric bounded calculus and<BR ALIGN="LEFT"/>CLN bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02 · B02 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#cor:full-calculus",tooltip="Ordered products become symmetric in their potential slots, while retaining positivity, separate closedness, ordinary locality and weighted decreasing continuity. Relative CLN bounds control compact coefficient mass. This node does not yet assert that changing a potential while preserving its curvature leaves every background product unchanged."];
"n-core-capacity-estimate" [id="bounded-calculus-and-relative-capacity-core-construction-panel-n-core-capacity-estimate",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Quantitative relative capacity<BR ALIGN="LEFT"/>estimate</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#thm:relative-capacity-estimate",tooltip="For a bounded decreasing row with one fixed smooth collar, the capacity of {u_j-u > delta} is bounded by C/delta times a fixed-measure error to the power 2^(-k). Thus the row converges in relative capacity on that norm-box domain."];
"n-core-quasicontinuity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-n-core-quasicontinuity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Local capacity convergence and<BR ALIGN="LEFT"/>quasicontinuity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#cor:relative-quasicontinuity",tooltip="Bounded decreasing classical potentials converge in relative capacity on a smaller norm-box core. Every bounded classical potential is continuous outside an ordinary open set of arbitrarily small relative capacity. In top degree the capacity needs no auxiliary trace form."];
"n-core-borel-inner-regularity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-n-core-borel-inner-regularity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Outer capacity on arbitrary<BR ALIGN="LEFT"/>Borel sets</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · C05 · N01 · N02 · N03 · O03</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#question:outer",tooltip="For every strict Laurent box and allowed extending background, is the relative outer capacity of each Borel set the supremum of its values on compact subsets? The question includes passage from relatively compact sets to an exhaustion. Counterexamples to raw/outer equality, strong subadditivity and extremal total-mass calibration do not refute this Borel inner-regularity question."];
"r-core-r1-ordered-construction" [id="bounded-calculus-and-relative-capacity-core-construction-panel-r-core-r1-ordered-construction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r1-ordered-construction",tooltip="Use the continuous arbitrary-background positivity theorem of R, transported to the local analytic setting as in B. The background is fixed and allowed; the potentials and their limits are locally bounded classical psh, with k <= q. For continuous p_j decreasing to u, the continuous theorem makes D(p_j R) positive. Bounded convergence against the fixed coefficient measures gives p_j R -> uR; differentiation and closedness of the positive cone give D(uR). Iteration uses the resulting positive closed current as the next background. This is the construction stage, before permutation symmetry."];
"n-core-regularization" -> "r-core-r1-ordered-construction" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r1-ordered-construction-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r1-ordered-construction" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r1-ordered-construction-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r1-ordered-construction" -> "n-core-ordered-products" [id="bounded-calculus-and-relative-capacity-core-construction-panel-output-core-r1-ordered-construction",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r2-collar-and-traces" [id="bounded-calculus-and-relative-capacity-core-construction-panel-r-core-r2-collar-and-traces",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r2-collar-and-traces",tooltip="Shrink to nested polynomial norm boxes around a compact original test and retain every coordinate used by that test. All finitely many potential families have one local bound and one projective extension collar; use the smooth regularized maximum with its exact inactive branch. The lower trace estimate compares coordinatewise ordered potentials. The upper estimate assumes locally bounded decreasing weights and positive currents already convergent on all original tests. Patch the potentials to one smooth psh function near the derivative support of a cutoff. Green exchange moves a smooth majorant into a differentiated slot. Successive fixed-background limits give trace monotonicity; continuous majorants and coefficient control give the complementary upper bound for decreasing weights."];
"n-core-regularization" -> "r-core-r2-collar-and-traces" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r2-collar-and-traces-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r2-collar-and-traces" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r2-collar-and-traces-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-ordered-products" -> "r-core-r2-collar-and-traces" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r2-collar-and-traces-core-ordered-products",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r2-collar-and-traces" -> "n-core-collar-estimates" [id="bounded-calculus-and-relative-capacity-core-construction-panel-output-core-r2-collar-and-traces",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r3-weighted-induction" [id="bounded-calculus-and-relative-capacity-core-construction-panel-r-core-r3-weighted-induction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r3-weighted-induction",tooltip="All k differentiated rows and the undifferentiated weight decrease to locally bounded classical psh limits on a common neighborhood. The background stays fixed and 0 <= k <= q; the test is any original compact smooth complementary form. Induct on k. Weighted convergence in degree k-1 gives unweighted convergence in degree k after differentiation. The two collar trace bounds identify the weighted degree-k limit. Positive tests of the form C times a trace plus or minus the given test then recover convergence on every original test."];
"n-core-ordered-products" -> "r-core-r3-weighted-induction" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r3-weighted-induction-core-ordered-products",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r3-weighted-induction" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r3-weighted-induction-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-collar-estimates" -> "r-core-r3-weighted-induction" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r3-weighted-induction-core-collar-estimates",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r3-weighted-induction" -> "n-core-weighted-continuity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-output-core-r3-weighted-induction",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r4-full-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-construction-panel-r-core-r4-full-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r4-full-bounded-calculus",tooltip="Use symmetry of the continuous arbitrary-background products, obtained by smooth uniform approximation. For CLN bounds, work between nested compact cutoff neighborhoods and bound each potential there; k <= q. Continuous regularizations satisfy permutation symmetry; joint decreasing continuity passes that identity to bounded potentials. The coefficient CLN bound is obtained separately from the ordered recursion: integrate by parts through nested cutoffs, gaining one potential sup norm per slot. No curvature-quotient assertion is used in either argument."];
"n-core-regularization" -> "r-core-r4-full-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r4-full-bounded-calculus-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r4-full-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r4-full-bounded-calculus-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-ordered-products" -> "r-core-r4-full-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r4-full-bounded-calculus-core-ordered-products",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-weighted-continuity" -> "r-core-r4-full-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r4-full-bounded-calculus-core-weighted-continuity",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r4-full-bounded-calculus" -> "n-core-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-construction-panel-output-core-r4-full-bounded-calculus",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r5-capacity-energy-estimate" [id="bounded-calculus-and-relative-capacity-core-construction-panel-r-core-r5-capacity-energy-estimate",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 05</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r5-capacity-energy-estimate",tooltip="Omega is the interior of one polynomial norm box; a compact L lies in a strictly smaller nested box. The row u_j decreases to u, is uniformly bounded near L, and u_j = u = one smooth psh h on Omega minus L. Fix the allowed background, a smooth trace form beta when k < q, and 1 <= k <= q. The bounded calculus first yields relative energy measures, Green's identity and Cauchy–Schwarz. For g_j = u_j-u and normalized testers v, these give I_r squared <= A_r I_(r-1), with A_r uniformly bounded by relative CLN. Iterate to exponent 2^(-k), use the level-set bound, and let I_0 tend to zero against the single fixed measure (Du)^k S beta^(q-k)."];
"n-core-regularization" -> "r-core-r5-capacity-energy-estimate" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r5-capacity-energy-estimate-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-collar-estimates" -> "r-core-r5-capacity-energy-estimate" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r5-capacity-energy-estimate-core-collar-estimates",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-bounded-calculus" -> "r-core-r5-capacity-energy-estimate" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r5-capacity-energy-estimate-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r5-capacity-energy-estimate" -> "n-core-capacity-estimate" [id="bounded-calculus-and-relative-capacity-core-construction-panel-output-core-r5-capacity-energy-estimate",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r6-capacity-quasicontinuity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-r-core-r6-capacity-quasicontinuity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 06</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r6-capacity-quasicontinuity",tooltip="The decreasing family is defined on a neighborhood of the closure of a sufficiently small norm box Omega; V_0 is a smaller relatively compact core. Keep the admissibility domain and relative capacity fixed, and use its countable subadditivity. Patch the entire family to the common collar and apply the quantitative estimate on the core. For a continuous decreasing regularization, choose a subsequence whose exceptional capacities are summable. The union of its ordinary open error sets has arbitrarily small capacity; outside that union the subsequence converges uniformly, so its limit is continuous."];
"n-core-regularization" -> "r-core-r6-capacity-quasicontinuity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r6-capacity-quasicontinuity-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-collar-estimates" -> "r-core-r6-capacity-quasicontinuity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r6-capacity-quasicontinuity-core-collar-estimates",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-capacity-estimate" -> "r-core-r6-capacity-quasicontinuity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r6-capacity-quasicontinuity-core-capacity-estimate",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r6-capacity-quasicontinuity" -> "n-core-quasicontinuity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-output-core-r6-capacity-quasicontinuity",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r14-borel-remainder-open" [id="bounded-calculus-and-relative-capacity-core-construction-panel-r-core-r14-borel-remainder-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>AND · Open step 07</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r14-borel-remainder-open",tooltip="Fix a strict Laurent box V, q >= 1, and an allowed background S extending to a neighborhood of its closure. Use outer capacity C*_S and the full family of actual normalized classical testers defined on this same V. One proposed sufficient local route remains to be proved: for a relatively compact Borel E and each epsilon > 0, find a compact H contained in E and an ordinary open G containing E minus H whose mass is below epsilon uniformly for every actual normalized tester measure. Separately justify passage to an exhaustion of V while preserving the full tester family and the uniform estimates; a countable dominating-measure reduction or replacement by completed sources needs its own theorem. The established convergence and quasicontinuity results provide the local capacity calculus, but do not supply uniform Borel remainders across the entire tester family. The finite-Hausdorff saturated model proves such a remainder estimate in a restricted range and suggests this route. Its extension and the exhaustion step remain open. Failure of raw/outer equality or strong subadditivity blocks shortcuts, not CAP-BOREL itself."];
"n-core-capacity-estimate" -> "r-core-r14-borel-remainder-open" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r14-borel-remainder-open-core-capacity-estimate",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-quasicontinuity" -> "r-core-r14-borel-remainder-open" [id="bounded-calculus-and-relative-capacity-core-construction-panel-input-core-r14-borel-remainder-open-core-quasicontinuity",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r14-borel-remainder-open" -> "n-core-borel-inner-regularity" [id="bounded-calculus-and-relative-capacity-core-construction-panel-output-core-r14-borel-remainder-open",style="dashed",color="#76518c",arrowhead="normal",];
}
