digraph "bounded-calculus-and-relative-capacity-core-module-bands-panel" {
graph [id="svg-bounded-calculus-and-relative-capacity-core-module-bands-panel",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-core-coefficient-control" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-n-core-coefficient-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite control of original test<BR ALIGN="LEFT"/>coefficients</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:finite-control",tooltip="A positive current has Radon coefficient measures. On each compact original test presentation, one positive trace controls all coefficient variations and bounded Borel multiplication. Positivity and the estimate survive actual moment refinements, including rank drops."];
"n-core-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-n-core-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric bounded calculus and<BR ALIGN="LEFT"/>CLN bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02 · B02 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#cor:full-calculus",tooltip="Ordered products become symmetric in their potential slots, while retaining positivity, separate closedness, ordinary locality and weighted decreasing continuity. Relative CLN bounds control compact coefficient mass. This node does not yet assert that changing a potential while preserving its curvature leaves every background product unchanged."];
"n-core-continuous-module" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-n-core-continuous-module",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous degree-one curvature<BR ALIGN="LEFT"/>relations descend</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:continuous-relations",tooltip="Finite continuous-coefficient relations between degree-one curvature currents remain relations after inserting a fixed positive closed background. Applying this one slot at a time gives a well-defined positive symmetric mixed operation on the continuous curvature module."];
"n-core-pws-module" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-n-core-pws-module",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Intrinsic differentials on the<BR ALIGN="LEFT"/>existing PS module</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M06</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/cf8ed88e70d3/#thm:r10-pws-derivative-radon-closure",tooltip="Finite actual tangentially compatible piecewise-smooth coefficients times allowed closed currents have intrinsic coefficient-Radon derivatives. The corrected bounded-potential insertion agrees with inserting into each closed tail, is independent of the chosen presentation, and retains the stated differential and symmetry identities. General higher delta-form relation descent is not included."];
"n-core-order-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-n-core-order-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Faithful completion for fixed<BR ALIGN="LEFT"/>local order gauges</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M07</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:faithful-order",tooltip="Completing the continuous curvature module in fixed positive local gauges gives faithful actual coefficient-Radon currents and a unique local positive order-continuous mixed action. Different controls are reconciled by a common sum. This completion is a specified subspace, with no identification with all positive currents or the strong first-energy space."];
"n-core-parameter-bands" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-n-core-parameter-bands",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Closed bands and original<BR ALIGN="LEFT"/>conditional currents</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C04</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/3dbfb9a22e8d/#thm:r12-closed-parameter-bands",tooltip="When all parameter differentials annihilate the background, Borel parameter restrictions stay separately closed and commute with bounded BT insertion. On a second-countable ordinary domain they disintegrate into conditional currents on the original analytic space, with one exceptional set for all original tests and refinements."];
"n-core-band-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-n-core-band-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A qualified band-capacity<BR ALIGN="LEFT"/>completion</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C04</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/67dab8d84957/#def:r12-band-capacitary-completion",tooltip="Starting from countable Borel-band combinations of globally continuous classical branches, local outer-capacity closure gives a complete quasicontinuous class with intrinsic bounded mixed currents. For the seed capacity, completed and seed outer capacities coincide. This does not identify all bounded-classical band testers with the seed family or prove raw/outer equality on compact sets."];
"r-core-r24-existing-pws-module" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-r-core-r24-existing-pws-module",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r24-existing-pws-module",tooltip="Use the established actual codimension-zero PS multiplication, tangency and anchored finite Courant-word presentation, together with the uniform normal-wall variation estimate. R is a finite sum alpha_nu wedge S_nu, with actual tangentially compatible piecewise-smooth forms alpha_nu and allowed positive separately closed tails S_nu; R itself need not be closed or symmetric. Inserted potentials are actual locally bounded classical psh; in bidegree (a,b), the mixed insertion budget is max(a,b)+k<=n. No general variable-PS higher delta-form quotient is assumed. Simultaneously convolve the finite PL generators. Normal-factor errors are O(epsilon^(1/2)) uniformly over the relevant positive BT tails. First pass weighted BT limits against a fixed smooth test, then remove smoothing. Distributional differentiation makes the derivatives intrinsic. The corrected insertion cancels derivatives of the coefficient current and becomes the sum of the same coefficients times D(uS_nu), proving witness independence."];
"n-core-bounded-calculus" -> "r-core-r24-existing-pws-module" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-input-core-r24-existing-pws-module-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r24-existing-pws-module" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-input-core-r24-existing-pws-module-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r24-existing-pws-module" -> "n-core-pws-module" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-output-core-r24-existing-pws-module",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r25-fixed-gauge-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-r-core-r25-fixed-gauge-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r25-fixed-gauge-completion",tooltip="In each local slot choose a fixed positive represented gauge Q_i, and take an order-Cauchy sequence in its order ideal of symmetric coefficient-Radon (1,1) currents; the number of slots is at most n-p. Use finitely many common local controls, rather than asserting one global gauge. To conclude separate closedness of the limiting product, require its approximating mixed products to be separately closed. Decompose each controlled signed factor into the positive factors (M_i Q_i plus or minus A_i)/2 and telescope differences to get the sharp order bound. Finite test domination realizes order-Cauchy rows as actual currents; weak closedness of the cone proves faithfulness and isometry. Passing the mixed action to limits gives a unique extension, and replacing two choices of control by their sum proves independence and local gluing."];
"n-core-continuous-module" -> "r-core-r25-fixed-gauge-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-input-core-r25-fixed-gauge-completion-core-continuous-module",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r25-fixed-gauge-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-input-core-r25-fixed-gauge-completion-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r25-fixed-gauge-completion" -> "n-core-order-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-output-core-r25-fixed-gauge-completion",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r26-closed-bands-and-disintegration" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-r-core-r26-closed-bands-and-disintegration",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r26-closed-bands-and-disintegration",tooltip="Let s=(log|f_i|) for original analytic units and let R be an allowed symmetric positive separately closed coefficient-Radon current with both d′s_i wedge R=0 and d″s_i wedge R=0. For the Borel commutation identity, u is locally bounded Borel and D(uR) is coefficient-Radon; bounded classical BT potentials satisfy this requirement. For conditional currents, work on a second-countable ordinary U and use Radon measure disintegration with the proved countably cofinal original-test system. No rank, submersion, product-chart or fiber-field hypothesis is substituted for these conditions. The smooth chain rule kills every parameter derivative by annihilation. One Borel L1 approximation against the coefficient measures of R and D(uR) passes the identities to Borel bands. A countable control measure then permits simultaneous disintegration of original coefficients. Countably cofinal tests impose positivity, closedness and refinement identities outside one null set; continuity recovers every original test. The conditional currents live on U and are carried by its level sets."];
"n-core-bounded-calculus" -> "r-core-r26-closed-bands-and-disintegration" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-input-core-r26-closed-bands-and-disintegration-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r26-closed-bands-and-disintegration" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-input-core-r26-closed-bands-and-disintegration-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r26-closed-bands-and-disintegration" -> "n-core-parameter-bands" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-output-core-r26-closed-bands-and-disintegration",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r27-band-capacity-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-r-core-r27-band-capacity-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r27-band-capacity-completion",tooltip="Retain parameter annihilation and place the closure of V inside the interior of one compact original affinoid; the background has degree P and remaining degree k=n-P>=1. This construction does not require extension of R across the boundary. The seed family consists of [0,1]-valued countable Borel parameter-band combinations of globally continuous actual classical psh branches. Distinguish its capacity gamma_0 from gamma_1 for all bounded-classical band testers. Complete the seed family in local OUTER gamma_i capacity, for the chosen i=0 or 1, modulo the matching locally outer-null ideal. Do not assume gamma_0=gamma_1 or raw/outer equality on compact sets. Capacity convergence of the seed rows, together with uniform coefficient estimates by outer capacity, makes the bounded mixed currents Cauchy on every original test. Weighted weak passage and the distributional recursion give positive closed intrinsic limits, independent of rows. For the seed capacity, gamma_0<=completed gamma_0<=outer gamma_0, equality on ordinary opens and equality after outer regularization follow. The larger tester family has only the stated inequalities; its cofinality remains a separate issue."];
"n-core-parameter-bands" -> "r-core-r27-band-capacity-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-input-core-r27-band-capacity-completion-core-parameter-bands",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-bounded-calculus" -> "r-core-r27-band-capacity-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-input-core-r27-band-capacity-completion-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-coefficient-control" -> "r-core-r27-band-capacity-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-input-core-r27-band-capacity-completion-core-coefficient-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r27-band-capacity-completion" -> "n-core-band-completion" [id="bounded-calculus-and-relative-capacity-core-module-bands-panel-output-core-r27-band-capacity-completion",style="dashed",color="#64757c",arrowhead="normal",];
}
