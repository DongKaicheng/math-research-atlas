digraph "energy-and-equations-energy-panel-envelopes" {
graph [id="svg-energy-and-equations-energy-panel-envelopes",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-energy-mixed-energy" [id="energy-and-equations-energy-panel-envelopes-n-energy-mixed-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric mixed energy and<BR ALIGN="LEFT"/>Hölder</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:first-mixed-energy",tooltip="For actual first-energy potentials, B(u₀,…,u_q) is finite and symmetric in every slot. Positive energy matrices give Cauchy–Schwarz, the mixed Hölder inequality has constant one, and the energy root satisfies Minkowski. The associated tester and sharp midpoint estimates control strong discrepancy."];
"n-energy-completion" [id="energy-and-equations-energy-panel-envelopes-n-energy-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Complete relative first-energy<BR ALIGN="LEFT"/>space</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E02 · E03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:r11-strong-cauchy-uniform-tails",tooltip="Strongly Cauchy rows have uniform deep tails and global weighted tightness. Their relative Borel limits carry intrinsic currents and critical weighted limits. The completed cone C is complete, with strong convergence exactly equivalent to local truncated outer-capacity convergence together with energy convergence. A common lower barrier is not required for a Cauchy row."];
"n-energy-dual" [id="energy-and-equations-energy-panel-envelopes-n-energy-dual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Banach differences and closed<BR ALIGN="LEFT"/>sources</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:r12-energy-difference-Banach",tooltip="The actual Borel difference space D_S=C−C is Banach. The curvature functional J(u)(h)=B(h,u,…,u) is injective; its image is norm closed, and the dual distance between sources gives a complete metric inducing the strong topology on C. Closed image does not assert surjectivity onto the dual."];
"n-energy-perron-obstacles" [id="energy-and-equations-energy-panel-envelopes-n-energy-perron-obstacles",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Relative Perron envelopes and<BR ALIGN="LEFT"/>obstacle projection</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/8c6cc37f6c1d/#thm:r11-strong-completed-Perron",tooltip="A nonempty family in the completed cone has a relative least upper bound selected by an increasing sequence of finite maxima. Borel upper bounds and a common lower source inequality pass to this envelope. This constructs the greatest cone minorant P(f) for every f∈D_S, with energy-root and curvature estimates. The construction is relative; it supplies neither ambient upper-semicontinuous regularization nor automatic contact orthogonality."];
"n-energy-barrier-maximum" [id="energy-and-equations-energy-panel-envelopes-n-energy-barrier-maximum",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Unique constrained barrier<BR ALIGN="LEFT"/>maximizer</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/6b7d10538d79/#thm:r11-completed-barrier-maximizer",tooltip="For a fixed actual first-energy lower barrier a and finite positive Radon μ that ignores relative outer-capacity null sets and integrates −a, the completed interval [a,0] has a unique maximizer of the functional −e(v)/(q+1)−∫v dμ. Its Euler variational inequality characterizes maximality. The inequality does not assert the unrestricted source equation."];
"n-energy-rooftop-coefficient" [id="energy-and-equations-energy-panel-envelopes-n-energy-rooftop-coefficient",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Coefficient-one rooftop energy<BR ALIGN="LEFT"/>fails</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N04</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/be4285bb6048/#an-explicit-fixed-smooth-counterexample.",tooltip="In a two-dimensional original torus with q=1, explicit bounded actual obstacles and one smooth strongly positive background violate e(P(U,V))≤e(U)+e(V). The uniform binary coefficient 2 is sharp across the specified background class. This does not make 2 sharp for every fixed S and does not refute literal strong continuity or mixed-energy Hölder constant one."];
"n-energy-dual-shortcuts" [id="energy-and-equations-energy-panel-envelopes-n-energy-dual-shortcuts",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Dual and weak-compactness<BR ALIGN="LEFT"/>shortcuts fail</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N12</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/2c6d61773d7a/#prop:r12-completed-gauss-evaluation",tooltip="In the specified smooth torus model with 1≤q<r, canonical convex-trace evaluation is strongly continuous but is not literal integration on relative Borel classes. Literal positive data can converge in dual norm to this nonliteral functional when domination constants are not uniform. In a different radial-mixture background with n>q, an energy-bounded strongly convergent row has no Banach-weak convergent subnet. These examples preserve the fixed-domination closure theorem and closedness of the source image."];
"r-energy-r18-relative-envelopes" [id="energy-and-equations-energy-panel-envelopes-r-energy-r18-relative-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r18-relative-envelopes",tooltip="Use the same strict Laurent geometry, extending allowed S and completed relative Borel cone C; the envelope family is nonempty. For P(f), f is an actual Borel difference in D_S, so a difference decomposition supplies a cone minorant. Any retained upper obstacle is Borel and interpreted relatively, and any common lower source inequality uses a fixed positive Radon measure; no total-mass assumption is needed for that inequality. Select finite maxima whose energies approach the infimum. Strong completeness gives a limit; adjoining any further family member and using ordered energy separation proves least-upper-bound status. Apply this envelope to all cone minorants of f to obtain P(f); difference decompositions and mixed energy give its root and curvature estimates. Exceptional sets may depend on the family member, and no uncountable union of null sets is taken."];
"n-energy-completion" -> "r-energy-r18-relative-envelopes" [id="energy-and-equations-energy-panel-envelopes-input-energy-r18-relative-envelopes-energy-completion",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-dual" -> "r-energy-r18-relative-envelopes" [id="energy-and-equations-energy-panel-envelopes-input-energy-r18-relative-envelopes-energy-dual",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r18-relative-envelopes" -> "n-energy-perron-obstacles" [id="energy-and-equations-energy-panel-envelopes-output-energy-r18-relative-envelopes",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r19-barrier-variational" [id="energy-and-equations-energy-panel-envelopes-r-energy-r19-barrier-variational",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r19-barrier-variational",tooltip="Restrict to the completed order interval above one fixed actual first-energy barrier a and below zero. The datum μ is finite positive Radon, annihilates outer-capacity null sets and satisfies ∫(−a)dμ<∞. All competitors and maximizing rows belong to this constrained interval. Midpoint strictness makes a maximizing row strongly Cauchy. Barrier domination, finite measure and capacity diffuseness give L¹(μ) continuity, so the functional attains its maximum in the interval. First variation gives the Euler inequality and energy separation gives uniqueness. Passing from this constrained inequality to a source equation requires an additional contact or compatibility argument."];
"n-energy-completion" -> "r-energy-r19-barrier-variational" [id="energy-and-equations-energy-panel-envelopes-input-energy-r19-barrier-variational-energy-completion",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-mixed-energy" -> "r-energy-r19-barrier-variational" [id="energy-and-equations-energy-panel-envelopes-input-energy-r19-barrier-variational-energy-mixed-energy",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r19-barrier-variational" -> "n-energy-barrier-maximum" [id="energy-and-equations-energy-panel-envelopes-output-energy-r19-barrier-variational",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r20-sharp-rooftop" [id="energy-and-equations-energy-panel-envelopes-r-energy-r20-sharp-rooftop",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r20-sharp-rooftop",tooltip="For sharpness use n=2, q=1 on the original torus box, the explicit convex pyramid obstacles u_a,v_a and smooth strongly positive backgrounds S_(δ,ε). Identify the completed relative rooftop with the real convex envelope using the actual trace and energy arguments; do not assume trace injectivity. The constant is universal across these backgrounds; the chosen background may depend on the proposed constant below 2. The root rooftop bound r(P)≤r(U)+r(V) gives the upper coefficient 2. The explicit convex envelope and full original Green calibration concentrate energy along the diagonal, and the ratio tends to 2. A fixed smooth parameter choice already gives an exact positive gap against coefficient one. This rules out that rooftop shortcut without deciding the literal strong-continuity question."];
"n-energy-perron-obstacles" -> "r-energy-r20-sharp-rooftop" [id="energy-and-equations-energy-panel-envelopes-input-energy-r20-sharp-rooftop-energy-perron-obstacles",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-mixed-energy" -> "r-energy-r20-sharp-rooftop" [id="energy-and-equations-energy-panel-envelopes-input-energy-r20-sharp-rooftop-energy-mixed-energy",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r20-sharp-rooftop" -> "n-energy-rooftop-coefficient" [id="energy-and-equations-energy-panel-envelopes-output-energy-r20-sharp-rooftop",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r21-dual-boundaries" [id="energy-and-equations-energy-panel-envelopes-r-energy-r21-dual-boundaries",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r21-dual-boundaries",tooltip="For nonliteral evaluation use the smooth torus trace model S=β^(r−q)[V] with 1≤q<r, its canonical finite convex traces, and proper-moment fibers of zero full outer capacity. The approximating literal data are μ_ε≤c_ε μ_ψ for one fixed source, but c_ε is not uniformly bounded; they are not members of the nonlinear source image. For nonreflexivity use the different radial-mixture background (PO3), n>q≥1, and its proved pole functional on both Banach realizations. Canonical trace evaluation is strong-continuous, whereas changing a Borel representative at a null Gauss point prevents literal Dirac integration. Smoothing the trace evaluation gives dual-norm convergence of literal data to that nonliteral limit. In the separate radial example, source functionals force any weak limit to equal the strong limit, while the pole functional gives contradictory values. Thus neither unrestricted dual identification nor weak compactness follows from the Banach and strong-completion theorems."];
"n-energy-completion" -> "r-energy-r21-dual-boundaries" [id="energy-and-equations-energy-panel-envelopes-input-energy-r21-dual-boundaries-energy-completion",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-dual" -> "r-energy-r21-dual-boundaries" [id="energy-and-equations-energy-panel-envelopes-input-energy-r21-dual-boundaries-energy-dual",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r21-dual-boundaries" -> "n-energy-dual-shortcuts" [id="energy-and-equations-energy-panel-envelopes-output-energy-r21-dual-boundaries",style="dashed",color="#64757c",arrowhead="normal",];
}
