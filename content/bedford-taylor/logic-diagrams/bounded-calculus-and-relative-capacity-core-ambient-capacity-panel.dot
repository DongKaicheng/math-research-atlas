digraph "bounded-calculus-and-relative-capacity-core-ambient-capacity-panel" {
graph [id="svg-bounded-calculus-and-relative-capacity-core-ambient-capacity-panel",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-core-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-n-core-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric bounded calculus and<BR ALIGN="LEFT"/>CLN bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02 · B02 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#cor:full-calculus",tooltip="Ordered products become symmetric in their potential slots, while retaining positivity, separate closedness, ordinary locality and weighted decreasing continuity. Relative CLN bounds control compact coefficient mass. This node does not yet assert that changing a potential while preserving its curvature leaves every background product unchanged."];
"n-core-compact-gap-comparison" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-n-core-compact-gap-comparison",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Comparison under a compact<BR ALIGN="LEFT"/>boundary gap</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#thm:relative-comparison",tooltip="If the ordinary closure of every strict gap {u < v-epsilon} is compactly contained in V, then the top relative measure of v on {u < v} is at most that of u there. The proof uses maximum locality and the bounded calculus; it requires no capacity theorem or strictly psh exhaustion."];
"n-core-ambient-no-jump" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-n-core-ambient-no-jump",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ambient input N: envelopes and<BR ALIGN="LEFT"/>negligible defects</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#thm:r2-negligible-outer-zero",tooltip="For the ambient background [1], the defect between the supremum of a locally uniformly upper-bounded classical family and its ordinary upper regularization is locally outer-null. Increasing families have no jump at ambient divisorial points. Local and fixed-domain null ideals are compared through the stated separate theorem."];
"n-core-ambient-extremals" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-n-core-ambient-extremals",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ambient input E: open and<BR ALIGN="LEFT"/>compact extremals</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#thm:r2-open-extremal",tooltip="For an ordinary open G compactly contained in the specified negative-exhaustion domain V, its extremal equals -1 on G, has ordinary zero boundary value and compactly supported Monge–Ampere measure, and its total mass equals the capacity of G. Compact extremals have the corresponding total-mass identity."];
"n-core-ambient-polarity" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-n-core-ambient-polarity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ambient outer-null, polar and<BR ALIGN="LEFT"/>negligible sets</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/ba0544927cad/#thm:r2-capacity-zero-polar-witness",tooltip="An outer-null subset of a relatively compact core has a nontrivial pole witness on the qualified exhaustion domain. Local ambient outer-nullity, local pluripolarity and local negligibility therefore agree. A single global pole witness on an arbitrary analytic space is not asserted."];
"n-core-ambient-extremal-mass" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-n-core-ambient-extremal-mass",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Outer capacity equals ambient<BR ALIGN="LEFT"/>extremal total mass</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/ba0544927cad/#thm:r2-arbitrary-extremal-mass",tooltip="For every arbitrary subset A of a relatively compact core in the qualified domain, its ambient outer capacity is the total Monge–Ampere mass of the upper-regularized extremal U_A. This theorem does not assume A is Borel or identify raw and outer capacity beforehand."];
"n-core-ambient-increasing-capacity" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-n-core-ambient-increasing-capacity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Increasing continuity on<BR ALIGN="LEFT"/>arbitrary ambient sets</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/ba0544927cad/#thm:r2-outer-capacity-increasing-sets",tooltip="On each fixed relatively compact core, ambient outer capacity is continuous from below on arbitrary increasing sets. The proof uses increasing ordinary open sublevel covers of extremals, not a Borel-cover substitution for the ordinary-open definition."];
"n-core-ambient-choquet" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-n-core-ambient-choquet",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Qualified ambient Choquet and<BR ALIGN="LEFT"/>Borel regularity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/ba0544927cad/#cor:r2-local-choquet",tooltip="On a fixed relatively compact core of the specified exhaustion domain, ambient outer capacity is a finite Choquet capacity. Suslin sets are capacitable; Borel sets have equal raw and outer capacities. These conclusions retain S=[1] and the domain hypotheses."];
"r-core-r28-ambient-pole-witness" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-r-core-r28-ambient-pole-witness",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r28-ambient-pole-witness",tooltip="The background is [1]. V is a connected ordinary open with compact closure in a smooth affine algebraic chart, nonempty ordinary boundary, and a bounded continuous negative classical exhaustion rho extending continuously as zero on that boundary. For a witness, E lies in W compactly contained in V and has fixed-domain ambient outer capacity zero. Use the established ambient increasing calculus, pointwise ambient domination, and local/fixed-domain null comparison. For the reverse implication use the already established ambient polar-to-outer-null theorem; local equivalence does not assert unrestricted global pole patching. Choose decreasing ordinary open covers of E with capacities tending to zero. Their extremals increase; the N and E inputs plus the adopted increasing calculus give a zero-mass upper-regularized limit. Ambient pointwise domination makes that limit zero. No jump at a fixed divisorial point allows a subsequence whose negative sum stays finite there but equals minus infinity on E. The existing polar-null implication and local arguments give the equivalence."];
"n-core-ambient-no-jump" -> "r-core-r28-ambient-pole-witness" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r28-ambient-pole-witness-core-ambient-no-jump",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-ambient-extremals" -> "r-core-r28-ambient-pole-witness" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r28-ambient-pole-witness-core-ambient-extremals",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-bounded-calculus" -> "r-core-r28-ambient-pole-witness" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r28-ambient-pole-witness-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r28-ambient-pole-witness" -> "n-core-ambient-polarity" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-output-core-r28-ambient-pole-witness",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r29-ambient-extremal-formula" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-r-core-r29-ambient-extremal-formula",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r29-ambient-extremal-formula",tooltip="Use S=[1] and the same qualified negative-exhaustion domain. A is any subset of a fixed W compactly contained in V; keep V as the admissibility domain. Use the total-mass order for bounded negative classical functions with ordinary zero boundary limit; retain the upper-regularized extremal U_A rather than its raw supremum. An open cover G gives U_G<=U_A, so total-mass order yields one inequality. Input N says A misses the -1 contact set of U_A only on an outer-null set. The truncation max(-1,U_A/(1-eta)) controls the ordinary open sublevel {U_A<-1+eta}; its mass bound gives the reverse inequality as eta tends to zero. No pole-witness theorem is used."];
"n-core-ambient-no-jump" -> "r-core-r29-ambient-extremal-formula" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r29-ambient-extremal-formula-core-ambient-no-jump",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-ambient-extremals" -> "r-core-r29-ambient-extremal-formula" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r29-ambient-extremal-formula-core-ambient-extremals",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-compact-gap-comparison" -> "r-core-r29-ambient-extremal-formula" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r29-ambient-extremal-formula-core-compact-gap-comparison",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r29-ambient-extremal-formula" -> "n-core-ambient-extremal-mass" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-output-core-r29-ambient-extremal-formula",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r30-ambient-increasing-capacity" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-r-core-r30-ambient-increasing-capacity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r30-ambient-increasing-capacity",tooltip="A_j are arbitrary increasing subsets of one relatively compact core W in the same qualified domain V, with S=[1]. Use countable outer subadditivity and raw-capacity continuity from below only for Borel sets, in particular ordinary open sets. The extremals U_(A_j) decrease. Cover their countably many negligible contact defects by one ordinary open set of arbitrarily small capacity. Its union with {U_(A_j)<-1+eta} gives increasing ordinary open covers. The extremal mass estimate controls their capacities; raw continuity on these opens then gives the desired outer-capacity limit."];
"n-core-ambient-no-jump" -> "r-core-r30-ambient-increasing-capacity" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r30-ambient-increasing-capacity-core-ambient-no-jump",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-ambient-extremal-mass" -> "r-core-r30-ambient-increasing-capacity" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r30-ambient-increasing-capacity-core-ambient-extremal-mass",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r30-ambient-increasing-capacity" -> "n-core-ambient-increasing-capacity" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-output-core-r30-ambient-increasing-capacity",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r31-ambient-choquet" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-r-core-r31-ambient-choquet",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r31-ambient-choquet",tooltip="Retain S=[1] and a fixed relatively compact ordinary core W in the specified negative-exhaustion domain. This core is locally compact, second countable and metrizable in the fixed finite p-adic algebraic setting. Use the established outer-capacity continuity from above on decreasing compact sets, compact finiteness, and the classical Choquet capacitability theorem. The new increasing continuity supplies the missing Choquet axiom. The arbitrary-set mass formula and compact extremal identity identify raw and outer capacity on compact sets. Choquet capacitability handles Suslin sets. On Borel sets, Radon inner regularity permits interchanging two suprema, yielding raw/outer equality. The qualified ambient theorem leaves the general relative CAP-BOREL question open."];
"n-core-ambient-extremals" -> "r-core-r31-ambient-choquet" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r31-ambient-choquet-core-ambient-extremals",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-ambient-extremal-mass" -> "r-core-r31-ambient-choquet" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r31-ambient-choquet-core-ambient-extremal-mass",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-ambient-increasing-capacity" -> "r-core-r31-ambient-choquet" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-input-core-r31-ambient-choquet-core-ambient-increasing-capacity",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r31-ambient-choquet" -> "n-core-ambient-choquet" [id="bounded-calculus-and-relative-capacity-core-ambient-capacity-panel-output-core-r31-ambient-choquet",style="solid",color="#315e50",arrowhead="normal",];
}
