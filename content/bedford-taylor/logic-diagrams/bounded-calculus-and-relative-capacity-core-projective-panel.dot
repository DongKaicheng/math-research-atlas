digraph "bounded-calculus-and-relative-capacity-core-projective-panel" {
graph [id="svg-bounded-calculus-and-relative-capacity-core-projective-panel",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-core-approachable-calculus" [id="bounded-calculus-and-relative-capacity-core-projective-panel-n-core-approachable-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous calculus for<BR ALIGN="LEFT"/>approachable potentials</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/83153cdc67ad/#prop:fixed-potential",tooltip="For continuous potentials already locally approximable uniformly by smooth positive potentials, insertion into a positive separately closed background preserves positivity and closedness. It is jointly continuous for locally uniform potentials and weakly converging positive closed backgrounds; successive insertions are symmetric."];
"n-core-projective-curves" [id="bounded-calculus-and-relative-capacity-core-projective-panel-n-core-projective-curves",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>One normalized<BR ALIGN="LEFT"/>complete-intersection curve at a<BR ALIGN="LEFT"/>time</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/83153cdc67ad/#prop:curve-approximation",tooltip="On a smooth projective variety, a mixed current of uniform Fubini–Study limits on ample lines is a weak limit of individual normalized smooth complete-intersection curves over the original field. Every member retains the specified normalized intersection degrees."];
"n-core-contact-rigidity" [id="bounded-calculus-and-relative-capacity-core-projective-panel-n-core-contact-rigidity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Zero contact identifies the<BR ALIGN="LEFT"/>upper metric</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/83153cdc67ad/#thm:contact",tooltip="A finite continuous curve-positive metric above a uniform Fubini–Study lower metric on an ample line equals it when their gap has zero integral against the lower Monge–Ampere measure. Only the lower metric needs its higher-dimensional product in advance."];
"n-core-regular-test-ideals" [id="bounded-calculus-and-relative-capacity-core-projective-panel-n-core-regular-test-ideals",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Uniform test-ideal control on a<BR ALIGN="LEFT"/>regular model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/83153cdc67ad/#prop:test-ideal-estimate",tooltip="Weighted test ideals give one degree-independent vertical error and global generation after one fixed ample twist. After dividing weights by their degree, the error is O(1/m). These are the algebraic estimates used to construct the regular-model envelope."];
"n-core-regular-envelopes" [id="bounded-calculus-and-relative-capacity-core-projective-panel-n-core-regular-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Continuous orthogonal envelopes<BR ALIGN="LEFT"/>on regular models</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/83153cdc67ad/#thm:envelope",tooltip="For a regular integral projective flat model with smooth generic fibre and an ample rational line, every finite continuous obstacle has a continuous orthogonal envelope and uniform pure-Fubini–Study approximation. Model obstacles have the stated one-sided O(1/m) approximation."];
"n-core-projective-criterion" [id="bounded-calculus-and-relative-capacity-core-projective-panel-n-core-projective-criterion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Four equivalent forms of<BR ALIGN="LEFT"/>projective semipositivity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">R04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/83153cdc67ad/#cor:projective-criterion",tooltip="Under the regular-model and ample-line hypotheses, curve positivity, positivity of the original CLD Chern current, uniform Fubini–Study approximability, and uniform approximation by global smooth positive metrics are equivalent for a finite continuous metric."];
"n-core-normal-correction" [id="bounded-calculus-and-relative-capacity-core-projective-panel-n-core-normal-correction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>One fixed vertical correction on<BR ALIGN="LEFT"/>a normal model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/0478f925f64f/#thm:fixed-correction",tooltip="On the specified normal model, one power of the uniformizer corrects test-ideal subadditivity for every coherent ideal pair and rational exponent. The exponent is chosen before those ideals and exponents; regular-model uncorrected subadditivity alone does not provide this assertion."];
"n-core-normal-envelopes" [id="bounded-calculus-and-relative-capacity-core-projective-panel-n-core-normal-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Ample envelopes through a normal<BR ALIGN="LEFT"/>model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B05</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/0478f925f64f/#thm:normal-envelope",tooltip="For a smooth projective geometrically integral generic fibre and an ample line, the continuous-obstacle envelope is continuous, model-semipositive on the same line, uniformly approximable by nef rational model metrics, and orthogonal. Its proof uses the separate fixed-correction theorem."];
"r-core-r16-projective-curves" [id="bounded-calculus-and-relative-capacity-core-projective-panel-r-core-r16-projective-curves",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r16-projective-curves",tooltip="Y is smooth projective of dimension n>=2; the n-1 line bundles are ample rational lines and their metrics are uniform Fubini–Study limits. Use characteristic-zero Bertini over K, the original calibrated Poincare–Lelong formula, and the total-variation nullity of tie hyperplanes for each smooth test. Choose generating sections with prescribed distinct coefficient valuations. For each smooth test, ties have zero mass eventually and the one-cut Poincare–Lelong error is O(1/N). Successive smooth cuts and continuity in the positive background give a net of individual normalized complete-intersection curves. Normalized degrees are preserved algebraically at every cut."];
"n-core-approachable-calculus" -> "r-core-r16-projective-curves" [id="bounded-calculus-and-relative-capacity-core-projective-panel-input-core-r16-projective-curves-core-approachable-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r16-projective-curves" -> "n-core-projective-curves" [id="bounded-calculus-and-relative-capacity-core-projective-panel-output-core-r16-projective-curves",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r17-contact-rigidity" [id="bounded-calculus-and-relative-capacity-core-projective-panel-r-core-r17-contact-rigidity",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r17-contact-rigidity",tooltip="Y is smooth projective integral of positive dimension; L is ample; the lower metric p is a uniform Fubini–Study limit and the upper metric r is finite continuous and positive on every smooth algebraic curve map. Assume r>=p and integral (r-p)c1(L,p)^n = 0. Use curve Green identities and the smooth-divisor concentration lemma; in dimension one use the curve argument directly. Normalized curves give positive upper comparison measures with controlled total variation. Zero contact makes the mixed energy vanish; testing its quadratic perturbation annihilates the mixed Laplacian. Divisor concentration transfers contact to smooth hyperplane sections, and dimension induction plus density of rigid points proves r=p."];
"n-core-projective-curves" -> "r-core-r17-contact-rigidity" [id="bounded-calculus-and-relative-capacity-core-projective-panel-input-core-r17-contact-rigidity-core-projective-curves",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-approachable-calculus" -> "r-core-r17-contact-rigidity" [id="bounded-calculus-and-relative-capacity-core-projective-panel-input-core-r17-contact-rigidity-core-approachable-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r17-contact-rigidity" -> "n-core-contact-rigidity" [id="bounded-calculus-and-relative-capacity-core-projective-panel-output-core-r17-contact-rigidity",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r18-regular-envelopes" [id="bounded-calculus-and-relative-capacity-core-projective-panel-r-core-r18-regular-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r18-regular-envelopes",tooltip="The model is regular, integral, projective and flat over the original valuation ring, with smooth generic fibre; L is an ample rational line and the obstacle is finite continuous. Use density of model metrics, the envelope Lipschitz estimate, and the cited orthogonality theorem for geometrically reduced generic fibres, with its measure identified with the CLD product. Global generation produces Fubini–Study metrics on the degree-m line plus a fixed auxiliary line. A fixed complementary generating tuple removes that twist. The test-ideal bounds and the envelope property give a one-sided O(1/m) error for model obstacles. Uniform density extends continuity and approximation to continuous obstacles; the cited orthogonality theorem supplies the contact integral."];
"n-core-regular-test-ideals" -> "r-core-r18-regular-envelopes" [id="bounded-calculus-and-relative-capacity-core-projective-panel-input-core-r18-regular-envelopes-core-regular-test-ideals",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r18-regular-envelopes" -> "n-core-regular-envelopes" [id="bounded-calculus-and-relative-capacity-core-projective-panel-output-core-r18-regular-envelopes",style="dashed",color="#64757c",arrowhead="normal",];
"r-core-r19-projective-criterion" [id="bounded-calculus-and-relative-capacity-core-projective-panel-r-core-r19-projective-criterion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r19-projective-criterion",tooltip="Retain the regular integral projective flat model, smooth positive-dimensional generic fibre, ample line and finite continuous metric r. Use smooth approximation of Fubini–Study metrics and the curve-restriction theorem for a current-positive continuous weight; clear any rational tensor denominator. For curve-positive r, the envelope p is semipositive, lies below r and is orthogonal. Contact rigidity forces r=p. Smooth Fubini–Study approximation then gives smooth positive approximation and current positivity; curve restriction closes the reverse implication. The envelope and contact results are joint inputs."];
"n-core-regular-envelopes" -> "r-core-r19-projective-criterion" [id="bounded-calculus-and-relative-capacity-core-projective-panel-input-core-r19-projective-criterion-core-regular-envelopes",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-contact-rigidity" -> "r-core-r19-projective-criterion" [id="bounded-calculus-and-relative-capacity-core-projective-panel-input-core-r19-projective-criterion-core-contact-rigidity",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r19-projective-criterion" -> "n-core-projective-criterion" [id="bounded-calculus-and-relative-capacity-core-projective-panel-output-core-r19-projective-criterion",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r20-normal-envelopes" [id="bounded-calculus-and-relative-capacity-core-projective-panel-r-core-r20-normal-envelopes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 05</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r20-normal-envelopes",tooltip="Use a normal integral projective flat model over the complete mixed-characteristic valuation ring, with smooth projective geometrically integral generic fibre and ample L. After the specified canonical-sheaf modification, choose an effective vertical Delta_0 with K+Delta_0 Cartier; use the stated test-ideal birational, summation and generation theorems. Use density of model metrics and the cited envelope orthogonality theorem; no regular-model resolution hypothesis is silently imposed on this normal-model proof. Iterating the same fixed vertical correction gives an O(1/m) lower estimate for weighted asymptotic test ideals. A fixed birational upper error and one fixed ample generation twist give the upper estimate. Cancelling the auxiliary line and dividing by degree gives uniform approximation on the original identified L; density and orthogonality finish the continuous-obstacle statement."];
"n-core-normal-correction" -> "r-core-r20-normal-envelopes" [id="bounded-calculus-and-relative-capacity-core-projective-panel-input-core-r20-normal-envelopes-core-normal-correction",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r20-normal-envelopes" -> "n-core-normal-envelopes" [id="bounded-calculus-and-relative-capacity-core-projective-panel-output-core-r20-normal-envelopes",style="dashed",color="#64757c",arrowhead="normal",];
}
