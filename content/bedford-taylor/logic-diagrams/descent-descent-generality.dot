digraph "descent-descent-generality" {
graph [id="svg-descent-descent-generality",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-d-weak-class" [id="descent-descent-generality-n-d-weak-class",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Descent over weakly approximable<BR ALIGN="LEFT"/>backgrounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/fb87839085e5/#def:r6-delta-weak-closure",tooltip="For S in W_loc, actual delta-form action is presentation independent, local and compatible with full first derivatives. W_loc uses weak convergence on all original smooth tests on one fixed ordinary domain, allowing nets. Fixed continuous curvature slots preserve the required weak convergence; bounded BT tails remain in the class."];
"n-d-background-density" [id="descent-descent-generality-n-d-background-density",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Every allowed background lies in<BR ALIGN="LEFT"/>W_loc</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G02 · O01</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#question:background-density",tooltip="The proposed density theorem would put each arbitrary symmetric middle-positive, separately closed original background in the same-domain weak closure of actual positive closed delta-form backgrounds. Existing potential, cap and geometric examples do not establish this assertion for an arbitrary current."];
"n-d-general-descent" [id="descent-descent-generality-n-d-general-descent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>General actual-relation descent</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O01 · O02</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#conj:descent",tooltip="For every admissible finite actual curvature relation of every degree b, choose an ordinary representative for the relation before S and tests, and prove A_S(P) = 0 for all legal backgrounds and all actual refinements. The general quadratic case remains open; low-rank and supplied-model conclusions retain their hypotheses."];
"n-d-differential-interfaces" [id="descent-descent-generality-n-d-differential-interfaces",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Higher and coefficient<BR ALIGN="LEFT"/>interfaces</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O06</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#problem:interfaces",tooltip="A general differential calculus still needs presentation independence for variable finite PS coefficients and higher coupled tails, the differential identities, the intended delta-test extension, and gluing and naturality in the stated mapping class. One common BT tail can be absorbed into S; different termwise tails cannot be absorbed by that argument."];
"n-d-model-descent" [id="descent-descent-generality-n-d-model-descent",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Full quadratic descent in this<BR ALIGN="LEFT"/>model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G11 · O07</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#thm:punctured",tooltip="If the open cancellation assertion is proved throughout the supplied normal-three class, its quadratic actual zeros have zero action on U in both legal degrees p = 0 and p = 1. This is a specific conditional target. It neither returns the model to every original germ nor settles higher coupled or variable-coefficient relations."];
"n-d-shortcut-limits" [id="descent-descent-generality-n-d-shortcut-limits",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Why shortcut arguments stop</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G03 · G04 · N07 · N08 · N09 · N10 · N11</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/3a68e09b5f7a/#sec:r18-intrinsic-normal-current",tooltip="Normal-current constructions retain a harmonic boundary defect; scalar harmonic identifications do not supply a missing continuous potential. N07 excludes an automatic continuous smooth-form double primitive. N08 gives a real Killing-gluing obstruction, N09 retains graph Hessian-wall drift, N10 obstructs stronger residue-section and whole-central-fiber Hensel lifts, and N11 shows that O(r²) growth can retain a point residual. These examples do not refute the actual analytic-zero conjecture."];
"r-d-e-density-route" [id="descent-descent-generality-r-d-e-density-route",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-density-route",tooltip="Assume the open density statement for every allowed background in every legal degree on fixed ordinary representatives, with convergence against all original compact smooth tests. Keep the admissible finite continuous PL/PS scalar presentation fixed while the positive separately closed backgrounds vary; apply the established fixed-slot and compatible-PS continuity. For actual delta-form backgrounds the zero relation has zero product. On a fixed local domain, pass each term of the finite expression through the established weak-continuity theorem. This kills actual zero presentations for S; subtracting presentations and ordinary locality give descent. This route does not require an exactness certificate for each relation."];
"n-d-weak-class" -> "r-d-e-density-route" [id="descent-descent-generality-input-d-e-density-route-d-weak-class",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-d-background-density" -> "r-d-e-density-route" [id="descent-descent-generality-input-d-e-density-route-d-background-density",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-density-route" -> "n-d-general-descent" [id="descent-descent-generality-output-d-e-density-route",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-model-to-general" [id="descent-descent-generality-r-d-e-model-to-general",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-descent-d-e-model-to-general",tooltip="A new return theorem must cover arbitrary original ordinary germs, including higher joint residue rank and model data not supplied in advance. Higher degrees need treatment of coupled relations with different termwise tails; a common-tail absorption argument only treats its stated subclass. Preserve the original field, all original tests and actual refinements, and choose the ordinary relation neighborhood before S and tests. Even complete cancellation would settle the quadratic supplied normal-three case. These missing general-germ and higher-degree bridges are additional research tasks; no implication from that model theorem alone to REL-ALL is claimed."];
"n-d-model-descent" -> "r-d-e-model-to-general" [id="descent-descent-generality-input-d-e-model-to-general-d-model-descent",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-model-to-general" -> "n-d-general-descent" [id="descent-descent-generality-output-d-e-model-to-general",style="dashed",color="#76518c",arrowhead="normal",];
"r-d-e-interface-step" [id="descent-descent-generality-r-d-e-interface-step",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-descent-d-e-interface-step",tooltip="Even after pure scalar relation descent, specify and prove the variable-coefficient quotient and the differential identities in their object sheaves. Establish the intended enlarged delta-test action, ordinary gluing and naturality for an explicit mapping class; equality on smooth tests alone does not define that extension. Scalar descent would make its curvature expressions presentation independent. Variable PS coefficients, differential operations and enlarged tests ask for separate compatibility statements, so neither low-rank descent nor central cancellation supplies this interface automatically."];
"n-d-general-descent" -> "r-d-e-interface-step" [id="descent-descent-generality-input-d-e-interface-step-d-general-descent",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-interface-step" -> "n-d-differential-interfaces" [id="descent-descent-generality-output-d-e-interface-step",style="dashed",color="#76518c",arrowhead="normal",];
"r-d-e-return-obstructions" [id="descent-descent-generality-r-d-e-return-obstructions",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#9a4b30"><B>Blocks this shortcut 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fffef9",URL="#logic-descent-d-e-return-obstructions",tooltip="The proposed shortcut strengthens finite original-unit lifting into a relation-preserving residue-field section, or extends a selected Hensel logarithm continuously over the entire central moment image. The cited obstructions concern these stronger constructions, not every possible route to actual-relation descent. The residue-field example has no rational coefficient-field section and even a displayed pair of units cannot lift with its prescribed equation. The Hensel example has two approaching branches with incompatible limiting norms after any finite unit refinement. A general return theorem must respect these failures rather than assume those stronger lifts."];
"n-d-shortcut-limits" -> "r-d-e-return-obstructions" [id="descent-descent-generality-input-d-e-return-obstructions-d-shortcut-limits",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-return-obstructions" -> "n-d-general-descent" [id="descent-descent-generality-output-d-e-return-obstructions",style="solid",color="#9a4b30",arrowhead="tee",];
}
