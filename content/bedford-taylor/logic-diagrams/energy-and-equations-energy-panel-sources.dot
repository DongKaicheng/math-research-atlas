digraph "energy-and-equations-energy-panel-sources" {
graph [id="svg-energy-and-equations-energy-panel-sources",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-energy-dual" [id="energy-and-equations-energy-panel-sources-n-energy-dual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Banach differences and closed<BR ALIGN="LEFT"/>sources</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:r12-energy-difference-Banach",tooltip="The actual Borel difference space D_S=C−C is Banach. The curvature functional J(u)(h)=B(h,u,…,u) is injective; its image is norm closed, and the dual distance between sources gives a complete metric inducing the strong topology on C. Closed image does not assert surjectivity onto the dual."];
"n-energy-strong-datum" [id="energy-and-equations-energy-panel-sources-n-energy-strong-datum",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Literal, strongly continuous<BR ALIGN="LEFT"/>datum</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q04 · O04</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#def:r12-strong-continuous-dual",tooltip="The positive Radon measure μ defines ℓ_μ(h)=−∫h dμ literally on every Borel difference in D_S: absolute integrability, independence of relative-null representatives, norm boundedness and strong continuity on C are all required. Fixed completed-source domination is one proved sufficient condition. Norm boundedness alone is the open ED-STRONG question."];
"n-energy-projection" [id="energy-and-equations-energy-panel-sources-n-energy-projection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Projection and a normal residual</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q02</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:r12-nonlinear-normal-decomposition",tooltip="For a strongly continuous dual datum, maximizing ℓ(v)−e(v)/(q+1) on C gives a unique u=Π(ℓ). Its decomposition ℓ=J(u)+n satisfies n(v)≤0 on C and n(u)=0. The source equation still requires the residual to vanish in the appropriate literal sense."];
"n-energy-probe" [id="energy-and-equations-energy-panel-sources-n-energy-probe",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>One probe with both test<BR ALIGN="LEFT"/>directions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:geometric-compensators",tooltip="The strict Laurent geometry supplies a single bounded continuous negative classical ψ₀. For every original compact smooth scalar φ, both ψ₀+ε_φφ and ψ₀−ε_φφ lie in the actual first-energy cone for some ε_φ>0. The same probe works for every extending allowed background."];
"n-energy-defect-zero" [id="energy-and-equations-energy-panel-sources-n-energy-defect-zero",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Additional compatibility: Ξ=0</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03 · O05</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:single-probe",tooltip="For the normal pair of a literal strongly continuous positive datum, Ξ=J(Πℓ_μ)(ψ₀)−ℓ_μ(ψ₀)=−n(ψ₀) is nonnegative. Requiring Ξ=0 is the extra compatibility condition. Strong continuity and fixed-source domination do not force this equality."];
"n-energy-source-solution" [id="energy-and-equations-energy-panel-sources-n-energy-source-solution",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Unique source solution in the<BR ALIGN="LEFT"/>completed cone</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:single-probe",tooltip="Under the literal strong-dual hypotheses, Ξ=0 if and only if μ̂_{Πℓ_μ}=μ, if and only if some v∈C has source μ. Any solution equals Πℓ_μ. More generally, every compact original test error is bounded by ε_φ⁻¹Ξ. This is an exact compatibility criterion, not an assertion that arbitrary data are compatible."];
"n-energy-source-gap" [id="energy-and-equations-energy-panel-sources-n-energy-source-gap",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Smooth dominated data can have<BR ALIGN="LEFT"/>Ξ&gt;0</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N06</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/835cdc44e503/#the-fixed-original-source-counterexample",tooltip="In a fixed two-dimensional torus model with q=1, smooth positive densities f_j→1 uniformly can make f_jμ_w leave the entire strong-completion source image, even at a fixed reference admitting every two-sided compact test direction. These data remain literal, strongly continuous and uniformly source dominated. Their zero-boundary Poisson traces fail convexity."];
"n-energy-compatible-classes" [id="energy-and-equations-energy-panel-sources-n-energy-compatible-classes",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#76518c">OPEN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Find source conditions from the<BR ALIGN="LEFT"/>data</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">O05</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#f4eff8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#problem:sources",tooltip="Find substantial geometric classes of given μ for which strong continuity and Ξ=0 follow from checkable input conditions. A local inverse route needs a specified linearized range, a right inverse with boundary and moment estimates, and preservation of that range by the nonlinear remainder. Assuming an unknown solution would restate the goal."];
"r-energy-r4-fixed-domination" [id="energy-and-equations-energy-panel-sources-r-energy-r4-fixed-domination",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r4-fixed-domination",tooltip="Keep one fixed strict Laurent geometry and background S. Supply a completed reference potential v∈C and a finite constant M≥0 with 0≤μ≤M μ̂_v as Radon measures on every Borel set. Mixed Hölder proves literal integrability and the norm bound on every difference. Domination transfers the completed tester estimate to ∫|u_j−u| dμ, proving strong L¹ continuity. The fixed dominated interval is also weak-star compact and norm closed. This route supplies strong continuity but does not supply Ξ=0."];
"n-energy-dual" -> "r-energy-r4-fixed-domination" [id="energy-and-equations-energy-panel-sources-input-energy-r4-fixed-domination-energy-dual",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r4-fixed-domination" -> "n-energy-strong-datum" [id="energy-and-equations-energy-panel-sources-output-energy-r4-fixed-domination",style="solid",color="#315e50",arrowhead="normal",];
"r-energy-r5-literal-continuity-open" [id="energy-and-equations-energy-panel-sources-r-energy-r5-literal-continuity-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r5-literal-continuity-open",tooltip="Fix S and the strict Laurent geometry, and let μ be positive Radon, annihilate the relative null ideal, and define an absolutely integrable norm-bounded literal functional on all of D_S. No fixed-source domination and no additional finite-total-mass assumption is available. Missing: prove ∫|u_j−u| dμ→0 for every strongly convergent row in C, including a general nonzero limit; a qualified ordered-rooftop or finite-minorant estimate is a proposed route. ED-STRONG asks whether literal norm boundedness already implies the continuity needed for the variational datum. It is a separate unresolved route to the same condition supplied by fixed domination. Nonliteral dual counterexamples and varying-background estimates do not settle this fixed-background literal question."];
"n-energy-dual" -> "r-energy-r5-literal-continuity-open" [id="energy-and-equations-energy-panel-sources-input-energy-r5-literal-continuity-open-energy-dual",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r5-literal-continuity-open" -> "n-energy-strong-datum" [id="energy-and-equations-energy-panel-sources-output-energy-r5-literal-continuity-open",style="dashed",color="#76518c",arrowhead="normal",];
"r-energy-r6-projection" [id="energy-and-equations-energy-panel-sources-r-energy-r6-projection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r6-projection",tooltip="Work on the same complete cone C with the established sharp midpoint estimate and completed energy continuity. The datum belongs to the norm dual and is strongly continuous on C; literal positive data are the source-equation subclass used here. The dual norm bounds the energies of maximizing rows. The midpoint gap makes those rows strongly Cauchy. Completeness gives a limit, and strong continuity passes the datum term. First variations only along segments in C give the polar normal n; they do not assert arbitrary two-sided variations at the optimizer."];
"n-energy-dual" -> "r-energy-r6-projection" [id="energy-and-equations-energy-panel-sources-input-energy-r6-projection-energy-dual",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-strong-datum" -> "r-energy-r6-projection" [id="energy-and-equations-energy-panel-sources-input-energy-r6-projection-energy-strong-datum",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r6-projection" -> "n-energy-projection" [id="energy-and-equations-energy-panel-sources-output-energy-r6-projection",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r7-zero-defect-solves" [id="energy-and-equations-energy-panel-sources-r-energy-r7-zero-defect-solves",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r7-zero-defect-solves",tooltip="Use the normal pair u=Π(ℓ_μ), n=ℓ_μ−J(u) for the literal positive Radon datum in the fixed geometry. For every original compact smooth φ, both ψ₀±ε_φφ are admissible, and the two probe integrals defining Ξ are finite. Impose the additional equality Ξ=−n(ψ₀)=0. Testing the normal inequality in both probe directions gives |n(φ)|≤ε_φ⁻¹Ξ. Zero defect therefore kills every original scalar test error; literal integration and Radon uniqueness identify μ̂_u=μ. Variational uniqueness identifies every solution with u. The same theorem proves the converse: existence of a source solution forces Ξ=0, so zero defect and solvability are equivalent under these hypotheses."];
"n-energy-projection" -> "r-energy-r7-zero-defect-solves" [id="energy-and-equations-energy-panel-sources-input-energy-r7-zero-defect-solves-energy-projection",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-probe" -> "r-energy-r7-zero-defect-solves" [id="energy-and-equations-energy-panel-sources-input-energy-r7-zero-defect-solves-energy-probe",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-strong-datum" -> "r-energy-r7-zero-defect-solves" [id="energy-and-equations-energy-panel-sources-input-energy-r7-zero-defect-solves-energy-strong-datum",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-defect-zero" -> "r-energy-r7-zero-defect-solves" [id="energy-and-equations-energy-panel-sources-input-energy-r7-zero-defect-solves-energy-defect-zero",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r7-zero-defect-solves" -> "n-energy-source-solution" [id="energy-and-equations-energy-panel-sources-output-energy-r7-zero-defect-solves",style="solid",color="#315e50",arrowhead="normal",];
"r-energy-r8-nonzero-defect-obstruction" [id="energy-and-equations-energy-panel-sources-r-energy-r8-nonzero-defect-obstruction",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#9a4b30"><B>Blocks this shortcut 05</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r8-nonzero-defect-obstruction",tooltip="Use the fixed q=1 two-dimensional torus background and a bounded actual admissible reference w<0, with finite total source mass, compact strict negative sublevels, canonical no loss, and all two-sided compact test directions. The counterexample data are μ_j=f_jμ_w, with 1≤f_j≤3/2 and f_j→1 uniformly; they remain literal and strongly continuous. A source in the full completed cone would have a convex zero-boundary moment trace solving the prescribed real Poisson equation. The constructed Poisson solution is not convex, so no such source exists. The exact probe equivalence forces Ξ(μ_j)>0. This blocks the proposed inference from strong continuity, domination or smooth positive density to zero defect."];
"n-energy-source-gap" -> "r-energy-r8-nonzero-defect-obstruction" [id="energy-and-equations-energy-panel-sources-input-energy-r8-nonzero-defect-obstruction-energy-source-gap",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r8-nonzero-defect-obstruction" -> "n-energy-defect-zero" [id="energy-and-equations-energy-panel-sources-output-energy-r8-nonzero-defect-obstruction",style="solid",color="#9a4b30",arrowhead="tee",];
"r-energy-r9-compatible-input-open" [id="energy-and-equations-energy-panel-sources-r-energy-r9-compatible-input-open",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#76518c"><B>Open step 06</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#76518c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r9-compatible-input-open",tooltip="The zero-defect criterion is available after the variational optimizer is constructed. Missing: hypotheses on the given measure, geometry and explicitly supplied reference objects that force both strong continuity and zero defect before assuming a solution. For the proposed local inverse route, additionally establish the linearized range, a bounded right inverse with all boundary and harmonic-moment constraints, and preservation of that range by the nonlinear remainder. The exact compatibility criterion locates the remaining task but does not perform it. Existing finite-mode inverse constructions motivate a range-controlled route; smooth positive perturbations alone cannot be used as its hypothesis because the source-gap counterexample rules them out."];
"n-energy-source-solution" -> "r-energy-r9-compatible-input-open" [id="energy-and-equations-energy-panel-sources-input-energy-r9-compatible-input-open-energy-source-solution",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r9-compatible-input-open" -> "n-energy-compatible-classes" [id="energy-and-equations-energy-panel-sources-output-energy-r9-compatible-input-open",style="dashed",color="#76518c",arrowhead="normal",];
}
