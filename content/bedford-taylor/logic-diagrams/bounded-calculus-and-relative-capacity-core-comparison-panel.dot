digraph "bounded-calculus-and-relative-capacity-core-comparison-panel" {
graph [id="svg-bounded-calculus-and-relative-capacity-core-comparison-panel",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-core-regularization" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-n-core-regularization",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Regularization on one fixed<BR ALIGN="LEFT"/>neighborhood</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">B01 · R01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#prop:regularization",tooltip="Bounded classical potentials admit decreasing continuous semipositive rational PL approximants over the original field. Finite families share one ordinary neighborhood. Continuous members admit smooth positive uniform approximants; smooth majorants used in the collar argument need not form a decreasing row."];
"n-core-bounded-calculus" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-n-core-bounded-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric bounded calculus and<BR ALIGN="LEFT"/>CLN bounds</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">M01 · M02 · B02 · B03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#cor:full-calculus",tooltip="Ordered products become symmetric in their potential slots, while retaining positivity, separate closedness, ordinary locality and weighted decreasing continuity. Relative CLN bounds control compact coefficient mass. This node does not yet assert that changing a potential while preserving its curvature leaves every background product unchanged."];
"n-core-maximum-locality" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-n-core-maximum-locality",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Locality on strict maximum<BR ALIGN="LEFT"/>regions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · C03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#thm:maximum-locality-relative",tooltip="The mixed current of max(u,v) agrees with that of u on the Borel region {u > v}, and analogously on {v > u}. These regions need not be ordinary open, so ordinary restriction locality alone does not give this statement."];
"n-core-compact-gap-comparison" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-n-core-compact-gap-comparison",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Comparison under a compact<BR ALIGN="LEFT"/>boundary gap</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#thm:relative-comparison",tooltip="If the ordinary closure of every strict gap {u < v-epsilon} is compactly contained in V, then the top relative measure of v on {u < v} is at most that of u there. The proof uses maximum locality and the bounded calculus; it requires no capacity theorem or strictly psh exhaustion."];
"n-core-qe-domination" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-n-core-qe-domination",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Domination and uniqueness modulo<BR ALIGN="LEFT"/>capacity zero</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#prop:capacity-domination",tooltip="With the required compact gaps, zero u-mass on {u < v} forces that set to have zero relative capacity. Equal relative Monge–Ampere measures, with gaps in both orders, force {u != v} to have zero relative capacity. Neither conclusion alone identifies pointwise representatives."];
"n-core-strict-gap-detection" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-n-core-strict-gap-detection",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Additional condition: detect<BR ALIGN="LEFT"/>every strict gap</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#cor:conditional-pointwise-domination",tooltip="For the proposed pair (S,V), every nonempty strict gap {a < b-delta} of admissible bounded classical potentials with compact gaps must have positive relative capacity. Establishing useful intrinsic hypotheses remains part of CAP-DETECT. The condition fails for S = 0 and can fail away from a nonzero background's support."];
"n-core-conditional-pointwise" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-n-core-conditional-pointwise",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Pointwise order and uniqueness,<BR ALIGN="LEFT"/>conditionally</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C03</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/854252899cbb/#cor:conditional-pointwise-domination",tooltip="Once strict-gap detection is supplied for (S,V), the preceding capacity-zero conclusions imply u >= v, or u = v in the uniqueness case. The conditional implication is proved; the required detection property is not asserted for arbitrary positive closed backgrounds."];
"r-core-r10-strict-maximum-locality" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-r-core-r10-strict-maximum-locality",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r10-strict-maximum-locality",tooltip="The background is fixed, u, v and the remaining slots lie in C_b, and 1 <= k <= q. Borel restrictions are coefficient-measure restrictions; no closedness of a restricted current is asserted. On continuous approximants, ordinary locality gives h_j A_j = h_j B_j for h_j = max(u_j,v_j)-v_j. Pass to the limit by subtracting two applications of weighted decreasing continuity; the differences h_j need not decrease. The resulting identity h(A-B)=0 can be divided by h on {h >= 1/m}; a countable union recovers {u > v}."];
"n-core-regularization" -> "r-core-r10-strict-maximum-locality" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-input-core-r10-strict-maximum-locality-core-regularization",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-bounded-calculus" -> "r-core-r10-strict-maximum-locality" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-input-core-r10-strict-maximum-locality-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r10-strict-maximum-locality" -> "n-core-maximum-locality" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-output-core-r10-strict-maximum-locality",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r11-compact-gap-comparison" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-r-core-r11-compact-gap-comparison",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r11-compact-gap-comparison",tooltip="q >= 1 and u,v belong to C_b(V). For every epsilon > 0, the ordinary closure of {u < v-epsilon} is compact and contained in V. The background is defined and separately closed throughout V; use the top relative measures mu_a = T(S,q)(a,...,a). Put w = max(u,v-epsilon). The mixed telescoping identity writes mu_w-mu_u = D((w-u)Q), with compact support. A cutoff makes its total signed mass zero. Maximum locality identifies the measures on the two strict regions; positivity controls the equality region. Let epsilon decrease to zero. This argument does not pass through quasicontinuity or a capacity theorem."];
"n-core-bounded-calculus" -> "r-core-r11-compact-gap-comparison" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-input-core-r11-compact-gap-comparison-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-maximum-locality" -> "r-core-r11-compact-gap-comparison" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-input-core-r11-compact-gap-comparison-core-maximum-locality",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r11-compact-gap-comparison" -> "n-core-compact-gap-comparison" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-output-core-r11-compact-gap-comparison",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r12-capacity-zero-conclusions" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-r-core-r12-capacity-zero-conclusions",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Deduction 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r12-capacity-zero-conclusions",tooltip="Choose the relevant conclusion. Domination requires compact gaps in the order (u,v) and mu_u({u < v}) = 0. Uniqueness instead requires compact gaps in both orders and mu_u = mu_v as Radon measures. Capacity uses the full normalized classical tester family 0 <= h <= 1 on the same V. Perturb the comparison potential by epsilon(h-1)-delta. Positivity of the mixed expansion exposes the term epsilon^q mu_h on a smaller strict gap. Comparison forces its mass to vanish for every normalized tester; taking the supremum and a countable union gives capacity zero. For uniqueness, cancel only finite masses on compact gaps and then repeat in the other order."];
"n-core-bounded-calculus" -> "r-core-r12-capacity-zero-conclusions" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-input-core-r12-capacity-zero-conclusions-core-bounded-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-compact-gap-comparison" -> "r-core-r12-capacity-zero-conclusions" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-input-core-r12-capacity-zero-conclusions-core-compact-gap-comparison",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r12-capacity-zero-conclusions" -> "n-core-qe-domination" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-output-core-r12-capacity-zero-conclusions",style="solid",color="#315e50",arrowhead="normal",];
"r-core-r13-conditional-pointwise" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-r-core-r13-conditional-pointwise",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-bounded-calculus-and-relative-capacity-core-r13-conditional-pointwise",tooltip="Supply strict-gap detection for the same pair (S,V) and actual classical representatives. Retain the corresponding domination assumptions, or the equal-measure and two-sided-gap assumptions for uniqueness. A prohibited pointwise inequality would hold with some positive margin. Its nonempty strict gap would have positive capacity by the extra condition, contradicting the capacity-zero conclusion. The implication is proved; supplying detection for a proposed geometric class is the open obligation."];
"n-core-qe-domination" -> "r-core-r13-conditional-pointwise" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-input-core-r13-conditional-pointwise-core-qe-domination",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-core-strict-gap-detection" -> "r-core-r13-conditional-pointwise" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-input-core-r13-conditional-pointwise-core-strict-gap-detection",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-core-r13-conditional-pointwise" -> "n-core-conditional-pointwise" [id="bounded-calculus-and-relative-capacity-core-comparison-panel-output-core-r13-conditional-pointwise",style="solid",color="#315e50",arrowhead="normal",];
}
