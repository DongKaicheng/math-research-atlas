digraph "descent-descent-certificates" {
graph [id="svg-descent-descent-certificates",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-d-transgression" [id="descent-descent-certificates-n-d-transgression",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Quadratic transgression and<BR ALIGN="LEFT"/>first derivatives</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#eq:quadratic-return",tooltip="For a finite admissible quadratic presentation P, the full degree-one action obeys A_S(P) = D M_S(α_P) = −D M_S(Z_P). The singular term A₀ = ½Dδ(Σcνhνkν) is retained. Full first derivatives commute with M_S, including polyhedral boundary contributions."];
"n-d-full-exact" [id="descent-descent-certificates-n-d-full-exact",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>An actual full-exact certificate</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01 · G06 · O02</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#prop:certificates",tooltip="On one ordinary representative chosen for P, α_P = d′β + d″ζ in the actual delta-form sheaf. This is a hypothesis available in proved special cases; its existence for every quadratic actual zero remains open. It does not require a continuous smooth-form double primitive."];
"n-d-fixed-control" [id="descent-descent-certificates-n-d-fixed-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Exact approximants with one<BR ALIGN="LEFT"/>control</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G06 · O02</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#eq:controlled-exact",tooltip="Actual symmetric full-exact forms a_j approximate α_P in the represented order interval −ε_jQ ≤ [α_P]−[a_j] ≤ ε_jQ, with ε_j → 0 and one fixed positive represented Q. The all-background degree-one estimate is part of this certificate. The same ordinary domain, Q and approximants precede later backgrounds, tests and refinements."];
"n-d-carrier" [id="descent-descent-certificates-n-d-carrier",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#79602f">HYPOTHESIS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A zero full-carrier seminorm</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G05 · O02</FONT></TD></TR></TABLE>>,color="#79602f",fillcolor="#faf5e8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/cfa1011fee52/#def:r12-carrier-cln-seminorm",tooltip="For the specified closed carrier F, the unchanged carrier-CLN seminorm of P vanishes at every required enlarged compact stage. Only the permitted harmonic, pointwise-zero-product and ambient-cycle generators are used. Whether every actual PL-zero has the required absolute-cap certificates is open; zero action does not imply this stronger certificate."];
"n-d-vanishing" [id="descent-descent-certificates-n-d-vanishing",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>The specified quadratic action<BR ALIGN="LEFT"/>vanishes</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G01 · G05 · G06</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/research-program/#prop:certificates",tooltip="The action A_S(P) is zero on all original compact smooth complementary tests under any one incoming sufficient route and that route’s displayed hypotheses. Exactness and fixed-control approximation allow every legal S. The direct carrier theorem allows the S carried by its specified F. This node does not assert that every actual relation already has such a certificate."];
"n-d-rank-two" [id="descent-descent-certificates-n-d-rank-two",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Rank at most two constructs<BR ALIGN="LEFT"/>certificates</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G06 · G07</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/0a11b646bf6a/#thm:r11-ordinary-quadratic-residue-two",tooltip="For an actual quadratic zero in a fixed finite continuous closed-cell PL/PS presentation with joint residue rank s_f(x) ≤ 2, the source construction returns a full strain covector to the whole actual moment image. It constructs both full first-order exactness and fixed-Q approximants on an ordinary neighborhood, in arbitrary ambient dimension."];
"n-d-low-rank-quotient" [id="descent-descent-certificates-n-d-low-rank-quotient",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A canonical quotient when s_K ≤<BR ALIGN="LEFT"/>2</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">G08</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/sources/view/1b9bac736976/#thm:r11-intrinsic-quadratic-germ-class",tooltip="If the entire residue dimension satisfies s_K(x) ≤ 2, the quadratic transgression class depends only on the actual quadratic curvature. The canonical map τ₂ satisfies D̄τ₂ = id. These classes glue on ordinary opens satisfying the bound, including analytic surfaces. Separately low-rank presentations are insufficient unless their union tuple also meets the bound."];
"or-d-vanishing" [id="descent-descent-certificates-or-d-vanishing",label="OR
Any one sufficient route",fontsize=12,shape=ellipse,fillcolor="#eef4ec",color="#315e50",tooltip="These incoming deductions are alternatives, with their own stated hypotheses."];
"or-d-vanishing" -> "n-d-vanishing" [color="#315e50"];
"r-d-e-exact" [id="descent-descent-certificates-r-d-e-exact",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-exact",tooltip="P is the specified admissible finite quadratic actual zero on the same ordinary representative as its full-exact identity. S is any allowed original background of degree 0 ≤ p ≤ n−2; retain all original compact smooth tests and actual refinements. Full derivative compatibility gives M_S(α_P) = d′(β ∧ S) + d″(ζ ∧ S). Applying D kills both terms by nilpotence and anticommutation. No higher-degree arbitrary-current product is assumed."];
"n-d-transgression" -> "r-d-e-exact" [id="descent-descent-certificates-input-d-e-exact-d-transgression",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-d-full-exact" -> "r-d-e-exact" [id="descent-descent-certificates-input-d-e-exact-d-full-exact",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-exact" -> "or-d-vanishing" [id="descent-descent-certificates-output-d-e-exact",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-control" [id="descent-descent-certificates-r-d-e-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>AND · Conditional deduction 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-control",tooltip="P is the specified admissible finite quadratic actual zero, with exact a_j, ε_j → 0 and a single positive represented Q on one fixed ordinary neighborhood. The represented order estimate transfers to the all-background degree-one action for every allowed 0 ≤ p ≤ n−2; Q and the neighborhood do not vary with the test or later refinement. Each exact a_j has zero differentiated action. The fixed positive control bounds every remaining compact pairing by ε_j times a finite fixed mass; distributional continuity of D then gives zero. Approximating only Z_P retains the complete singular A₀ term."];
"n-d-transgression" -> "r-d-e-control" [id="descent-descent-certificates-input-d-e-control-d-transgression",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-d-fixed-control" -> "r-d-e-control" [id="descent-descent-certificates-input-d-e-control-d-fixed-control",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-control" -> "or-d-vanishing" [id="descent-descent-certificates-output-d-e-control",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-carrier" [id="descent-descent-certificates-r-d-e-carrier",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Conditional deduction 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-carrier",tooltip="Here P is a finite quadratic PL curvature polynomial and S is an allowed background carried by the specified unchanged closed F, in a legal degree. Zero seminorm holds at every enlarged compact stage required for the test, using finite decompositions on the same ordinary domain and only the permitted generator space. An absolute-cap certificate directly kills its relative capped background. Returning from all such caps to an uncapped S uses the separate KC9 detector: q = n−(p+b) > 0 and 1 ≤ c ≤ max(q mod 2, q−2 floor(p/2)). That proposition gives no positive-rank cap route when q = 0 or this upper bound is zero. Permitted carrier relations act by zero. Apply the uniform carrier-only CLN estimate to each remainder and take the seminorm infimum. This proves a sufficient annihilation criterion; it does not identify the actual analytic kernel or all seminorm polars."];
"n-d-carrier" -> "r-d-e-carrier" [id="descent-descent-certificates-input-d-e-carrier-d-carrier",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-carrier" -> "or-d-vanishing" [id="descent-descent-certificates-output-d-e-carrier",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-rank-exact" [id="descent-descent-certificates-r-d-e-rank-exact",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-rank-exact",tooltip="The fixed relation is an actual quadratic zero in the finite continuous closed-cell PL/PS class, and its entire original scalar tuple f satisfies s_f(x) ≤ 2. Use the constructed ordinary neighborhood and finite actual original-unit refinement; all lower strata and later deficient-rank refinements remain included. The normal-surface construction returns a continuous finite-PS covector whose full strain is Z_P on the whole actual moment image. Since A₀ = ½Dδu is already full-exact, α_P = A₀−Z_P has an actual first-order exact expression."];
"n-d-rank-two" -> "r-d-e-rank-exact" [id="descent-descent-certificates-input-d-e-rank-exact-d-rank-two",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-rank-exact" -> "n-d-full-exact" [id="descent-descent-certificates-output-d-e-rank-exact",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-rank-control" [id="descent-descent-certificates-r-d-e-rank-control",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 05</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-rank-control",tooltip="Retain the same actual zero, full finite closed-cell source data and joint bound s_f(x) ≤ 2. Fix 1 < κ < 2 and one ordinary truncation before later backgrounds and tests. Regularize the returned continuous covector and use the finitely many coefficient facets, |ℓ_H|^κ and a fixed strictly convex term to construct one positive Q = D[q]. The source-side all-background estimate is O(δ^((2−κ)/2)); setting a_j = A₀−e_δj yields the required full-exact approximation."];
"n-d-rank-two" -> "r-d-e-rank-control" [id="descent-descent-certificates-input-d-e-rank-control-d-rank-two",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-rank-control" -> "n-d-fixed-control" [id="descent-descent-certificates-output-d-e-rank-control",style="solid",color="#315e50",arrowhead="normal",];
"r-d-e-union-quotient" [id="descent-descent-certificates-r-d-e-union-quotient",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 06</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 2 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-descent-d-e-union-quotient",tooltip="Impose the stronger intrinsic bound s_K(x) ≤ 2, so the union tuple of any two finite presentations has joint residue rank at most two. For a sheaf morphism, this bound holds at every point of the ordinary open; local finite presentations and the actual quotient sheaf are retained. Two presentations of one actual quadratic curvature differ by an actual zero. Apply rank-two exactness to their union tuple, so their transgression classes agree. The singular A₀ is exact, and ordinary sheaf gluing gives τ₂ with D̄τ₂ = id. Separate rank bounds on the two tuples alone would not justify this argument."];
"n-d-rank-two" -> "r-d-e-union-quotient" [id="descent-descent-certificates-input-d-e-union-quotient-d-rank-two",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-d-e-union-quotient" -> "n-d-low-rank-quotient" [id="descent-descent-certificates-output-d-e-union-quotient",style="solid",color="#315e50",arrowhead="normal",];
}
