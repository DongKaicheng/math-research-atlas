digraph "energy-and-equations-energy-panel-explicit-inverses" {
graph [id="svg-energy-and-equations-energy-panel-explicit-inverses",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-energy-tail-calculus" [id="energy-and-equations-energy-panel-explicit-inverses-n-energy-tail-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Capacity tails and truncation<BR ALIGN="LEFT"/>calculus</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · U01 · U02 · U03 · U04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:analytic-estimates",tooltip="In the stated zero-boundary class, no loss is equivalent to t^q C_S({u<−t})→0, and finite σ-energy is equivalent to the weighted capacity integral J_σ(u)<∞. Bounded capacity completion and graded truncation bounds then control curvature, first-order and energy coefficients. Local finiteness is required for the nonpolar product; restricted truncation stages need not be closed."];
"n-energy-mixed-energy" [id="energy-and-equations-energy-panel-explicit-inverses-n-energy-mixed-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric mixed energy and<BR ALIGN="LEFT"/>Hölder</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:first-mixed-energy",tooltip="For actual first-energy potentials, B(u₀,…,u_q) is finite and symmetric in every slot. Positive energy matrices give Cauchy–Schwarz, the mixed Hölder inequality has constant one, and the energy root satisfies Minkowski. The associated tester and sharp midpoint estimates control strong discrepancy."];
"n-energy-probe" [id="energy-and-equations-energy-panel-explicit-inverses-n-energy-probe",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>One probe with both test<BR ALIGN="LEFT"/>directions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:geometric-compensators",tooltip="The strict Laurent geometry supplies a single bounded continuous negative classical ψ₀. For every original compact smooth scalar φ, both ψ₀+ε_φφ and ψ₀−ε_φφ lie in the actual first-energy cone for some ε_φ>0. The same probe works for every extending allowed background."];
"n-energy-parameter-cone" [id="energy-and-equations-energy-panel-explicit-inverses-n-energy-parameter-cone",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A separate parameter L^(k+1)<BR ALIGN="LEFT"/>cone</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q07</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/dd3fbcc3753a/#thm:r12-parameter-Lp-BT",tooltip="For an explicitly conormal background R and an actual parameter map s, the new potentials h_c=ψc(s) form a complete L^(k+1)_+(θ) cone, θ=s_*((-ψ)(Dψ)^k∧R). Their mixed currents and energies have exact coefficient-product formulas. This is a new parameter completion with its own boundary interpretation; it is not an identification with the full ambient classical or strong cone."];
"n-energy-parameter-inverse" [id="energy-and-equations-energy-panel-explicit-inverses-n-energy-parameter-inverse",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Exact parameter inverse and<BR ALIGN="LEFT"/>energy capacity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q07</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/dd3fbcc3753a/#thm:r12-parameter-Dirichlet",tooltip="For b≥0 in L^((k+1)/k)(θ), h=ψb(s)^(1/k) solves μ_h=b(s)(Dψ)^k∧R uniquely within the parameter cone. Its energy-normalized capacity equals the L^(k+1)(θ) norm of the conditional source density, has local regularity, and has the null ideal of its fixed source measure. The tester family is explicitly different from full classical [0,1] testers."];
"n-energy-radial-inverse" [id="energy-and-equations-energy-panel-explicit-inverses-n-energy-radial-inverse",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#285e87">MODEL CASE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>A compatible radial-flux inverse</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q07</FONT></TD></TR></TABLE>>,color="#285e87",fillcolor="#edf3f8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/2e004712fbd0/#thm:r12-exact-radial-flux-inverse",tooltip="For the fixed radial-mixture background of (PO3), nonnegative data with open tail H_ν(t) and nonincreasing e^tH_ν(t) admit the explicit slope A=(e^tH_ν)^(1/q), provided the stated weighted energy integral is finite. The resulting actual potential has no loss and solves the full original source equation. It is unique in the full completed cone; the necessity of the flux condition is asserted for the radial class."];
"n-energy-countable-probe-gap" [id="energy-and-equations-energy-panel-explicit-inverses-n-energy-countable-probe-gap",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9a4b30">OBSTRUCTION</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Countable Radon probes miss full<BR ALIGN="LEFT"/>capacity</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">N12</FONT></TD></TR></TABLE>>,color="#9a4b30",fillcolor="#fbefe8",URL="/math-research-atlas/projects/bedford-taylor/sources/view/9146762ddc3a/#thm:r12-no-countable-radon-capacity-control",tooltip="For the allowed coordinate-subtorus background R=[Y] in every n≥q≥1, uncountably many Gauss singletons have uniformly positive full tester capacity. Any countable family of Radon measures misses at least one such singleton. Parameter energy capacities therefore cannot be substituted for full BT capacity. This does not obstruct the single geometry probe for normal defects, test-stage cofinality, or Choquet regularity."];
"r-energy-r22-parameter-calculus" [id="energy-and-equations-energy-panel-explicit-inverses-r-energy-r22-parameter-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r22-parameter-calculus",tooltip="Fix a strict Laurent box, actual unit-moment parameters s and an allowed symmetric middle-positive separately closed current R of degree (P,P), all defined on an ordinary neighborhood of its closure; k=n−P≥1. Require the explicit conormal identities d′s_i∧R=d″s_i∧R=0; for R=Ω_s∧S retain Ω_s throughout instead of assuming the original S is conormal. Use a bounded negative geometric probe ψ with finite ω=(Dψ)^k∧R, θ=s_*((−ψ)ω), and nonnegative coefficient functions in L^(k+1)(θ). Closed-band identities first establish the formulas for bounded parameter coefficients. The geometric probe bounds every lower coefficient on compact sets; Hölder then passes truncated coefficients to the full L^(k+1) cone. Mixed energies become scalar L^d products and yield completeness. Null sets and the unbounded boundary convention belong to this parameter module."];
"n-energy-probe" -> "r-energy-r22-parameter-calculus" [id="energy-and-equations-energy-panel-explicit-inverses-input-energy-r22-parameter-calculus-energy-probe",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r22-parameter-calculus" -> "n-energy-parameter-cone" [id="energy-and-equations-energy-panel-explicit-inverses-output-energy-r22-parameter-calculus",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r23-parameter-inversion" [id="energy-and-equations-energy-panel-explicit-inverses-r-energy-r23-parameter-inversion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#315e50"><B>Deduction 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r23-parameter-inversion",tooltip="Keep the same conormal R, probe ψ, parameter measure θ and new parameter cone; put d=k+1. For the source inverse require b≥0 in L^(d/k)(θ), with datum b(s)ω. For its capacity use only h_c=ψc(s), c≥0, ||c||_(L^d)≤1; on compact cores the conditional density g_A=d s_*(1_Aω)/dθ is bounded. The exact coefficient formula makes c↦c^k the source map, so c=b^(1/k) gives the inverse and Young equality gives uniqueness within this cone. Hölder duality gives the capacity formula ||g_A||_(L^d); Radon approximation proves local regularity. These conclusions use the printed tester family and do not identify it with full normalized classical capacity."];
"n-energy-parameter-cone" -> "r-energy-r23-parameter-inversion" [id="energy-and-equations-energy-panel-explicit-inverses-input-energy-r23-parameter-inversion-energy-parameter-cone",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r23-parameter-inversion" -> "n-energy-parameter-inverse" [id="energy-and-equations-energy-panel-explicit-inverses-output-energy-r23-parameter-inversion",style="solid",color="#315e50",arrowhead="normal",];
"r-energy-r24-radial-inversion" [id="energy-and-equations-energy-panel-explicit-inverses-r-energy-r24-radial-inversion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r24-radial-inversion",tooltip="Fix the original n-dimensional polydisc with n>q≥1 and exactly the integrated radial-shell background S of (PO3), not an arbitrary background. The positive radial datum ν has finite open tails H_ν(t)=ν((t,∞)); e^tH_ν(t) is nonincreasing. Require ∫₀∞ e^(t/q)H_ν(t)^((q+1)/q)dt<∞. For finite total ν, the compatibility condition is equivalently ν≥H_ν(t)dt and the energy condition follows. Invert the flux by A(t)=(e^tH_ν(t))^(1/q) and integrate the slope to obtain the actual potential. Clipped radial calibration and the vanishing terminal flux establish no loss before passing the energy formula. Injectivity of the full source map then proves uniqueness in C, while the asserted necessity of the flux condition remains restricted to radial potentials."];
"n-energy-tail-calculus" -> "r-energy-r24-radial-inversion" [id="energy-and-equations-energy-panel-explicit-inverses-input-energy-r24-radial-inversion-energy-tail-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-mixed-energy" -> "r-energy-r24-radial-inversion" [id="energy-and-equations-energy-panel-explicit-inverses-input-energy-r24-radial-inversion-energy-mixed-energy",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r24-radial-inversion" -> "n-energy-radial-inverse" [id="energy-and-equations-energy-panel-explicit-inverses-output-energy-r24-radial-inversion",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r25-capacity-null-separation" [id="energy-and-equations-energy-panel-explicit-inverses-r-energy-r25-capacity-null-separation",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>Proof input 04</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r25-capacity-null-separation",tooltip="For the counterexample choose the allowed torus-box background R=[Y], where Y is the q-dimensional coordinate subtorus and n≥q≥1. Use the full original [0,1] tester h_a=(2L)⁻¹ max_i|t_i−a_i| at every Gauss point x_a; its top measure is L^(−q)δ_(x_a). To compare with parameter energy capacity choose the empty parameter tuple and any countable family of allowed probes. The fixed compact Gauss set is uncountable, while countably many Radon measures have only countably many atoms there. Choose a missed point; its full capacity remains at least L^(−q). The exact parameter null-ideal formula makes the same singleton null for each chosen energy capacity. This proves strict separation of the capacities without invalidating the single-probe normal-defect criterion."];
"n-energy-parameter-inverse" -> "r-energy-r25-capacity-null-separation" [id="energy-and-equations-energy-panel-explicit-inverses-input-energy-r25-capacity-null-separation-energy-parameter-inverse",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r25-capacity-null-separation" -> "n-energy-countable-probe-gap" [id="energy-and-equations-energy-panel-explicit-inverses-output-energy-r25-capacity-null-separation",style="dashed",color="#64757c",arrowhead="normal",];
}
