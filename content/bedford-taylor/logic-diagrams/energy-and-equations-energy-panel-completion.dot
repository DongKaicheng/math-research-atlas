digraph "energy-and-equations-energy-panel-completion" {
graph [id="svg-energy-and-equations-energy-panel-completion",rankdir=TB,bgcolor="transparent",fontname="Arial",pad="0.2",nodesep="0.35",ranksep="0.55",splines=polyline,pack=true,packmode="array_u1"];
node [fontname="Arial",fontsize=16,shape=box,style="rounded,filled",color="#aebeb1",fillcolor="#fffef9",margin="0.09,0.06"];
edge [fontname="Arial",fontsize=12,color="#315e50",penwidth=1.7,arrowsize=0.8];
"n-energy-tail-calculus" [id="energy-and-equations-energy-panel-completion-n-energy-tail-calculus",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Capacity tails and truncation<BR ALIGN="LEFT"/>calculus</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">C01 · U01 · U02 · U03 · U04</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:analytic-estimates",tooltip="In the stated zero-boundary class, no loss is equivalent to t^q C_S({u<−t})→0, and finite σ-energy is equivalent to the weighted capacity integral J_σ(u)<∞. Bounded capacity completion and graded truncation bounds then control curvature, first-order and energy coefficients. Local finiteness is required for the nonpolar product; restricted truncation stages need not be closed."];
"n-energy-global-green" [id="energy-and-equations-energy-panel-completion-n-energy-global-green",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Bounded global Green exchange</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:global-green",tooltip="For bounded negative classical potentials with compact negative sublevels and finite total curvature masses, Green exchange identifies the two weighted curvature integrals with the integrated cross-energy. This supplies the exchange of the undifferentiated slot needed for global mixed energy."];
"n-energy-mixed-energy" [id="energy-and-equations-energy-panel-completion-n-energy-mixed-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Symmetric mixed energy and<BR ALIGN="LEFT"/>Hölder</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:first-mixed-energy",tooltip="For actual first-energy potentials, B(u₀,…,u_q) is finite and symmetric in every slot. Positive energy matrices give Cauchy–Schwarz, the mixed Hölder inequality has constant one, and the energy root satisfies Minkowski. The associated tester and sharp midpoint estimates control strong discrepancy."];
"n-energy-completion" [id="energy-and-equations-energy-panel-completion-n-energy-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Complete relative first-energy<BR ALIGN="LEFT"/>space</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">E02 · E03</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#lem:r11-strong-cauchy-uniform-tails",tooltip="Strongly Cauchy rows have uniform deep tails and global weighted tightness. Their relative Borel limits carry intrinsic currents and critical weighted limits. The completed cone C is complete, with strong convergence exactly equivalent to local truncated outer-capacity convergence together with energy convergence. A common lower barrier is not required for a Cauchy row."];
"n-energy-dual" [id="energy-and-equations-energy-panel-completion-n-energy-dual",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#315e50">ESTABLISHED IN SOURCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Banach differences and closed<BR ALIGN="LEFT"/>sources</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#5e6b65">Q01</FONT></TD></TR></TABLE>>,color="#315e50",fillcolor="#eef4ec",URL="/math-research-atlas/projects/bedford-taylor/papers/bedford-taylor-products/#thm:r12-energy-difference-Banach",tooltip="The actual Borel difference space D_S=C−C is Banach. The curvature functional J(u)(h)=B(h,u,…,u) is injective; its image is norm closed, and the dual distance between sources gives a complete metric inducing the strong topology on C. Closed image does not assert surjectivity onto the dual."];
"r-energy-r1-mixed-energy" [id="energy-and-equations-energy-panel-completion-r-energy-r1-mixed-energy",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 01</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r1-mixed-energy",tooltip="Fix the original field and tests, the strict Laurent domain, and one allowed S extending to a neighborhood of its closure; q=n−p≥1. Every input u_i is an actual negative classical first-energy potential with compact negative sublevels, canonical no loss and finite first energy. Use the Laurent barrier approximants max(u_i,jρ), their finite mixed masses, and the critical weighted convergence supplied by the truncation theorem. The proof applies bounded Green exchange after fixing the other curvature slots, then passes the barrier approximants to obtain full mixed symmetry. The positive energy matrix gives Cauchy–Schwarz and Hölder constant one. Repeated slot exchange gives the tester estimate; the segment second-variation formula gives the midpoint bound. These are joint proof inputs, not a claim that a tail bound alone yields global symmetry."];
"n-energy-tail-calculus" -> "r-energy-r1-mixed-energy" [id="energy-and-equations-energy-panel-completion-input-energy-r1-mixed-energy-energy-tail-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-global-green" -> "r-energy-r1-mixed-energy" [id="energy-and-equations-energy-panel-completion-input-energy-r1-mixed-energy-energy-global-green",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r1-mixed-energy" -> "n-energy-mixed-energy" [id="energy-and-equations-energy-panel-completion-output-energy-r1-mixed-energy",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r2-completion" [id="energy-and-equations-energy-panel-completion-r-energy-r2-completion",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 02</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r2-completion",tooltip="Retain the same strict Laurent domain and extending background, and actual first-energy approximating rows. For constructing an unbounded limit, each defining row must be strongly Cauchy: sup_{j,l≥N} I(u_j,u_l)→0. Use bounded capacity completion at every fixed clipping level and the uniform tester/discrepancy estimates; legal weighted currents satisfy a+b≤q+1. Strong Cauchy control, tested against a late fixed row member, gives uniform deep tails and global weighted tightness. Fixed-level capacity limits and vanishing tails define the unbounded coefficients before differentiation. Uniform discrepancy continuity then gives completeness. Energy boundedness plus capacity convergence alone does not supply the critical tail step."];
"n-energy-tail-calculus" -> "r-energy-r2-completion" [id="energy-and-equations-energy-panel-completion-input-energy-r2-completion-energy-tail-calculus",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-mixed-energy" -> "r-energy-r2-completion" [id="energy-and-equations-energy-panel-completion-input-energy-r2-completion-energy-mixed-energy",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r2-completion" -> "n-energy-completion" [id="energy-and-equations-energy-panel-completion-output-energy-r2-completion",style="dashed",color="#64757c",arrowhead="normal",];
"r-energy-r3-banach-sources" [id="energy-and-equations-energy-panel-completion-r-energy-r3-banach-sources",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="12" COLOR="#64757c"><B>AND · Proof input 03</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="12" COLOR="#1f4e79">With 3 stated hypotheses</FONT></TD></TR></TABLE>>,color="#64757c",fillcolor="#fffef9",URL="#logic-energy-and-equations-energy-r3-banach-sources",tooltip="Form actual Borel differences of the same completed cone C modulo its relative outer-capacity null ideal. Use the energy-difference norm inf{e(a)^(1/d)+e(b)^(1/d): h=a−b}, completed mixed multilinearity and monotone closure. Use the exact curvature norm and the two quantitative comparisons between I(u,v) and ‖J(u)−J(v)‖*. Summable decomposed increments converge as two monotone cone series, proving Banach completeness in actual Borel differences. A norm-Cauchy sequence of sources has bounded energy roots and is strongly Cauchy; completion produces its limiting potential, and curvature continuity identifies the source limit. This proves closed image, not arbitrary-data solvability."];
"n-energy-completion" -> "r-energy-r3-banach-sources" [id="energy-and-equations-energy-panel-completion-input-energy-r3-banach-sources-energy-completion",color="#9aa99d",penwidth=1.2,arrowhead=none];
"n-energy-mixed-energy" -> "r-energy-r3-banach-sources" [id="energy-and-equations-energy-panel-completion-input-energy-r3-banach-sources-energy-mixed-energy",color="#9aa99d",penwidth=1.2,arrowhead=none];
"r-energy-r3-banach-sources" -> "n-energy-dual" [id="energy-and-equations-energy-panel-completion-output-energy-r3-banach-sources",style="dashed",color="#64757c",arrowhead="normal",];
}
