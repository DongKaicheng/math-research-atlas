# Copy to management/.env on the deployment host. Never commit the real file.
# A production origin has no trailing path, query, credentials, or fragment.
NODE_ENV=production
APP_ORIGIN=https://admin.openmath-atlas.org
MANAGEMENT_DOMAIN=admin.openmath-atlas.org
HOST=127.0.0.1
PORT=8787
OPENMATH_DB=./management/data/openmath.sqlite

# Register a GitHub OAuth App. Callback must match APP_ORIGIN exactly:
# https://admin.openmath-atlas.org/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Verified numeric ID of DongKaicheng. Names/emails/first signup never own the site.
OWNER_GITHUB_ID=294881535
GITHUB_REPOSITORY=DongKaicheng/math-research-atlas
GITHUB_BRANCH=main

# Optional until public PR publication is enabled. Use a separate fine-grained
# token restricted to the one repository, Contents: read/write and
# Pull requests: read/write. Do not use the OAuth identity token here.
GITHUB_PUBLICATION_TOKEN=
